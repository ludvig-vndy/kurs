---
import { ClientRouter } from 'astro:transitions';
import Seal from '../components/Seal.astro';
import '../styles/broadsheet.css';

interface Props {
  title: string;
  description?: string;
  active?: 'hem' | 'kurs' | 'verktyg' | 'ordlista';
  /** masthead nav variant: app rail, landing marketing, or none */
  nav?: 'app' | 'landing' | 'none';
  /** page chrome: standard masthead, or none (lesson player brings its own) */
  chrome?: 'masthead' | 'none';
  editionLine2?: string;
  /** klass pa body som satter om fargtokens for en annan kurs */
  bodyClass?: string;
  /** kursen sidan tillhor, styr edition-rad, nav-lank och sidfot */
  kurs?: {
    titel: string; bas: string; varumarke: string; fin: string;
    wordmark: string; edition1: string; hem: string;
    nav: { href: string; label: string; nyckel?: string }[];
    korslank: { href: string; label: string; kort: string } | null;
  };
}

const {
  title,
  description = 'Kurs i fundamental aktieanalys.',
  active,
  nav = 'app',
  chrome = 'masthead',
  editionLine2,
  bodyClass = '',
  kurs = {
    titel: 'Fundamental aktieanalys',
    bas: '/fokus',
    varumarke: 'Delägaren',
    fin: 'fundamental aktieanalys. I utbildningssyfte, inte finansiell rådgivning.',
    wordmark: 'Marginalen',
    edition1: 'Fundamental aktieanalys',
    hem: '/hem',
    nav: [
      { href: '/hem', label: 'Hem', nyckel: 'hem' },
      { href: '/fokus', label: 'Kursöversikt', nyckel: 'kurs' },
      { href: '/verktyg', label: 'Analysverktyg', nyckel: 'verktyg' },
      { href: '/ordlista', label: 'Ordlista', nyckel: 'ordlista' },
    ],
    korslank: { href: '/labs/agarbrevet.html', label: 'Till Ägarbrevet ↗', kort: 'Ägarbrevet' },
  },
  /** open=true => publik sida (ingen inloggningsgrind): landning, logga-in */
  open = false,
} = Astro.props;

// Edition-radens rad 2 namnger ytan du star pa (som i Agarbrevet), harledd ur
// active. Explicit editionLine2 vinner; annars faller vi tillbaka pa kursraden.
const EDITION_BY_ACTIVE = { hem: 'Hem', kurs: 'Kursöversikt', verktyg: 'Analysverktyg', ordlista: 'Ordlista' };
const editionSub = editionLine2 ?? EDITION_BY_ACTIVE[active] ?? 'En kurs i sjutton kapitel';

const wordmarkHref = nav === 'landing' ? '/' : kurs.hem;
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    {!open && (
      <script is:inline>
        {/* Inloggningsgrind: ej publika sidor kraver ett Supabase-konto. Kors
            fore innehallet renderas -> ingen flash. Undantar magic-link-retur
            (access_token i hashen) sa inloggningen far slutforas. */}
        try {
          if (!localStorage.getItem('sb-xpxghvxrckpzbbkjmtcw-auth-token') && !location.hash.includes('access_token')) {
            location.replace('/logga-in');
          }
        } catch (e) {}
      </script>
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Spectral:ital,wght@0,300;0,400;0,500;1,400&family=Zilla+Slab:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <!-- Intern dev-växel Delägaren <-> Marginalen (?brand=marginalen) -->
    <script is:inline src="/brand-switch.js"></script>

    <ClientRouter />
  </head>
  <body class:list={[bodyClass || undefined]}>
    <div class="bg"></div>

    {chrome === 'masthead' && (
      <header class="masthead">
        <div class="wrap">
          <div class="mast-rule mast-rule--top"></div>
          <div class="mast-top">
            <a class="wordmark" href={wordmarkHref}>{kurs.wordmark}</a>
            <div class="edition">{kurs.edition1}<br />{editionSub}</div>
          </div>
          <div class="mast-rule"></div>
          {nav === 'app' && (
            <nav class="nav">
              {kurs.nav.map((post) => (
                <a
                  href={post.href}
                  class:list={[{ here: active === post.nyckel }]}
                  aria-current={active === post.nyckel ? 'page' : undefined}
                >{post.label}</a>
              ))}
              {kurs.korslank && (
                <>
                  <span class="nav-div" aria-hidden="true"></span>
                  <a href={kurs.korslank.href} class="nav-cross">{kurs.korslank.label}</a>
                </>
              )}
              <span class="mast-account" aria-live="polite"></span>
            </nav>
          )}
          {nav === 'landing' && (
            <nav class="nav" style="justify-content:space-between">
              <span style="display:flex;gap:26px">
                <a href="/fokus">Kursen</a>
                <a href="/verktyg">Verktyget</a>
              </span>
              <a href="/logga-in">Logga in</a>
            </nav>
          )}
        </div>
      </header>
    )}

    <slot />

    {chrome === 'masthead' && (
      <footer class="site-foot">
        <div class="wrap">
          <div class="site-foot__top">
            <Seal size="sm" href={kurs.hem} namn={kurs.wordmark} />
            <nav class="site-foot__nav">
              {kurs.nav.map((post) => <a href={post.href}>{post.label}</a>)}
              {kurs.korslank && <a href={kurs.korslank.href}>{kurs.korslank.kort}</a>}
            </nav>
          </div>
          <p class="site-foot__fine"><span class="brandname">{kurs.varumarke}</span>, {kurs.fin}</p>
        </div>
      </footer>
    )}

    <style>
      /* Kontochipen sitter langst till hoger i nav-raden (under masthuvudet),
         sa den inte puttar wordmark/edition. Fylls av AB.mountUserChip. */
      .mast-account { margin-left: auto; display: inline-flex; align-items: center; min-height: 40px; }
      .site-foot { margin-top: 56px; border-top: 2px solid var(--rule-strong); }
      .site-foot .wrap { padding-top: 26px; padding-bottom: 60px; }
      .site-foot__top { display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
      .site-foot__nav { display: flex; flex-wrap: wrap; gap: 10px 22px; font-family: var(--mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; }
      .site-foot__nav a { color: var(--muted); text-decoration: none; }
      .site-foot__nav a:hover { color: var(--oxblood); }
      .site-foot__fine { margin-top: 16px; font-family: var(--mono); font-size: 10.5px; letter-spacing: .04em; color: var(--faint); }
    </style>

    <script>
      function setupReveal() {
        document.querySelectorAll('[data-reveal-children]').forEach((box) => {
          Array.from(box.children).forEach((child) => {
            if (!child.hasAttribute('data-reveal')) child.setAttribute('data-reveal', '');
          });
        });
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document
            .querySelectorAll('[data-reveal], [data-reveal-children] > *')
            .forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const targets = document.querySelectorAll(
          '[data-reveal]:not(.is-visible), [data-reveal-children] > *:not(.is-visible)'
        );
        if (!targets.length) return;
        const io = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const el = entry.target as HTMLElement;
                el.style.transitionDelay = (el.dataset.revealDelay || '0') + 'ms';
                el.classList.add('is-visible');
                obs.unobserve(el);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
        );
        targets.forEach((el) => io.observe(el));
      }
      document.addEventListener('astro:page-load', setupReveal);
    </script>

    <style is:global>
      /* Calm pass: reveal is a gentle opacity fade only. The previous 16px
         upward slide added per-element motion on every scroll, which compounds
         into a queasy "everything is drifting" effect. */
      [data-reveal] { opacity: 0; transition: opacity 0.7s cubic-bezier(0.2,0.7,0.2,1); }
      [data-reveal].is-visible { opacity: 1; }
      @media (prefers-reduced-motion: reduce) { [data-reveal] { transition: none; } }
    </style>
    {chrome === 'masthead' && (
      <>
        <script defer src="/vendor/supabase-js-2.110.2.min.js"></script>
        <script defer src="/labs/agarbrevet-supabase.js"></script>
        <script>
          // Kontochipen (inloggad -> avatar, utloggad -> "Logga in") mountas om
          // vid varje navigering under ClientRouter.
          document.addEventListener('astro:page-load', function () {
            if (window.AB && window.AB.ready) window.AB.mountUserChip();
          });
        </script>
      </>
    )}
  </body>
</html>
