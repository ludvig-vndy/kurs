---
import Broadsheet from '../../layouts/Broadsheet.astro';
import { readFileSync } from 'node:fs';
import path from 'node:path';

const courseRaw = readFileSync(
  path.resolve(process.cwd(), 'content/fundamental-aktieanalys/course.json'),
  'utf-8'
);

interface Lektion {
  lektion: string;
  titel: string;
  niva: string;
  tid_min: number;
  status: 'klar' | 'kommande';
  fil: string;
}

interface Kapitel {
  nummer: number;
  titel: string;
  niva: string;
  tid_min: number;
  lektioner: Lektion[];
}

interface Kurs {
  kurs: string;
  titel: string;
  beskrivning: string;
  kapitel: Kapitel[];
}

function formatTime(min: number): string {
  if (min < 60) return `${min} min`;
  const h = Math.floor(min / 60);
  const m = min % 60;
  return m === 0 ? `${h} h` : `${h} h ${m} min`;
}

const kurs: Kurs = JSON.parse(courseRaw);

// The four parts. course.json has no part field, so the chapter -> part
// mapping is hardcoded per the broadsheet handoff.
interface Del {
  n: number;
  titel: string;
  sub: string;
  kapitel: number[];
}
const delar: Del[] = [
  { n: 1, titel: 'Grunderna', sub: 'Tankesätt och hur ett bolag fungerar', kapitel: [1, 2] },
  { n: 2, titel: 'Förstå bolaget', sub: 'Läsa rapporten och bedöma kvalitet', kapitel: [3, 4, 5, 6, 7] },
  { n: 3, titel: 'Värdering', sub: 'Sätta en siffra och en felmarginal', kapitel: [8, 9, 10] },
  { n: 4, titel: 'I praktiken', sub: 'Psykologi, case och egen process', kapitel: [11, 12, 13, 14, 15, 16] },
  { n: 5, titel: 'Fördjupning', sub: 'Att äga bolagen utan vinst', kapitel: [17] },
];

const ROM = ['', 'I', 'II', 'III', 'IV', 'V'];
const kapitelByNr = new Map(kurs.kapitel.map((k) => [k.nummer, k]));

// Per-chapter derived data.
function chapterData(kap: Kapitel) {
  const ids = kap.lektioner.map((l) => l.lektion);
  const klarAvail = kap.lektioner.filter((l) => l.status === 'klar').length;
  return { ids, klarAvail };
}

// Whole-course total: every lesson that exists.
const totalLessons = kurs.kapitel.reduce((sum, k) => sum + k.lektioner.length, 0);
---

<Broadsheet title="Fundamental aktieanalys" active="kurs" nav="app">
  <main class="wrap" style="flex:1; padding-top:8px">
    <div class="fokus-cover leadprint">
      <div style="display:flex; justify-content:space-between; align-items:flex-end; gap:24px; flex-wrap:wrap">
        <h1 class="h-title" style="max-width:16ch">Fundamental aktieanalys</h1>
        <div class="link-mono" style="color:var(--ink-soft)">{kurs.kapitel.length} kapitel · {totalLessons} lektioner</div>
      </div>

      <p class="standfirst">{kurs.beskrivning}</p>

      <div class="prog">
        <div class="tk"><i data-fokus-fill style="width:0%"></i></div>
        <div class="lab"><span data-fokus-total-label>0 / {totalLessons} lektioner klara</span></div>
      </div>
    </div>

    <div style="margin-top:18px">
      {delar.map((del) => (
        <Fragment>
          <div class="part">
            <span class="n">Del {ROM[del.n] || del.n}</span>
            <span class="t">{del.titel}</span>
            <span class="line"></span>
            <span class="sub">{del.sub}</span>
          </div>
          <div class="index">
            {del.kapitel.map((nr) => {
              const kap = kapitelByNr.get(nr)!;
              const { ids, klarAvail } = chapterData(kap);
              const locked = klarAvail === 0;
              return locked ? (
                <div class="ch lock" aria-disabled="true">
                  <div class="ch-n">{String(kap.nummer).padStart(2, '0')}</div>
                  <div>
                    <div class="ch-t">{kap.titel}</div>
                    <div class="ch-meta">
                      <span class="lvl">{kap.niva}</span>
                      <span>{formatTime(kap.tid_min)}</span>
                      <span data-ch-count>0/{ids.length} klara</span>
                    </div>
                  </div>
                  <span class="pill lock" data-pill>Kommande</span>
                </div>
              ) : (
                <a
                  class="ch"
                  href={`/fokus/kapitel/${kap.nummer}`}
                  data-chapter-nr={kap.nummer}
                  data-ids={JSON.stringify(ids)}
                >
                  <div class="ch-n">{String(kap.nummer).padStart(2, '0')}</div>
                  <div>
                    <div class="ch-t">{kap.titel}</div>
                    <div class="ch-meta">
                      <span class="lvl">{kap.niva}</span>
                      <span>{formatTime(kap.tid_min)}</span>
                      <span data-ch-count>0/{ids.length} klara</span>
                    </div>
                  </div>
                  <span class="pill" data-pill>Ej börjad</span>
                </a>
              );
            })}
          </div>
        </Fragment>
      ))}
    </div>
  </main>
</Broadsheet>

<style>
  /* Room for the leadprint facade to sit behind the opening block and fade out
     before the first part header. */
  .fokus-cover { padding-top: 6px; padding-bottom: 26px; }
</style>

<script>
  import { getFokusDone, FOKUS_EVENT } from '../../scripts/fokus-progress';

  function paint() {
    const done = new Set(getFokusDone());
    let overallTotal = 0;
    let overallDone = 0;

    document.querySelectorAll<HTMLElement>('[data-chapter-nr]').forEach((ch) => {
      let ids: string[] = [];
      try {
        ids = JSON.parse(ch.dataset.ids || '[]');
      } catch {
        ids = [];
      }
      const doneCount = ids.filter((id) => done.has(id)).length;
      overallTotal += ids.length;
      overallDone += doneCount;

      const countEl = ch.querySelector<HTMLElement>('[data-ch-count]');
      if (countEl) countEl.textContent = `${doneCount}/${ids.length} klara`;

      const pill = ch.querySelector<HTMLElement>('[data-pill]');
      ch.classList.remove('done', 'act');
      if (pill) pill.classList.remove('done', 'act');

      if (doneCount >= ids.length && ids.length > 0) {
        ch.classList.add('done');
        if (pill) {
          pill.classList.add('done');
          pill.textContent = 'Klar';
        }
      } else if (doneCount > 0) {
        ch.classList.add('act');
        if (pill) {
          pill.classList.add('act');
          pill.textContent = 'Pågår';
        }
      } else if (pill) {
        pill.textContent = 'Ej börjad';
      }
    });

    const pct = overallTotal ? Math.round((overallDone / overallTotal) * 100) : 0;
    const fill = document.querySelector<HTMLElement>('[data-fokus-fill]');
    if (fill) fill.style.width = pct + '%';
    const label = document.querySelector<HTMLElement>('[data-fokus-total-label]');
    if (label) label.textContent = `${overallDone} / ${overallTotal} lektioner klara`;
  }

  document.addEventListener('astro:page-load', paint);
  window.addEventListener(FOKUS_EVENT, paint);
</script>
