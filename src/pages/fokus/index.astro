---
import AppShell from '../../layouts/AppShell.astro';
import { readFileSync } from 'node:fs';
import path from 'node:path';

const courseRaw = readFileSync(
  path.resolve(process.cwd(), 'content/fundamental-aktieanalys/course.json'),
  'utf-8'
);

interface Lektion {
  lektion: string;
  titel: string;
  niva: string;
  tid_min: number;
  status: 'klar' | 'kommande';
  fil: string;
}

interface Kapitel {
  nummer: number;
  titel: string;
  niva: string;
  tid_min: number;
  lektioner: Lektion[];
}

function formatTime(min: number): string {
  if (min < 60) return `${min} min`;
  const h = Math.floor(min / 60);
  const m = min % 60;
  return m === 0 ? `${h} h` : `${h} h ${m} min`;
}

interface Kurs {
  kurs: string;
  titel: string;
  beskrivning: string;
  kapitel: Kapitel[];
}

const kurs: Kurs = JSON.parse(courseRaw);
const klarCount = kurs.kapitel
  .flatMap((k) => k.lektioner)
  .filter((l) => l.status === 'klar').length;
---

<AppShell title="Fundamental aktieanalys" active="kurs" maxWidth={880}>
  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Brodsmula">
    <a href="/hem" class="breadcrumb__link">Hem</a>
    <span class="breadcrumb__sep" aria-hidden="true">›</span>
    <span class="breadcrumb__current">Fokus</span>
  </nav>

  <!-- Course header -->
  <div class="course-header">
    <h1 class="course-title">{kurs.titel}</h1>
    <p class="course-ingress">{kurs.beskrivning}</p>

    <div class="course-progress" aria-label="Din progress">
      <div class="course-progress__track" aria-hidden="true">
        <div class="course-progress__fill" data-fokus-fill style="width:0%"></div>
      </div>
      <div class="course-progress__label">
        <span data-fokus-count>0</span> av <span data-fokus-total>{klarCount}</span> lektioner klara
      </div>
    </div>
  </div>

  <!-- Chapter list -->
  <div class="chapter-list">
    {kurs.kapitel.map((kap) => (
      <div class="chapter">
        <a class="chapter__head" href={`/fokus/kapitel/${kap.nummer}`}>
          <span class="chapter__kicker">KAPITEL {kap.nummer}</span>
          <span class="chapter__title-row">
            <h2 class="chapter__title">{kap.titel}</h2>
            <span class="chapter__chevron" aria-hidden="true">›</span>
          </span>
          <span class="chapter__meta">{formatTime(kap.tid_min)} · {kap.niva} · {kap.lektioner.length} lektioner</span>
        </a>

        <div class="lesson-list">
          {kap.lektioner.map((l) =>
            l.status === 'klar' ? (
              <a class="lesson-row lesson-row--open" data-lesson-id={l.lektion} href={`/fokus/${l.lektion}`}>
                <span class="lesson-row__check" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>
                </span>
                <span class="lesson-row__num">{l.lektion}</span>
                <span class="lesson-row__title">{l.titel}</span>
                <span class="lesson-row__niva">{l.niva}</span>
                <span class="lesson-row__time">{l.tid_min} min</span>
                <span class="lesson-row__arrow" aria-hidden="true">›</span>
              </a>
            ) : (
              <div class="lesson-row lesson-row--kommande" aria-label={`${l.titel} (kommande)`}>
                <span class="lesson-row__check lesson-row__check--placeholder" aria-hidden="true"></span>
                <span class="lesson-row__num">{l.lektion}</span>
                <span class="lesson-row__title">{l.titel}</span>
                <span class="lesson-row__niva">{l.niva}</span>
                <span class="lesson-row__time">{l.tid_min} min</span>
                <span class="lesson-row__lock" aria-hidden="true">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                  </svg>
                  Kommande
                </span>
              </div>
            )
          )}
        </div>
      </div>
    ))}
  </div>
</AppShell>

<style>
  /* ---- Breadcrumb ---- */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 500;
    margin-bottom: 28px;
    color: var(--muted);
  }
  .breadcrumb__link {
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur-micro) var(--ease-standard);
  }
  .breadcrumb__link:hover {
    color: var(--text);
  }
  .breadcrumb__sep {
    color: var(--faint);
  }
  .breadcrumb__current {
    color: var(--text);
  }

  /* ---- Course header ---- */
  .course-header {
    margin-bottom: 48px;
  }
  .course-title {
    margin: 0 0 14px;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(32px, 4vw, 46px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .course-ingress {
    margin: 0;
    max-width: 56ch;
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.6;
    color: var(--prose);
  }
  .course-progress {
    margin-top: 24px;
    max-width: 360px;
  }
  .course-progress__track {
    height: 5px;
    background: var(--surface-2);
    border-radius: var(--radius-full);
    overflow: hidden;
  }
  .course-progress__fill {
    height: 100%;
    background: var(--mint);
    border-radius: var(--radius-full);
    transition: width var(--dur-comp) var(--ease-out);
  }
  .course-progress__label {
    margin-top: 9px;
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  /* ---- Chapter list ---- */
  .chapter-list {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  /* ---- Chapter ---- */
  .chapter__head {
    display: block;
    margin-bottom: 12px;
    text-decoration: none;
    color: inherit;
  }
  .chapter__head:hover {
    text-decoration: none;
  }
  .chapter__kicker {
    display: block;
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 6px;
    transition: color var(--dur-micro) var(--ease-standard);
  }
  .chapter__head:hover .chapter__kicker {
    color: var(--mint);
  }
  .chapter__title-row {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .chapter__title {
    margin: 0;
    font-family: var(--serif);
    font-weight: 300;
    font-size: 26px;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .chapter__chevron {
    color: var(--muted);
    font-size: 18px;
    transition: transform var(--dur-micro) var(--ease-standard), color var(--dur-micro) var(--ease-standard);
  }
  .chapter__head:hover .chapter__chevron {
    color: var(--mint);
    transform: translateX(3px);
  }
  .chapter__meta {
    display: block;
    margin-top: 7px;
    font-family: var(--sans);
    font-size: 12.5px;
    font-weight: 500;
    color: var(--muted);
  }

  /* ---- Lesson list ---- */
  .lesson-list {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  /* ---- Lesson row base ---- */
  .lesson-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 15px 20px;
    border-bottom: 1px solid var(--border);
  }
  .lesson-row:last-child {
    border-bottom: none;
  }

  /* ---- Open (klar) row ---- */
  .lesson-row--open {
    text-decoration: none;
    color: var(--text);
    cursor: pointer;
    transition: background 0.15s var(--ease-standard);
  }
  .lesson-row--open:hover {
    background: var(--mint-soft);
    text-decoration: none;
  }
  .lesson-row--open:hover .lesson-row__arrow {
    color: var(--mint);
    transform: translateX(2px);
  }

  /* ---- Kommande row ---- */
  .lesson-row--kommande {
    opacity: 0.55;
    cursor: default;
  }

  /* ---- Done check marker ---- */
  .lesson-row__check {
    width: 19px;
    height: 19px;
    flex-shrink: 0;
    border: 1.5px solid var(--border-2);
    border-radius: var(--radius-full);
    display: grid;
    place-items: center;
    color: var(--on-mint);
    transition: background var(--dur-comp) var(--ease-out), border-color var(--dur-comp) var(--ease-out);
  }
  .lesson-row__check svg {
    width: 12px;
    height: 12px;
    opacity: 0;
    transition: opacity var(--dur-comp) var(--ease-out);
  }
  .lesson-row[data-done='1'] .lesson-row__check {
    background: var(--mint);
    border-color: var(--mint);
  }
  .lesson-row[data-done='1'] .lesson-row__check svg {
    opacity: 1;
  }
  .lesson-row__check--placeholder {
    border-color: transparent;
  }

  /* ---- Row cells ---- */
  .lesson-row__num {
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 600;
    color: var(--muted);
    white-space: nowrap;
    min-width: 28px;
    flex-shrink: 0;
  }
  .lesson-row__title {
    flex: 1;
    font-family: var(--serif);
    font-size: 16px;
    line-height: 1.35;
    color: var(--text);
  }
  .lesson-row__niva {
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 500;
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .lesson-row__time {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
    min-width: 44px;
    text-align: right;
  }
  .lesson-row__arrow {
    color: var(--faint);
    font-size: 18px;
    flex-shrink: 0;
    transition: color 0.15s, transform 0.15s;
  }
  .lesson-row__lock {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 500;
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* ---- Mobile ---- */
  @media (max-width: 640px) {
    .lesson-row {
      padding: 13px 16px;
      gap: 10px;
    }
    .lesson-row__niva {
      display: none;
    }
    .chapter__title {
      font-size: 22px;
    }
  }
</style>

<script>
  import { getFokusDone, FOKUS_EVENT } from '../../scripts/fokus-progress';

  function paint() {
    const done = new Set(getFokusDone());
    const rows = document.querySelectorAll<HTMLElement>('[data-lesson-id]');
    let total = 0;
    let n = 0;
    rows.forEach((row) => {
      total++;
      const id = row.dataset.lessonId || '';
      const isDone = done.has(id);
      row.dataset.done = isDone ? '1' : '0';
      if (isDone) n++;
    });
    const pct = total ? Math.round((n / total) * 100) : 0;
    const fill = document.querySelector<HTMLElement>('[data-fokus-fill]');
    if (fill) fill.style.width = pct + '%';
    const countEl = document.querySelector<HTMLElement>('[data-fokus-count]');
    if (countEl) countEl.textContent = String(n);
    const totalEl = document.querySelector<HTMLElement>('[data-fokus-total]');
    if (totalEl) totalEl.textContent = String(total);
  }

  document.addEventListener('astro:page-load', paint);
  window.addEventListener(FOKUS_EVENT, paint);
</script>
