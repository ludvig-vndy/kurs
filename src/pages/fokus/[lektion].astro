---
import fs from 'node:fs';
import path from 'node:path';
import AppShell from '../../layouts/AppShell.astro';
import Rutnat from '../../components/fokus/Rutnat.astro';
import Linjediagram from '../../components/fokus/Linjediagram.astro';
import Jamforelse from '../../components/fokus/Jamforelse.astro';
import Stapeldiagram from '../../components/fokus/Stapeldiagram.astro';
import Flode from '../../components/fokus/Flode.astro';
import Andel from '../../components/fokus/Andel.astro';
import FokusQuiz from '../../components/fokus/FokusQuiz.astro';

// ── Types ──────────────────────────────────────────────────────────────────

interface CourseLektion {
  lektion: string;
  titel: string;
  niva: string;
  tid_min: number;
  status: string;
  fil: string;
}
interface CourseKapitel {
  nummer: number;
  titel: string;
  lektioner: CourseLektion[];
}
interface CourseJson {
  kapitel: CourseKapitel[];
}

type StegTyp = 'intro' | 'reading' | 'concept' | 'dataviz' | 'quiz';

interface VisualObj {
  typ: string;
  figurtext: string;
  [key: string]: unknown;
}

interface Fraga {
  typ: 'single' | 'multi';
  fraga: string;
  underrubrik?: string;
  alternativ: string[];
  ratt: number[];
  forklaring: string;
}

interface Steg {
  typ: StegTyp;
  kicker?: string;
  titel?: string;
  ingress?: string;
  lead?: string;
  highlight?: string;
  brodtext?: string[];
  takeaway?: string;
  visual?: VisualObj;
  forklaring?: string;
  underrubrik?: string;
  slutsats?: string;
  fragor?: Fraga[];
}

interface LessonJson {
  kapitel: number;
  lektion: string;
  titel: string;
  niva: string;
  tid_min: number;
  mal: string;
  steg: Steg[];
}

// ── getStaticPaths ─────────────────────────────────────────────────────────

export async function getStaticPaths() {
  const contentDir = path.resolve('content/fundamental-aktieanalys');
  const courseRaw = fs.readFileSync(path.join(contentDir, 'course.json'), 'utf8');
  const course: CourseJson = JSON.parse(courseRaw);

  // Collect all lessons whose fil exists (regardless of status), in course order
  const builtLessons: { lektion: string; lesson: LessonJson }[] = [];
  for (const kapitel of course.kapitel) {
    for (const l of kapitel.lektioner) {
      if (l.fil) {
        const filPath = path.join(contentDir, l.fil);
        if (fs.existsSync(filPath)) {
          const lesson: LessonJson = JSON.parse(fs.readFileSync(filPath, 'utf8'));
          builtLessons.push({ lektion: l.lektion, lesson });
        }
      }
    }
  }

  return builtLessons.map(({ lektion, lesson }, idx) => {
    const prev = idx > 0 ? builtLessons[idx - 1] : null;
    const next = idx < builtLessons.length - 1 ? builtLessons[idx + 1] : null;
    return {
      params: { lektion },
      props: {
        lesson,
        prevHref: prev ? `/fokus/${prev.lektion}` : null,
        nextHref: next ? `/fokus/${next.lektion}` : null,
      },
    };
  });
}

// ── Props ─────────────────────────────────────────────────────────────────

const { lesson, prevHref, nextHref } = Astro.props as {
  lesson: LessonJson;
  prevHref: string | null;
  nextHref: string | null;
};

// ── Highlight split helper ────────────────────────────────────────────────

// A visual is renderable only if its required array field is present and non-empty.
// Guards against data typos (e.g. a flode using `steg` instead of `noder`) so one
// bad lesson degrades to its figurtext instead of crashing the whole build.
function visualOk(v: VisualObj | undefined): boolean {
  if (!v || !v.typ) return false;
  const a = v as any;
  const num = (x: unknown) => typeof x === 'number' && !Number.isNaN(x);
  const str = (x: unknown) => typeof x === 'string' && x.length > 0;
  const arr = (x: unknown) => Array.isArray(x) && x.length > 0;
  switch (v.typ) {
    case 'rutnat':
      return num(a.kolumner) && num(a.celler) && num(a.markerad) && str(a.etikett);
    case 'linjediagram':
      return arr(a.serier) && a.serier.every(
        (s: any) => str(s.namn) && Array.isArray(s.punkter) && s.punkter.length >= 2 && s.punkter.every(num)
      );
    case 'jamforelse':
      return arr(a.element) && a.element.every((e: any) => str(e.rubrik) && str(e.text));
    case 'stapeldiagram':
      return arr(a.data) && a.data.every((d: any) => str(d.kategori) && num(d.varde));
    case 'flode':
      return Array.isArray(a.noder) && a.noder.length >= 2 && a.noder.every((nd: any) => str(nd.etikett));
    case 'andel':
      return Array.isArray(a.delar) && a.delar.length >= 2 && a.delar.every((d: any) => str(d.etikett) && num(d.varde));
    default:
      return false; // unknown typ -> figurtext fallback
  }
}

function splitLead(lead: string, highlight: string): [string, string, string] {
  if (!highlight) return [lead, '', ''];
  const idx = lead.indexOf(highlight);
  if (idx === -1) return [lead, '', ''];
  return [lead.slice(0, idx), highlight, lead.slice(idx + highlight.length)];
}
---

<AppShell title={lesson.titel} active="lektion" maxWidth={760}>

  <!-- ── Rail context ── -->
  <div slot="rail-context" class="rail-fokus-ctx">
    <a href={`/fokus/${lesson.lektion}/`} class="rail__item is-active" aria-current="page">
      <span class="rail__dot" aria-hidden="true"></span>
      Lektion {lesson.lektion}
    </a>

    <div class="rail-steps">
      <div class="rail-steps__label">
        LEKTIONENS STEG
        <span data-fokus-rail-step></span>
      </div>
      <div class="rail-steps__track" aria-hidden="true">
        <div class="rail-steps__fill" data-fokus-rail-fill></div>
      </div>
    </div>
  </div>

  <!-- ── Topbar ── -->
  <div class="lesson-topbar">
    <nav class="lesson-topbar__crumbs" aria-label="Brodsmulor">
      <a href="/oversikt" class="crumb-link">Kapitel {lesson.kapitel}</a>
      <span class="crumb-sep" aria-hidden="true">&#x203A;</span>
      <span class="crumb-seg crumb-seg--active">Lektion {lesson.lektion}</span>
    </nav>
    <div class="lesson-topbar__nav">
      <div data-fokus-dots class="topbar-dots" role="tablist" aria-label="Steg"></div>
      <span data-fokus-counter class="topbar-counter"></span>
    </div>
  </div>

  <!-- ── Fokus article ── -->
  <article class="fokus" data-fokus data-lektion={lesson.lektion}>
    <div class="fokus__steps" data-fokus-steps>
      {lesson.steg.map((s, i) => {
        if (s.typ === 'intro') {
          return (
            <section class="step step--intro" data-step data-typ="intro" aria-label={`Steg ${i + 1}: Intro`}>
              <div class="step__inner step__inner--centered">
                {s.kicker && (
                  <div class="step-kicker step-kicker--intro">{s.kicker}</div>
                )}
                {s.titel && (
                  <h1 class="step-title step-title--intro">{s.titel}</h1>
                )}
                {s.ingress && (
                  <p class="step-ingress">{s.ingress}</p>
                )}
              </div>
            </section>
          );
        }

        if (s.typ === 'reading') {
          const [before, hl, after] = splitLead(s.lead ?? '', s.highlight ?? '');
          return (
            <section class="step step--reading" data-step data-typ="reading" aria-label={`Steg ${i + 1}: Lasning`}>
              <div class="step__inner step__inner--left">
                {s.kicker && (
                  <div class="step-kicker">{s.kicker}</div>
                )}
                <p class="step-lead">
                  {before}<span class="hl">{hl}</span>{after}
                </p>
                {s.brodtext && s.brodtext.map((para) => (
                  <p class="step-body">{para}</p>
                ))}
                {s.takeaway && (
                  <div class="step-takeaway">
                    <div class="step-takeaway__kicker">TA MED DIG</div>
                    <div class="step-takeaway__text">{s.takeaway}</div>
                  </div>
                )}
              </div>
            </section>
          );
        }

        if (s.typ === 'concept') {
          return (
            <section class:list={['step', 'step--concept', { 'step--text-only': !s.visual }]} data-step data-typ="concept" aria-label={`Steg ${i + 1}: Koncept`}>
              <div class="step__inner step__inner--centered">
                {s.kicker && (
                  <div class="step-kicker">{s.kicker}</div>
                )}
                {s.titel && (
                  <h2 class="step-title step-title--concept">{s.titel}</h2>
                )}
                {s.visual && (visualOk(s.visual) ? (
                  s.visual.typ === 'rutnat' ? (
                    <Rutnat visual={s.visual as any} />
                  ) : s.visual.typ === 'linjediagram' ? (
                    <Linjediagram visual={s.visual as any} />
                  ) : s.visual.typ === 'jamforelse' ? (
                    <Jamforelse visual={s.visual as any} />
                  ) : s.visual.typ === 'stapeldiagram' ? (
                    <Stapeldiagram visual={s.visual as any} />
                  ) : s.visual.typ === 'flode' ? (
                    <Flode visual={s.visual as any} />
                  ) : s.visual.typ === 'andel' ? (
                    <Andel visual={s.visual as any} />
                  ) : (
                    <p class="visual-fallback">{s.visual.figurtext}</p>
                  )
                ) : (
                  <p class="visual-fallback">{s.visual.figurtext}</p>
                ))}
                {s.brodtext && s.brodtext.length > 0 && (
                  <div class="step-prose">
                    {s.brodtext.map((p) => (
                      <p>{p}</p>
                    ))}
                  </div>
                )}
                {s.forklaring && (
                  <p class="step-forklaring">{s.forklaring}</p>
                )}
              </div>
            </section>
          );
        }

        if (s.typ === 'dataviz') {
          return (
            <section class:list={['step', 'step--dataviz', { 'step--text-only': !s.visual }]} data-step data-typ="dataviz" aria-label={`Steg ${i + 1}: Dataviz`}>
              <div class="step__inner step__inner--centered">
                {s.titel && (
                  <h2 class="step-title step-title--dataviz">{s.titel}</h2>
                )}
                {s.underrubrik && (
                  <p class="step-underrubrik">{s.underrubrik}</p>
                )}
                {s.visual && (visualOk(s.visual) ? (
                  s.visual.typ === 'rutnat' ? (
                    <Rutnat visual={s.visual as any} />
                  ) : s.visual.typ === 'linjediagram' ? (
                    <Linjediagram visual={s.visual as any} />
                  ) : s.visual.typ === 'jamforelse' ? (
                    <Jamforelse visual={s.visual as any} />
                  ) : s.visual.typ === 'stapeldiagram' ? (
                    <Stapeldiagram visual={s.visual as any} />
                  ) : s.visual.typ === 'flode' ? (
                    <Flode visual={s.visual as any} />
                  ) : s.visual.typ === 'andel' ? (
                    <Andel visual={s.visual as any} />
                  ) : (
                    <p class="visual-fallback">{s.visual.figurtext}</p>
                  )
                ) : (
                  <p class="visual-fallback">{s.visual.figurtext}</p>
                ))}
                {s.brodtext && s.brodtext.length > 0 && (
                  <div class="step-prose">
                    {s.brodtext.map((p) => (
                      <p>{p}</p>
                    ))}
                  </div>
                )}
                {s.slutsats && (
                  <p class="step-slutsats">{s.slutsats}</p>
                )}
              </div>
            </section>
          );
        }

        if (s.typ === 'quiz') {
          return (
            <section class="step step--quiz" data-step data-typ="quiz" aria-label={`Steg ${i + 1}: Kunskapskoll`}>
              <div class="step__inner step__inner--left">
                <FokusQuiz fragor={s.fragor ?? []} lektionId={lesson.lektion} />
              </div>
            </section>
          );
        }

        return null;
      })}
    </div>
  </article>

  <!-- Hidden adjacent-lesson nav links (used programmatically by fokus.ts) -->
  {nextHref && <a class="fokus-pn fokus-pn--next" href={nextHref} aria-hidden="true" tabindex="-1">Nasta lektion</a>}
  {prevHref && <a class="fokus-pn fokus-pn--prev" href={prevHref} aria-hidden="true" tabindex="-1">Foregaende lektion</a>}

</AppShell>

<style>
  /* ── Topbar ─────────────────────────────────────────────────────────── */
  .lesson-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) 0 var(--space-5);
    border-bottom: 1px solid var(--border);
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
  }
  .lesson-topbar__crumbs {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--sans);
    font-size: var(--text-xs);
    color: var(--muted);
    flex-wrap: wrap;
  }
  .crumb-link {
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur-micro) var(--ease-standard);
  }
  .crumb-link:hover {
    color: var(--text);
    text-decoration: none;
  }
  .crumb-sep {
    color: var(--faint);
  }
  .crumb-seg {
    color: var(--muted);
  }
  .crumb-seg--active {
    color: var(--text);
    font-weight: 500;
  }
  .lesson-topbar__nav {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .topbar-dots {
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .topbar-counter {
    font-family: var(--sans);
    font-size: var(--text-xs);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  /* ── Rail context (page-scoped; slotted content carries page scope) ── */
  .rail-fokus-ctx {
    display: contents;
  }
  .rail__item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 11px;
    font-family: var(--sans);
    font-weight: 500;
    font-size: 14px;
    color: var(--muted);
    text-decoration: none;
  }
  .rail__item:hover {
    text-decoration: none;
  }
  .rail__item.is-active {
    color: var(--text);
    background: var(--mint-soft);
  }
  .rail__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.55;
    flex-shrink: 0;
  }
  .rail__item.is-active .rail__dot {
    background: var(--mint);
    opacity: 1;
  }
  .rail-steps {
    padding: 0 10px;
    margin-bottom: 8px;
  }
  .rail-steps__label {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 0.16em;
    color: var(--muted);
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .rail-steps__track {
    height: 3px;
    background: var(--faint);
    border-radius: var(--radius-full);
    overflow: hidden;
  }
  .rail-steps__fill {
    height: 100%;
    width: 0%;
    background: var(--mint);
    border-radius: var(--radius-full);
    transition: width var(--dur-comp) var(--ease-out);
  }

  /* ── Hidden adjacent links ──────────────────────────────────────────── */
  .fokus-pn {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ── Fokus article ──────────────────────────────────────────────────── */
  .fokus {
    position: relative;
  }

  /* ── Steps container ────────────────────────────────────────────────── */
  .step {
    display: none;
    animation: stepRise 0.65s cubic-bezier(0.21, 0.7, 0.18, 1) both;
  }
  .step.is-active {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .step {
      animation: none;
    }
  }

  @keyframes stepRise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .step__inner {
    width: 100%;
    padding: var(--space-8) 0 var(--space-6);
  }
  .step__inner--centered {
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
  }
  .step__inner--left {
    text-align: left;
    max-width: 640px;
    margin: 0 auto;
  }

  /* ── Kicker ─────────────────────────────────────────────────────────── */
  .step-kicker {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--mint);
    margin-bottom: 26px;
  }
  .step-kicker--intro {
    letter-spacing: 0.28em;
    font-size: 12px;
    margin-bottom: 30px;
  }

  /* ── Intro step ─────────────────────────────────────────────────────── */
  .step-title--intro {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(48px, 7vw, 84px);
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0 0 32px;
  }
  .step-ingress {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 21px;
    line-height: 1.55;
    color: var(--prose);
    max-width: 30ch;
    margin: 0 auto;
  }

  /* ── Reading step ───────────────────────────────────────────────────── */
  .step-lead {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(26px, 3.4vw, 38px);
    line-height: 1.32;
    letter-spacing: -0.01em;
    color: var(--text);
    margin: 0 0 30px;
  }
  .hl {
    color: var(--mint);
  }
  .step-body {
    font-family: var(--serif);
    font-size: var(--prose-size);
    line-height: 1.7;
    color: var(--prose);
    max-width: 60ch;
    margin: 0 0 var(--space-5);
  }
  .step-takeaway {
    border-left: 2px solid var(--mint);
    padding: 6px 0 6px 20px;
    margin-top: var(--space-5);
  }
  .step-takeaway__kicker {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 0.16em;
    color: var(--mint);
    margin-bottom: 8px;
    text-transform: uppercase;
  }
  .step-takeaway__text {
    font-family: var(--serif);
    font-style: italic;
    font-size: 21px;
    line-height: 1.4;
    color: var(--text);
  }

  /* ── Concept step ───────────────────────────────────────────────────── */
  .step-title--concept {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(32px, 4vw, 46px);
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--text);
    margin: 0 0 36px;
  }
  .step-forklaring {
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.6;
    color: var(--prose);
    max-width: 42ch;
    margin: 0 auto;
  }

  /* ── Dataviz step ───────────────────────────────────────────────────── */
  .step-title--dataviz {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(30px, 3.8vw, 44px);
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--text);
    margin: 0 0 8px;
  }
  .step-underrubrik {
    font-family: var(--serif);
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 44ch;
    margin: 0 auto 34px;
  }
  .step-slutsats {
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.6;
    color: var(--prose);
    max-width: 44ch;
    margin: var(--space-5) auto 0;
  }

  /* ── Prose paragraphs on concept/dataviz (text-heavy lessons) ───────── */
  .step-prose {
    max-width: 58ch;
    margin: var(--space-5) auto 0;
    text-align: left;
  }
  .step-prose p {
    font-family: var(--serif);
    font-size: var(--prose-size);
    line-height: 1.7;
    color: var(--prose);
    margin: 0;
  }
  .step-prose p + p {
    margin-top: 1.1em;
  }
  /* When a concept/dataviz step has no visual, give the text more breathing room. */
  .step--text-only .step-prose {
    margin-top: var(--space-6);
  }

  /* ── Visual fallback (unknown visual.typ) ───────────────────────────── */
  .visual-fallback {
    font-family: var(--serif);
    font-style: italic;
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted);
    text-align: center;
    padding: var(--space-5) 0;
    margin: 0 auto;
    max-width: 46ch;
  }

  /* ── Visual placeholder (replaced by RB-2) ──────────────────────────── */
  .visual-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 180px;
    border: 1px dashed var(--border-2);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    margin: 0 auto var(--space-5);
    max-width: 480px;
    background: var(--surface);
  }
  .visual-placeholder__text {
    font-family: var(--serif);
    font-style: italic;
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted);
    text-align: center;
  }

  /* ── Quiz placeholder (replaced by RB-3) ───────────────────────────── */
  .quiz-header {
    margin-bottom: var(--space-6);
  }
  .step-title--quiz {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(30px, 3.6vw, 40px);
    line-height: 1.1;
    color: var(--text);
    margin: 0;
  }
  .quiz-question {
    margin-top: var(--space-7);
    text-align: left;
  }
  .quiz-question__text {
    font-family: var(--serif);
    font-size: 21px;
    line-height: 1.4;
    color: var(--text);
    margin-bottom: 16px;
  }
  .quiz-question__num {
    display: inline-block;
    font-family: var(--sans);
    font-weight: 600;
    font-size: 14px;
    color: var(--mint);
    margin-right: 10px;
  }
  .quiz-question__sub {
    font-family: var(--sans);
    font-weight: 500;
    font-size: 12px;
    color: var(--muted);
