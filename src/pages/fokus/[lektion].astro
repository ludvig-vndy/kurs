---
import fs from 'node:fs';
import path from 'node:path';
import Broadsheet from '../../layouts/Broadsheet.astro';
import Rutnat from '../../components/fokus/Rutnat.astro';
import Linjediagram from '../../components/fokus/Linjediagram.astro';
import Jamforelse from '../../components/fokus/Jamforelse.astro';
import Stapeldiagram from '../../components/fokus/Stapeldiagram.astro';
import Flode from '../../components/fokus/Flode.astro';
import Andel from '../../components/fokus/Andel.astro';
import FokusQuiz from '../../components/fokus/FokusQuiz.astro';

// ── Types ──────────────────────────────────────────────────────────────────
interface CourseLektion { lektion: string; titel: string; niva: string; tid_min: number; status: string; fil: string }
interface CourseKapitel { nummer: number; titel: string; lektioner: CourseLektion[] }
interface CourseJson { kapitel: CourseKapitel[] }

type StegTyp = 'intro' | 'reading' | 'concept' | 'dataviz' | 'quiz';
interface VisualObj { typ: string; figurtext: string; [key: string]: unknown }
interface Fraga { typ: 'single' | 'multi'; fraga: string; underrubrik?: string; alternativ: string[]; ratt: number[]; forklaring: string }
interface Steg {
  typ: StegTyp; kicker?: string; titel?: string; ingress?: string; lead?: string; highlight?: string;
  brodtext?: string[]; takeaway?: string; visual?: VisualObj; forklaring?: string; underrubrik?: string;
  slutsats?: string; fragor?: Fraga[];
}
interface LessonJson { kapitel: number; lektion: string; titel: string; niva: string; tid_min: number; mal: string; steg: Steg[] }

// ── getStaticPaths ─────────────────────────────────────────────────────────
export async function getStaticPaths() {
  const contentDir = path.resolve('content/fundamental-aktieanalys');
  const course: CourseJson = JSON.parse(fs.readFileSync(path.join(contentDir, 'course.json'), 'utf8'));

  const chapterIdsMap: Record<number, string[]> = {};
  for (const kapitel of course.kapitel) {
    chapterIdsMap[kapitel.nummer] = kapitel.lektioner.map((l) => l.lektion);
  }

  const builtLessons: { lektion: string; lesson: LessonJson }[] = [];
  for (const kapitel of course.kapitel) {
    for (const l of kapitel.lektioner) {
      if (l.fil) {
        const filPath = path.join(contentDir, l.fil);
        if (fs.existsSync(filPath)) {
          const lesson: LessonJson = JSON.parse(fs.readFileSync(filPath, 'utf8'));
          builtLessons.push({ lektion: l.lektion, lesson });
        }
      }
    }
  }
  const courseIds = builtLessons.map((b) => b.lektion);

  return builtLessons.map(({ lektion, lesson }, idx) => {
    const prev = idx > 0 ? builtLessons[idx - 1] : null;
    const next = idx < builtLessons.length - 1 ? builtLessons[idx + 1] : null;
    return {
      params: { lektion },
      props: {
        lesson,
        prevHref: prev ? `/fokus/${prev.lektion}` : null,
        nextHref: next ? `/fokus/${next.lektion}` : null,
        nextLektion: next ? next.lektion : null,
        chapterIds: chapterIdsMap[lesson.kapitel] ?? [],
        courseIds,
      },
    };
  });
}

const { lesson, prevHref, nextHref, nextLektion, chapterIds, courseIds } = Astro.props as {
  lesson: LessonJson;
  prevHref: string | null;
  nextHref: string | null;
  nextLektion: string | null;
  chapterIds: string[];
  courseIds: string[];
};

const total = lesson.steg.length;
const meta = { lektion: lesson.lektion, kapitel: lesson.kapitel, chapterIds, courseIds, nextHref };

// ── Ordlista: margin-note glosses on a term's first appearance in the lesson ─
const ordlista = JSON.parse(
  fs.readFileSync(path.resolve('src/data/ordlista.json'), 'utf8')
) as Record<string, string>;
// Longest terms first so EV/EBITDA is matched (and masked) before EV.
const glossTerms = Object.keys(ordlista).sort((a, b) => b.length - a.length);

function stepText(s: Steg): string {
  const v: any = s.visual ?? {};
  const parts: (string | undefined)[] = [
    s.kicker, s.titel, s.ingress, s.lead, s.underrubrik, s.forklaring, s.slutsats, s.takeaway,
    ...(s.brodtext ?? []),
    v.figurtext,
    ...((v.element ?? []).flatMap((e: any) => [e.rubrik, e.text])),
    ...((v.noder ?? []).map((n: any) => n.etikett)),
    ...((v.delar ?? []).map((d: any) => d.etikett)),
    ...((v.data ?? []).map((d: any) => d.kategori)),
    ...((v.serier ?? []).map((se: any) => se.namn)),
    ...((s.fragor ?? []).flatMap((f) => [f.fraga, f.underrubrik, ...(f.alternativ ?? []), f.forklaring])),
  ];
  return parts.filter(Boolean).join('  ');
}
function termRe(term: string, global: boolean): RegExp {
  const esc = term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const lower = !/[A-ZÅÄÖ]/.test(term); // pure-lowercase terms match case-insensitively
  const flags = (lower ? 'i' : '') + (global ? 'g' : '');
  return new RegExp('(?<![A-Za-zÅÄÖåäö0-9])' + esc + '(?![A-Za-zÅÄÖåäö0-9])', flags);
}
const seenTerms = new Set<string>();
const stepGloss: { term: string; forklaring: string }[][] = lesson.steg.map((s) => {
  let work = stepText(s);
  const found: { term: string; forklaring: string }[] = [];
  for (const term of glossTerms) {
    if (seenTerms.has(term)) continue;
    if (termRe(term, false).test(work)) {
      seenTerms.add(term);
      found.push({ term, forklaring: ordlista[term] });
      work = work.replace(termRe(term, true), '  '); // mask so shorter terms don't match inside
    }
  }
  return found;
});

// ── Helpers ────────────────────────────────────────────────────────────────
function visualOk(v: VisualObj | undefined): boolean {
  if (!v || !v.typ) return false;
  const a = v as any;
  const num = (x: unknown) => typeof x === 'number' && !Number.isNaN(x);
  const str = (x: unknown) => typeof x === 'string' && x.length > 0;
  const arr = (x: unknown) => Array.isArray(x) && x.length > 0;
  switch (v.typ) {
    case 'rutnat': return num(a.kolumner) && num(a.celler) && num(a.markerad) && str(a.etikett);
    case 'linjediagram': return arr(a.serier) && a.serier.every((s: any) => str(s.namn) && Array.isArray(s.punkter) && s.punkter.length >= 2 && s.punkter.every(num));
    case 'jamforelse': return arr(a.element) && a.element.every((e: any) => str(e.rubrik) && str(e.text));
    case 'stapeldiagram': return arr(a.data) && a.data.every((d: any) => str(d.kategori) && num(d.varde));
    case 'flode': return Array.isArray(a.noder) && a.noder.length >= 2 && a.noder.every((nd: any) => str(nd.etikett));
    case 'andel': return Array.isArray(a.delar) && a.delar.length >= 2 && a.delar.every((d: any) => str(d.etikett) && num(d.varde));
    default: return false;
  }
}
function splitLead(lead: string, highlight: string): [string, string, string] {
  if (!highlight) return [lead, '', ''];
  const idx = lead.indexOf(highlight);
  if (idx === -1) return [lead, '', ''];
  return [lead.slice(0, idx), highlight, lead.slice(idx + highlight.length)];
}

function visualEl(v: VisualObj) {
  if (!visualOk(v)) return null;
  return v;
}
---

<Broadsheet title={lesson.titel} chrome="none">
  <script type="application/json" data-fokus-meta set:html={JSON.stringify(meta)} />

  <div class="player" data-player>
    <!-- ── Running head ── -->
    <header class="rh">
      <div class="rh-in">
        <div class="rh-top">
          <nav class="crumb" aria-label="Brodsmulor">
            <span class="mk" aria-hidden="true"></span>
            <a href="/hem">Hem</a><span class="sep">›</span>
            <a href={`/fokus/kapitel/${lesson.kapitel}`}>Kapitel {lesson.kapitel}</a><span class="sep">›</span>
            <span class="here">Lektion {lesson.lektion}</span>
          </nav>
          <div class="folio"><b data-fnow>01</b> / <span data-ftot>{String(total).padStart(2, '0')}</span></div>
        </div>
        <div class="track" data-track aria-hidden="true"></div>
      </div>
    </header>

    <!-- ── Stage ── -->
    <main class="stage">
      <div class="step-host" data-fokus data-lektion={lesson.lektion}>
        <div class="steps" data-fokus-steps>
          {lesson.steg.map((s, i) => {
            const gloss = stepGloss[i];
            const hasGloss = gloss.length > 0;
            return (
              <section
                class:list={['step', { 'has-gloss': hasGloss, 'step--intro': s.typ === 'intro' }]}
                data-step
                data-typ={s.typ}
                aria-label={`Steg ${i + 1}`}
              >
                {s.typ === 'intro' && (
                  <div class="s-intro">
                    {s.kicker && <div class="kicker kicker--intro">{s.kicker}</div>}
                    {s.titel && <h1 class="s-title">{s.titel}</h1>}
                    {s.ingress && <p class="s-ingress">{s.ingress}</p>}
                    <div class="s-meta">Kapitel {lesson.kapitel} · {total} steg · {lesson.niva}</div>
                  </div>
                )}

                {s.typ === 'reading' && (() => {
                  const [before, hl, after] = splitLead(s.lead ?? '', s.highlight ?? '');
                  return (
                    <div class="s-col">
                      {s.kicker && <div class="kicker">{s.kicker}</div>}
                      <p class="s-lead">{before}<mark>{hl}</mark>{after}</p>
                      {s.brodtext && s.brodtext.map((para) => <p class="s-body">{para}</p>)}
                      {s.takeaway && <blockquote class="s-take">{s.takeaway}</blockquote>}
                    </div>
                  );
                })()}

                {s.typ === 'concept' && (
                  <div class="s-col s-col--center">
                    {s.kicker && <div class="kicker">{s.kicker}</div>}
                    {s.titel && <h2 class="s-ctitle">{s.titel}</h2>}
                    {s.visual && (visualEl(s.visual) ? (
                      s.visual.typ === 'rutnat' ? <Rutnat visual={s.visual as any} />
                      : s.visual.typ === 'linjediagram' ? <Linjediagram visual={s.visual as any} />
                      : s.visual.typ === 'jamforelse' ? <Jamforelse visual={s.visual as any} />
                      : s.visual.typ === 'stapeldiagram' ? <Stapeldiagram visual={s.visual as any} />
                      : s.visual.typ === 'flode' ? <Flode visual={s.visual as any} />
                      : s.visual.typ === 'andel' ? <Andel visual={s.visual as any} />
                      : <p class="visual-fallback">{s.visual.figurtext}</p>
                    ) : <p class="visual-fallback">{s.visual.figurtext}</p>)}
                    {s.brodtext && s.brodtext.length > 0 && (
                      <div class="s-prose">{s.brodtext.map((p) => <p>{p}</p>)}</div>
                    )}
                    {s.forklaring && <p class="s-forklaring">{s.forklaring}</p>}
                  </div>
                )}

                {s.typ === 'dataviz' && (
                  <div class="s-col s-col--center">
                    {s.titel && <h2 class="s-ctitle">{s.titel}</h2>}
                    {s.underrubrik && <p class="s-underrubrik">{s.underrubrik}</p>}
                    {s.visual && (visualEl(s.visual) ? (
                      s.visual.typ === 'rutnat' ? <Rutnat visual={s.visual as any} />
                      : s.visual.typ === 'linjediagram' ? <Linjediagram visual={s.visual as any} />
                      : s.visual.typ === 'jamforelse' ? <Jamforelse visual={s.visual as any} />
                      : s.visual.typ === 'stapeldiagram' ? <Stapeldiagram visual={s.visual as any} />
                      : s.visual.typ === 'flode' ? <Flode visual={s.visual as any} />
                      : s.visual.typ === 'andel' ? <Andel visual={s.visual as any} />
                      : <p class="visual-fallback">{s.visual.figurtext}</p>
                    ) : <p class="visual-fallback">{s.visual.figurtext}</p>)}
                    {s.brodtext && s.brodtext.length > 0 && (
                      <div class="s-prose">{s.brodtext.map((p) => <p>{p}</p>)}</div>
                    )}
                    {s.slutsats && <p class="s-slutsats">{s.slutsats}</p>}
                  </div>
                )}

                {s.typ === 'quiz' && (
                  <div class="s-col"><FokusQuiz fragor={s.fragor ?? []} lektionId={lesson.lektion} quizId={`${lesson.lektion}.s${i}`} /></div>
                )}

                {hasGloss && (
                  <aside class="gloss" aria-label="Ordforklaringar">
                    {gloss.map((g) => (
                      <div class="gloss__item">
                        <div class="gloss__term">{g.term}</div>
                        <div class="gloss__def">{g.forklaring}</div>
                      </div>
                    ))}
                  </aside>
                )}
              </section>
            );
          })}
        </div>
      </div>
    </main>

    <!-- ── Quiz gate (shown if you try to finish below 80%) ── -->
    <div class="qgate" data-quiz-gate hidden role="alertdialog" aria-label="Quizet är inte klart">
      <p class="qgate__msg" data-quiz-gate-msg></p>
      <div class="qgate__btns">
        <button type="button" class="qgate__redo" data-quiz-gate-redo>Öva om de du missade</button>
        <button type="button" class="qgate__skip" data-quiz-gate-skip>Slutför ändå</button>
      </div>
    </div>

    <!-- ── Bottom nav ── -->
    <footer class="lnav">
      <div class="lnav-in">
        <button class="lback" type="button" data-back>← Tillbaka</button>
        <span class="lhint">Använd piltangenterna ← →</span>
        <button class="lnext" type="button" data-next>Fortsätt →</button>
      </div>
    </footer>

    <!-- ── Completion ── -->
    <section class="done-stage" data-done-panel>
      <div class="done-in">
        <div class="seal" aria-hidden="true"></div>
        <div class="done-kick">Lektion klar</div>
        <h1 class="done-title">{lesson.titel}</h1>
        <p class="done-sub">Ett steg till i kursen. Bra jobbat.</p>
        <div class="done-stat">
          <div class="c"><div class="v"><span data-done-chap>0</span><span class="su">/{chapterIds.length}</span></div><div class="l">i Kapitel {lesson.kapitel}</div></div>
          <div class="c"><div class="v" style="color:var(--oxblood)" data-done-total>0</div><div class="l">av {courseIds.length} totalt</div></div>
          <div class="c"><div class="v" data-done-streak>0</div><div class="l">dagar i rad</div></div>
        </div>
        <div class="done-cta">
          <a class="btn-ghost" href={`/fokus/kapitel/${lesson.kapitel}`}>Till kapitlet</a>
          {nextHref && <a class="btn-ink" href={nextHref}>Nästa: lektion {nextLektion} →</a>}
          {!nextHref && <a class="btn-ink" href="/fokus">Till kursöversikt →</a>}
        </div>
      </div>
    </section>
  </div>
</Broadsheet>

<style>
  .player { display: contents; }

  /* ── Running head ── */
  /* Solid (not fading to transparent) so scrolled-up step text hides cleanly
     behind the running head instead of bleeding through under the breadcrumb. */
  .rh { position: sticky; top: 0; z-index: 10; background: var(--paper); padding: 16px clamp(18px,5vw,52px) 0; }
  .rh-in { max-width: 1080px; margin: 0 auto; }
  .rh-top { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .rh .crumb { margin: 0; }
  .rh .crumb .mk { width: 18px; height: 18px; border-radius: 5px; background: var(--oxblood); margin-right: 4px; }
  .rh .crumb a { color: var(--ink-soft); text-decoration: none; }
  .rh .crumb a:hover { color: var(--oxblood); }
  .folio { font-family: var(--mono); font-size: 11.5px; letter-spacing: .1em; color: var(--ink-soft); white-space: nowrap; }
  .folio b { color: var(--oxblood); font-weight: 500; }
  .track { display: flex; gap: 4px; margin: 6px 0 0; padding-bottom: 8px; }
  .rh-in::after { content: ""; display: block; border-bottom: 1px solid var(--rule); }
  /* Segments double as a stepper, so the tappable area is 20px tall while the
     visible bar stays a 3px hairline centered within it. */
  :global(.track .seg) { flex: 1; height: 20px; background: none; cursor: pointer; position: relative; }
  :global(.track .seg::before) { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 3px; margin-top: -1.5px; background: var(--paper-2); }
  :global(.track .seg::after) { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 3px; margin-top: -1.5px; background: var(--oxblood); transform: scaleX(0); transform-origin: left center; transition: transform .5s cubic-bezier(.2,.7,.2,1); }
  :global(.track .seg.done::after), :global(.track .seg.cur::after) { transform: scaleX(1); }

  /* ── Stage ── */
  .stage { flex: 1; display: flex; align-items: flex-start; justify-content: center; padding: clamp(36px,6vh,84px) clamp(18px,5vw,52px) clamp(24px,4vh,56px); }
  .steps { width: 100%; max-width: 960px; margin: 0 auto; }
  .step { display: none; }
  .step.is-active { display: block; animation: step-rise .5s cubic-bezier(.21,.7,.18,1) both; }
  .step.is-active.has-gloss { display: grid; grid-template-columns: minmax(0, 660px) 210px; gap: 32px; justify-content: center; align-items: start; }
  .step.is-active.has-gloss .s-col, .step.is-active.has-gloss .s-intro { margin: 0; }
  /* Calm pass: gentle fade with a minimal 6px rise (was 16px) on step change. */
  @keyframes step-rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .step.is-active { animation: none; } }

  .s-col { max-width: 660px; margin: 0 auto; text-align: left; }
  .s-col--center { text-align: center; }
  .s-col--center .s-prose, .s-col--center .visual-fallback { text-align: left; }

  /* ── Margin gloss box ── */
  .gloss { grid-column: 2; display: flex; flex-direction: column; gap: 20px; padding-top: 4px; }
  .gloss__item { border-left: 2px solid var(--oxblood); padding: 1px 0 1px 14px; }
  .gloss__term { font-family: var(--mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--oxblood); margin-bottom: 6px; }
  .gloss__def { font-family: var(--serif); font-size: 13.5px; line-height: 1.5; color: var(--ink-soft); }

  /* kicker spacing override for intro */
  .kicker--intro { letter-spacing: .26em; font-size: 12px; margin-bottom: 22px; }

  /* intro */
  .s-intro { text-align: center; max-width: 600px; margin: 0 auto; }
  .s-title { font-family: var(--display); font-weight: 300; font-size: clamp(40px,7vw,76px); line-height: 1.0; letter-spacing: -.02em; margin: 0 0 22px; }
  .s-ingress { font-size: 21px; color: var(--ink-soft); font-style: italic; max-width: 34ch; margin: 0 auto; }
  .s-meta { display: inline-block; margin-top: 34px; padding-top: 20px; border-top: 1px solid var(--rule); font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }

  /* reading */
  .s-lead { font-family: var(--display); font-weight: 300; font-size: clamp(23px,3vw,30px); line-height: 1.34; letter-spacing: -.01em; margin: 0 0 24px; }
  .s-lead mark { background: none; color: inherit; font-style: italic; }
  .s-body { color: var(--ink-soft); margin: 0 0 18px; max-width: 62ch; }
  .s-take { margin-top: 26px; border-left: 2px solid var(--oxblood); padding: 4px 0 4px 22px; font-family: var(--display); font-style: italic; font-size: 21px; line-height: 1.4; color: var(--ink); }
  /* Byline, not a shouty label: mixed case, light tracking, reads as a signature. */
  .s-take::before { content: "Sebastian tänker"; display: block; font-family: var(--mono); font-style: normal; font-size: 11px; letter-spacing: .01em; color: var(--oxblood); margin-bottom: 8px; }

  /* concept / dataviz */
  .s-ctitle { font-family: var(--display); font-weight: 400; font-size: clamp(26px,3.6vw,38px); line-height: 1.08; letter-spacing: -.015em; margin: 0 0 8px; }
  .s-underrubrik { color: var(--ink-soft); font-style: italic; font-size: 18px; margin: 0 auto 22px; max-width: 52ch; }
  .s-forklaring { color: var(--ink-soft); margin: 22px auto 0; max-width: 54ch; }
  .s-slutsats { margin: 22px auto 0; font-family: var(--display); font-weight: 400; font-size: 20px; line-height: 1.4; max-width: 52ch; }
  .s-slutsats::before { content: "\27F6  "; color: var(--oxblood); }
  .s-prose { max-width: 60ch; margin: 22px auto 0; }
  .s-prose p { color: var(--ink-soft); margin: 0; }
  .s-prose p + p { margin-top: 1.05em; }

  /* ── Quiz gate ── */
  .qgate { max-width: 560px; margin: 0 auto; background: var(--card); border: 1px solid var(--oxblood); border-left: 3px solid var(--oxblood); padding: 16px 20px; display: flex; flex-direction: column; gap: 12px; }
  .qgate[hidden] { display: none; }
  .qgate__msg { font-family: var(--serif); font-size: 15.5px; line-height: 1.5; color: var(--ink); margin: 0; }
  .qgate__btns { display: flex; gap: 12px; flex-wrap: wrap; }
  .qgate__redo { font-family: var(--mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; background: var(--ink); color: var(--paper); border: none; padding: 12px 22px; border-radius: 99px; cursor: pointer; transition: background .2s; }
  .qgate__redo:hover { background: var(--oxblood); }
  .qgate__skip { font-family: var(--mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; background: none; border: 1px solid var(--rule-strong); color: var(--ink-soft); padding: 11px 20px; border-radius: 99px; cursor: pointer; transition: border-color .2s, color .2s; }
  .qgate__skip:hover { border-color: var(--oxblood); color: var(--oxblood); }

  /* ── Bottom nav ── */
  .lnav { position: sticky; bottom: 0; background: linear-gradient(rgba(246,242,234,0), var(--paper) 40%); padding: 14px clamp(18px,5vw,52px) 22px; }
  .lnav-in { max-width: 1080px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 16px; border-top: 1px solid var(--rule); padding-top: 16px; }
  .lback { background: none; border: none; font-family: var(--mono); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); cursor: pointer; padding: 8px 4px; }
  .lback:hover { color: var(--ink); }
  .lhint { font-family: var(--mono); font-size: 10.5px; color: var(--faint); letter-spacing: .04em; }
  .lnext { font-family: var(--mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; background: var(--ink); color: var(--paper); border: none; padding: 15px 30px; border-radius: 99px; cursor: pointer; transition: background .25s, transform .25s; }
  .lnext:hover { background: var(--oxblood); transform: translateX(3px); }

