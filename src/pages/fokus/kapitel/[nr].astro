---
import fs from 'node:fs';
import path from 'node:path';
import AppShell from '../../../layouts/AppShell.astro';

// ── Types ────────────────────────────────────────────────────────────────
interface CourseLektion {
  lektion: string;
  titel: string;
  niva: string;
  tid_min: number;
  status: string;
  fil: string;
}
interface CourseKapitel {
  nummer: number;
  titel: string;
  niva: string;
  tid_min: number;
  blurb: string;
  outcomes: string[];
  lektioner: CourseLektion[];
}
interface CourseJson {
  kapitel: CourseKapitel[];
}

// ── getStaticPaths ──────────────────────────────────────────────────────
export async function getStaticPaths() {
  const contentDir = path.resolve('content/fundamental-aktieanalys');
  const course: CourseJson = JSON.parse(
    fs.readFileSync(path.join(contentDir, 'course.json'), 'utf8')
  );
  return course.kapitel.map((kap) => ({
    params: { nr: String(kap.nummer) },
    props: { kap },
  }));
}

const { kap } = Astro.props as { kap: CourseKapitel };

// ── Helpers ─────────────────────────────────────────────────────────────
function formatTime(min: number): string {
  if (min < 60) return `${min} min`;
  const h = Math.floor(min / 60);
  const m = min % 60;
  return m === 0 ? `${h} h` : `${h} h ${m} min`;
}

const lessonCount = kap.lektioner.length;
const metaText = `${formatTime(kap.tid_min)} · ${kap.niva} · ${lessonCount} lektioner`;

// Order of lesson-ids in this chapter (for client-side "nästa" computation)
const chapterOrder = kap.lektioner.map((l) => l.lektion);
---

<AppShell title={`Kapitel ${kap.nummer}: ${kap.titel}`} active="kurs" maxWidth={780}>
  <script type="application/json" data-chapter-order set:html={JSON.stringify(chapterOrder)} />

  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Brodsmula">
    <a href="/hem" class="breadcrumb__link">Hem</a>
    <span class="breadcrumb__sep" aria-hidden="true">›</span>
    <a href="/fokus" class="breadcrumb__link">Kursöversikt</a>
    <span class="breadcrumb__sep" aria-hidden="true">›</span>
    <span class="breadcrumb__current">Kapitel {kap.nummer}</span>
  </nav>

  <!-- Header -->
  <div class="chap-kicker">KAPITEL {kap.nummer}</div>
  <h1 class="chap-title">{kap.titel}</h1>
  <p class="chap-blurb">{kap.blurb}</p>

  <!-- Meta row + progress -->
  <div class="chap-meta">
    <span class="chap-meta__text">{metaText}</span>
    <span class="chap-meta__dot" aria-hidden="true"></span>
    <div class="chap-meta__progress">
      <div class="chap-progress__track" aria-hidden="true">
        <div class="chap-progress__fill" data-chap-fill style="width:0%"></div>
      </div>
      <span class="chap-progress__label" data-chap-label>0 / {lessonCount} klara</span>
    </div>
  </div>

  <!-- Outcomes card -->
  <div class="outcomes-card">
    <div class="outcomes-card__kicker">DET HÄR LÄR DU DIG</div>
    <div class="outcomes-card__list">
      {kap.outcomes.map((o) => (
        <div class="outcome">
          <svg class="outcome__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--mint)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          <span class="outcome__text">{o}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Lesson list -->
  <div class="lessons-label">LEKTIONER I KAPITLET</div>
  <div class="chap-lessons">
    {kap.lektioner.map((l) =>
      l.status === 'klar' ? (
        <a
          class="chap-lesson"
          data-lesson-id={l.lektion}
          data-num={l.lektion}
          href={`/fokus/${l.lektion}`}
        >
          <span class="chap-lesson__mark" aria-hidden="true">
            <span class="chap-lesson__num">{l.lektion}</span>
            <svg class="chap-lesson__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>
          </span>
          <span class="chap-lesson__title">{l.titel}</span>
          <span class="chap-lesson__time">{l.tid_min} min</span>
          <span class="chap-lesson__cta" data-cta></span>
        </a>
      ) : (
        <div class="chap-lesson chap-lesson--locked" aria-label={`${l.titel} (kommande)`}>
          <span class="chap-lesson__mark chap-lesson__mark--locked" aria-hidden="true">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </span>
          <span class="chap-lesson__title">{l.titel}</span>
          <span class="chap-lesson__time">{l.tid_min} min</span>
          <span class="chap-lesson__cta">Kommande</span>
        </div>
      )
    )}
  </div>

  <!-- Chapter CTA -->
  <a class="chap-cta" data-chap-cta href={`/fokus/${chapterOrder[0]}`}>
    <div class="chap-cta__body">
      <div class="chap-cta__label" data-cta-label>Börja kapitlet</div>
      <div class="chap-cta__sub" data-cta-sub>Nästa: lektion {chapterOrder[0]}</div>
    </div>
    <span class="chap-cta__arrow" aria-hidden="true">→</span>
  </a>
</AppShell>

<style>
  @keyframes riseC {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: none; }
  }

  /* ---- Breadcrumb ---- */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 500;
    margin-bottom: 30px;
    color: var(--muted);
    animation: riseC 0.6s cubic-bezier(0.21, 0.7, 0.18, 1) both;
  }
  .breadcrumb__link {
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur-micro) var(--ease-standard);
  }
  .breadcrumb__link:hover { color: var(--text); }
  .breadcrumb__sep { color: var(--faint); }
  .breadcrumb__current { color: var(--text); }

  /* ---- Header ---- */
  .chap-kicker {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--mint);
    margin-bottom: 14px;
    animation: riseC 0.7s cubic-bezier(0.21, 0.7, 0.18, 1) both;
    animation-delay: 0.06s;
  }
  .chap-title {
    margin: 0 0 18px;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(34px, 4.4vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--text);
    animation: riseC 0.7s cubic-bezier(0.21, 0.7, 0.18, 1) both;
    animation-delay: 0.1s;
  }
  .chap-blurb {
    margin: 0 0 24px;
    max-width: 60ch;
    font-family: var(--serif);
    font-weight: 400;
    font-size: 18px;
    line-height: 1.65;
    color: var(--prose);
    animation: riseC 0.7s cubic-bezier(0.21, 0.7, 0.18, 1) both;
    animation-delay: 0.16s;
  }

  /* ---- Meta row ---- */
  .chap-meta {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    margin-bottom: 40px;
    animation: riseC 0.7s cubic-bezier(0.21, 0.7, 0.18, 1) both;
    animation-delay: 0.2s;
  }
  .chap-meta__text {
    font-family: var(--sans);
    font-weight: 500;
    font-size: 13px;
    color: var(--muted);
  }
  .chap-meta__dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--faint);
    flex: none;
  }
  .chap-meta__progress {
    display: flex;
    align-items: center;
    gap: 11px;
  }
  .chap-progress__track {
    width: 150px;
    height: 5px;
    border-radius: var(--radius-full);
    background: var(--surface-2);
    overflow: hidden;
  }
  .chap-progress__fill {
    height: 100%;
    background: var(--mint);
    border-radius: var(--radius-full);
    transition: width var(--dur-comp) var(--ease-out);
  }
  .chap-progress__label {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* ---- Outcomes card ---- */
  .outcomes-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 26px 28px;
    margin-bottom: 40px;
    animation: riseC 0.7s cubic-bezier(0.21, 0.7, 0.18, 1) both;
    animation-delay: 0.26s;
  }
  .outcomes-card__kicker {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 0.16em;
    color: var(--mint);
    margin-bottom: 18px;
  }
  .outcomes-card__list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .outcome {
    display: flex;
    align-items: flex-start;
    gap: 13px;
  }
  .outcome__icon {
    flex: none;
    margin-top: 2px;
  }
  .outcome__text {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 17px;
    line-height: 1.45;
    color: var(--text);
  }

  /* ---- Lesson list ---- */
  .lessons-label {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 0.16em;
    color: var(--muted);
    margin-bottom: 6px;
    animation: riseC 0.7s cubic-bezier(0.21, 0.7, 0.18, 1) both;
    animation-delay: 0.32s;
  }
  .chap-lessons {
    margin-bottom: 38px;
    animation: riseC 0.7s cubic-bezier(0.21, 0.7, 0.18, 1) both;
    animation-delay: 0.36s;
  }
  .chap-lesson {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 16px 8px;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    transition: background 0.15s var(--ease-standard);
  }
  .chap-lesson:last-child { border-bottom: none; }
  .chap-lesson:not(.chap-lesson--locked):hover {
    background: var(--mint-soft);
    text-decoration: none;
  }
  .chap-lesson--locked {
    opacity: 0.55;
    cursor: default;
  }

  /* Lesson marker: shows number, or check when done */
  .chap-lesson__mark {
    position: relative;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    border: 1.5px solid var(--faint);
    color: var(--muted);
    transition: background var(--dur-comp) var(--ease-out), border-color var(--dur-comp) var(--ease-out), color var(--dur-comp) var(--ease-out);
  }
  .chap-lesson__num {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 11px;
    transition: opacity var(--dur-comp) var(--ease-out);
  }
  .chap-lesson__check {
    position: absolute;
    width: 14px;
    height: 14px;
    opacity: 0;
    transition: opacity var(--dur-comp) var(--ease-out);
  }
  .chap-lesson__mark--locked {
    border-color: var(--faint);
    color: var(--muted);
  }
  /* "next" state */
  .chap-lesson[data-state='next'] .chap-lesson__mark {
    background: var(--mint-soft);
    border-color: transparent;
    color: var(--mint);
  }
  /* "done" state */
  .chap-lesson[data-state='done'] .chap-lesson__mark {
    background: var(--mint);
    border-color: var(--mint);
    color: var(--on-mint);
  }
  .chap-lesson[data-state='done'] .chap-lesson__num { opacity: 0; }
  .chap-lesson[data-state='done'] .chap-lesson__check { opacity: 1; }

  .chap-lesson__title {
    flex: 1;
    font-family: var(--serif);
    font-size: 18px;
    line-height: 1.35;
    color: var(--text);
  }
  .chap-lesson--locked .chap-lesson__title { color: var(--prose); }
  .chap-lesson__time {
    font-family: var(--sans);
    font-weight: 500;
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
    flex: none;
  }
  .chap-lesson__cta {
    font-family: var(--sans);
    font-weight: 500;
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
    flex: none;
    min-width: 54px;
    text-align: right;
  }
  .chap-lesson[data-state='next'] .chap-lesson__cta { color: var(--mint); }

  /* ---- Chapter CTA ---- */
  .chap-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-radius: 16px;
    padding: 20px 26px;
    background: var(--text);
    color: var(--bg);
    text-decoration: none;
    transition: transform 0.15s, box-shadow 0.18s;
    animation: riseC 0.7s cubic-bezier(0.21, 0.7, 0.18, 1) both;
    animation-delay: 0.42s;
  }
  .chap-cta:hover {
    text-decoration: none;
    box-shadow: var(--shadow-md);
  }
  .chap-cta:hover .chap-cta__arrow { transform: translateX(3px); }
  .chap-cta__label {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 15px;
  }
  .chap-cta__sub {
    font-family: var(--sans);
    font-weight: 500;
    font-size: 12.5px;
    opacity: 0.7;
    margin-top: 3px;
  }
  .chap-cta__arrow {
    font-size: 20px;
    flex: none;
    transition: transform 0.15s;
  }

  /* ---- Mobile ---- */
  @media (max-width: 640px) {
    .chap-lesson { gap: 12px; padding: 14px 4px; }
    .chap-lesson__title { font-size: 16px; }
    .outcomes-card { padding: 20px 18px; }
  }
</style>

<script>
  import { getFokusDone, FOKUS_EVENT } from '../../../scripts/fokus-progress';

  function paint() {
    const orderEl = document.querySelector('[data-chapter-order]');
    if (!orderEl) return;
    const order = JSON.parse(orderEl.textContent || '[]') as string[];
    const done = new Set(getFokusDone());

    // Per-lesson state: done | next | (default). First non-done klar lesson = next.
    const rows = document.querySelectorAll<HTMLElement>('.chap-lesson[data-lesson-id]');
    let doneCount = 0;
    let nextAssigned = false;
    let nextId: string | null = null;

    rows.forEach((row) => {
      const id = row.dataset.lessonId || '';
      const ctaEl = row.querySelector<HTMLElement>('[data-cta]');
      if (done.has(id)) {
        row.dataset.state = 'done';
        doneCount++;
        if (ctaEl) ctaEl.textContent = 'Repetera';
      } else if (!nextAssigned) {
        row.dataset.state = 'next';
        nextAssigned = true;
        nextId = id;
        if (ctaEl) ctaEl.textContent = 'Börja →';
      } else {
        row.dataset.state = 'todo';
        if (ctaEl) ctaEl.textContent = '';
      }
    });

    const total = order.length;
    const pct = total ? Math.round((doneCount / total) * 100) : 0;

    const fill = document.querySelector<HTMLElement>('[data-chap-fill]');
    if (fill) fill.style.width = pct + '%';
    const label = document.querySelector<HTMLElement>('[data-chap-label]');
    if (label) label.textContent = `${doneCount} / ${total} klara`;

    // CTA: continue to next incomplete lesson, or first if all done
    const cta = document.querySelector<HTMLAnchorElement>('[data-chap-cta]');
    const ctaLabel = document.querySelector<HTMLElement>('[data-cta-label]');
    const ctaSub = document.querySelector<HTMLElement>('[data-cta-sub]');
    const target = nextId ?? order[0] ?? null;
    if (cta && target) cta.href = `/fokus/${target}`;
    if (ctaLabel) ctaLabel.textContent = doneCount > 0 ? 'Fortsätt kapitlet' : 'Börja kapitlet';
    if (ctaSub) {
      ctaSub.textContent =
        doneCount >= total ? 'Du har klarat kapitlet — repetera valfri lektion' : `Nästa: lektion ${target}`;
    }
  }

  document.addEventListener('astro:page-load', paint);
  window.addEventListener(FOKUS_EVENT, paint);
</script>
