---
import AppShell from '../layouts/AppShell.astro';
import { getCourseTree, getModulesInOrder, lessonHref, readingTime, getLessonsInOrder } from '../lib/course';

const tree = await getCourseTree();
const modules = await getModulesInOrder();
const allLessons = await getLessonsInOrder();
const totalLessons = allLessons.length;

// Compute total reading time per module (minutes)
function moduleTotalTime(lessons: typeof allLessons): number {
  return lessons.reduce((sum, l) => sum + readingTime(l.body), 0);
}

function formatTime(mins: number): string {
  if (mins < 60) return `${mins} min`;
  const h = Math.floor(mins / 60);
  const m = mins % 60;
  return m > 0 ? `${h} h ${m} min` : `${h} h`;
}
---

<AppShell title="Kursöversikt" active="kurs" maxWidth={880}>
  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Brödsmula">
    <a href="/hem" class="breadcrumb__link">Hem</a>
    <span class="breadcrumb__sep" aria-hidden="true">›</span>
    <span class="breadcrumb__current">Kursöversikt</span>
  </nav>

  <!-- Course title + ingress -->
  <div class="course-header">
    <h1 class="course-title">Fundamental aktieanalys</h1>
    <p class="course-ingress">
      Tre delar som bygger omdömet steg för steg — från vad en aktie faktiskt är
      till hur du sätter ett värde på ett företag och fattar välgrundade beslut.
    </p>
  </div>

  <!-- Total progress bar -->
  <div class="progress-row">
    <div class="progress-track">
      <div class="progress-fill" data-total-fill style="width:0%"></div>
    </div>
    <span class="progress-label">
      <span data-total-count>0/{totalLessons} lektioner</span>
      <span class="progress-pct" data-total-pct>0%</span>
    </span>
  </div>

  <!-- Chapter timeline -->
  <div class="timeline">
    <div class="timeline__line" aria-hidden="true"></div>

    {tree.map((del) =>
      del.modules.map((mod) => {
        const modKey = String(mod.modul);
        const totalMins = moduleTotalTime(mod.lessons);
        const lessonCount = mod.lessons.length;
        return (
          <div class="chapter" data-module-key={modKey}>
            <!-- Node -->
            <div class="chapter__node" aria-hidden="true">
              <span class="node-inner">{mod.modul}</span>
            </div>

            <!-- Card -->
            <div class="chapter__card">
              <div class="chapter__card-head">
                <div class="chapter__meta-col">
                  <div class="chapter__kicker">
                    KAPITEL {mod.modul} · {del.del}
                  </div>
                  <div class="chapter__title">{mod.modulTitel}</div>
                  <div class="chapter__sub">
                    {lessonCount} lektion{lessonCount !== 1 ? 'er' : ''} · {formatTime(totalMins)}
                  </div>
                </div>
                <span class="chapter__lock" aria-label="Låst kapitel">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                  </svg>
                </span>
              </div>

              <!-- Lesson list -->
              <div class="lesson-list">
                {mod.lessons.map((lesson) => {
                  const mins = readingTime(lesson.body);
                  const d = lesson.data;
                  return (
                    <a
                      class="lesson-row"
                      href={lessonHref(lesson)}
                      data-lesson-id={lesson.id}
                      data-module-key={modKey}
                      data-astro-prefetch
                    >
                      <span class="status" aria-hidden="true"></span>
                      <span class="lesson-row__num">{d.lektion}</span>
                      <span class="lesson-row__title">{d.titel}</span>
                      <span class="lesson-row__time">{mins} min</span>
                    </a>
                  );
                })}
              </div>
            </div>
          </div>
        );
      })
    )}
  </div>

  <!-- Gating data for client -->
  <script type="application/json" data-gate-modules set:html={JSON.stringify(modules.map(m => ({ key: m.key, lessonIds: m.lessonIds })))}></script>
</AppShell>

<style>
  /* ---- Breadcrumb ---- */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 500;
    margin-bottom: 28px;
    color: var(--muted);
  }
  .breadcrumb__link {
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur-micro) var(--ease-standard);
  }
  .breadcrumb__link:hover {
    color: var(--text);
    text-decoration: none;
  }
  .breadcrumb__sep {
    color: var(--faint);
  }
  .breadcrumb__current {
    color: var(--text);
  }

  /* ---- Course header ---- */
  .course-header {
    margin-bottom: 14px;
  }
  .course-title {
    margin: 0 0 12px;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(32px, 4vw, 46px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .course-ingress {
    margin: 0 0 14px;
    max-width: 54ch;
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.6;
    color: var(--prose);
  }

  /* ---- Progress row ---- */
  .progress-row {
    display: flex;
    align-items: center;
    gap: 13px;
    max-width: 420px;
    margin-bottom: 48px;
  }
  .progress-track {
    flex: 1;
    height: 5px;
    border-radius: var(--radius-full);
    background: var(--surface-2);
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    background: var(--mint);
    border-radius: var(--radius-full);
    transition: width 0.6s cubic-bezier(0.21, 0.7, 0.18, 1);
  }
  .progress-label {
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
  }
  .progress-pct {
    color: var(--mint);
    font-weight: 600;
  }

  /* ---- Timeline ---- */
  .timeline {
    position: relative;
    padding-left: 44px;
  }
  .timeline__line {
    position: absolute;
    left: 11px;
    top: 12px;
    bottom: 12px;
    width: 1px;
    background: var(--border);
  }

  /* ---- Chapter ---- */
  .chapter {
    position: relative;
    margin-bottom: 28px;
    transition: opacity 0.25s ease;
  }

  /* Node */
  .chapter__node {
    position: absolute;
    left: -44px;
    top: 20px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--surface-2);
    border: 1px solid var(--border-2);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }
  .node-inner {
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 600;
    color: var(--muted);
    line-height: 1;
    transition: color 0.2s ease;
  }

  /* Card */
  .chapter__card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 22px 24px 6px;
    transition:
      border-color 0.2s ease,
      opacity 0.2s ease;
  }
  .chapter__card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 16px;
  }
  .chapter__meta-col {
    flex: 1;
  }
  .chapter__kicker {
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 7px;
  }
  .chapter__title {
    font-family: var(--serif);
    font-weight: 300;
    font-size: 26px;
    line-height: 1.1;
    color: var(--text);
    letter-spacing: -0.01em;
    margin-bottom: 9px;
  }
  .chapter__sub {
    font-family: var(--sans);
    font-size: 12.5px;
    font-weight: 500;
    color: var(--muted);
  }

  /* Lock icon (hidden by default, shown when locked) */
  .chapter__lock {
    color: var(--muted);
    opacity: 0;
    flex-shrink: 0;
    transition: opacity 0.2s ease;
  }

  /* Lesson list */
  .lesson-list {
    border-top: 1px solid var(--border);
    padding-top: 4px;
    padding-bottom: 8px;
  }
  .lesson-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 6px;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    text-decoration: none;
    cursor: pointer;
    transition:
      background 0.15s ease,
      opacity 0.15s ease;
    border-radius: 4px;
  }
  .lesson-row:last-child {
    border-bottom: none;
  }
  .lesson-row:hover {
    background: var(--mint-soft);
    text-decoration: none;
  }
  /* Status marker */
  .status {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1.5px solid var(--faint);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }
  .lesson-row__num {
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 600;
    color: var(--muted);
    white-space: nowrap;
    min-width: 28px;
  }
  .lesson-row__title {
    flex: 1;
    font-family: var(--serif);
    font-size: 16px;
    line-height: 1.35;
    color: var(--text);
  }
  .lesson-row__time {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
    white-space: nowrap;
  }

  /* ---- State: locked module ---- */
  [data-module-key][data-state="locked"] {
    opacity: 0.55;
  }
  [data-module-key][data-state="locked"] .chapter__lock {
    opacity: 1;
  }
  [data-module-key][data-state="locked"] .chapter__kicker {
    color: var(--muted);
  }

  /* ---- State: done module — node gets mint ---- */
  [data-module-key][data-state="done"] .chapter__node {
    background: var(--mint);
    border-color: var(--mint);
  }
  [data-module-key][data-state="done"] .node-inner {
    color: var(--on-mint);
  }
  [data-module-key][data-state="done"] .chapter__card {
    border-color: var(--border-2);
  }

  /* ---- State: active/unlocked module ---- */
  [data-module-key][data-state="active"] .chapter__node,
  [data-module-key][data-state="unlocked"] .chapter__node {
    background: var(--mint-soft);
    border-color: var(--mint);
  }
  [data-module-key][data-state="active"] .node-inner,
  [data-module-key][data-state="unlocked"] .node-inner {
    color: var(--mint);
  }
  [data-module-key][data-state="active"] .chapter__card,
  [data-module-key][data-state="unlocked"] .chapter__card {
    border-color: var(--border-2);
  }
  [data-module-key][data-state="active"] .chapter__kicker,
  [data-module-key][data-state="unlocked"] .chapter__kicker {
    color: var(--mint);
  }

  /* ---- Lesson done state ---- */
  [data-lesson-id][data-done="1"] .status {
    background: var(--mint);
    border-color: var(--mint);
  }
  [data-lesson-id][data-done="1"] .status::after {
    content: '';
    display: block;
    width: 6px;
    height: 4px;
    border-left: 1.5px solid var(--on-mint);
    border-bottom: 1.5px solid var(--on-mint);
    transform: rotate(-45deg) translateY(-1px);
  }

  /* ---- Lesson locked state ---- */
  [data-lesson-id][data-locked="1"] {
    cursor: default;
    opacity: 0.6;
    pointer-events: none;
  }
  [data-lesson-id][data-locked="1"]:hover {
    background: transparent;
  }
  [data-lesson-id][data-locked="1"] .lesson-row__title {
    color: var(--prose);
  }

  /* ---- Mobile ---- */
  @media (max-width: 760px) {
    .timeline {
      padding-left: 36px;
    }
    .chapter__node {
      left: -36px;
      top: 18px;
    }
    .chapter__card {
      padding: 16px 16px 4px;
    }
    .chapter__title {
      font-size: 22px;
    }
    .lesson-row__title {
      font-size: 15px;
    }
    .progress-row {
      max-width: 100%;
    }
  }
</style>

<script>
  import { getAll, PROGRESS_EVENT } from '../scripts/progress';
  import { computeGate, isDevUnlocked, META_EVENT } from '../scripts/state';

  function paint() {
    const el = document.querySelector('[data-gate-modules]');
    if (!el) return;
    const modules = JSON.parse(el.textContent || '[]');
    const store = getAll();
    const doneIds = Object.keys(store).filter((id) => store[id]?.done);
    const gate = computeGate(modules, doneIds, isDevUnlocked());
    const statusByKey: Record<string, string> = {};
    gate.forEach((g) => { statusByKey[g.key] = g.status; });

    // modules
    document.querySelectorAll<HTMLElement>('[data-module-key]').forEach((card) => {
      card.dataset.state = statusByKey[card.dataset.moduleKey!] || 'locked';
    });

    // lessons
    let total = 0, done = 0;
    document.querySelectorAll<HTMLAnchorElement>('[data-lesson-id]').forEach((a) => {
      total++;
      const id = a.dataset.lessonId!;
      const isDone = Boolean(store[id]?.done);
      if (isDone) done++;
      a.dataset.done = isDone ? '1' : '0';
      const locked = statusByKey[a.dataset.moduleKey!] === 'locked';
      a.dataset.locked = locked ? '1' : '0';
      if (locked) a.setAttribute('aria-disabled', 'true'); else a.removeAttribute('aria-disabled');
    });

    const pct = total ? Math.round((done / total) * 100) : 0;
    const fill = document.querySelector<HTMLElement>('[data-total-fill]');
    const pctEl = document.querySelector<HTMLElement>('[data-total-pct]');
    const cntEl = document.querySelector<HTMLElement>('[data-total-count]');
    if (fill) fill.style.width = pct + '%';
    if (pctEl) pctEl.textContent = pct + '%';
    if (cntEl) cntEl.textContent = `${done}/${total} lektioner`;
  }

  // Block navigation on locked lessons
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-lesson-id]');
    if (a && a.dataset.locked === '1') { e.preventDefault(); }
  }, true);

  document.addEventListener('astro:page-load', paint);
  window.addEventListener(PROGRESS_EVENT, paint);
  window.addEventListener(META_EVENT, paint);
</script>
