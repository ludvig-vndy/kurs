---
import LessonLayout from '../layouts/LessonLayout.astro';
import { getCourseTree, getLessonsInOrder, lessonHref } from '../lib/course';

const tree = await getCourseTree();
const lessons = await getLessonsInOrder();
const first = lessons[0];
const totalLessons = lessons.length;
---

<LessonLayout title="Kursöversikt">
  <div class="home">
    <header class="hero" data-reveal>
      <span class="hero__eyebrow">Onlinekurs</span>
      <h1 class="hero__title">Fundamental aktieanalys</h1>
      <p class="hero__lede">
        Lär dig att värdera bolag och tänka som en ägare — från grunderna till
        avancerad analys. {totalLessons} lektioner, i din egen takt.
      </p>
      <div class="hero__actions">
        {
          first && (
            <a class="cta" href={lessonHref(first)} data-start-link data-astro-prefetch>
              <span data-start-label>Börja kursen</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
            </a>
          )
        }
        <span class="hero__progress" data-home-progress hidden>
          <span data-home-pct>0%</span> klart
        </span>
      </div>
    </header>

    <div class="overview">
      {
        tree.map((del) => (
          <section class="del-block" data-reveal>
            <h2 class="del-block__title">{del.del}</h2>
            <div class="modules">
              {del.modules.map((mod) => {
                const ids = mod.lessons.map((l) => l.id);
                return (
                  <a class="mcard" href={lessonHref(mod.lessons[0])} data-astro-prefetch>
                    <div class="mcard__head">
                      <span class="mcard__num">Modul {mod.modul}</span>
                      <span
                        class="mcard__count"
                        data-module-ids={ids.join(',')}
                      >
                        0/{ids.length}
                      </span>
                    </div>
                    <h3 class="mcard__title">{mod.modulTitel}</h3>
                    <div class="mcard__track">
                      <div class="mcard__fill" data-module-fill={ids.join(',')} style="width:0%" />
                    </div>
                  </a>
                );
              })}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</LessonLayout>

<style>
  .home {
    max-width: 820px;
    margin: 0 auto;
  }
  .hero {
    padding: var(--space-7) 0 var(--space-8);
    border-bottom: 1px solid var(--border);
    margin-bottom: var(--space-8);
  }
  .hero__eyebrow {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  .hero__title {
    font-size: var(--text-3xl);
    line-height: 1.08;
    margin: var(--space-3) 0 var(--space-4);
    max-width: 14ch;
  }
  .hero__lede {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--text-muted);
    max-width: 56ch;
    margin: 0 0 var(--space-6);
  }
  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    background: var(--accent);
    color: var(--accent-contrast);
    font-family: var(--font-sans);
    font-weight: 600;
    border-radius: var(--radius-full);
    transition:
      background var(--dur-micro) var(--ease-standard),
      transform var(--dur-comp) var(--ease-out);
  }
  .cta:hover {
    background: var(--accent-hover);
    text-decoration: none;
    transform: translateY(-1px);
  }
  .cta svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .hero__progress {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .hero__progress span {
    color: var(--accent);
    font-weight: 600;
  }

  .del-block {
    margin-bottom: var(--space-8);
  }
  .del-block__title {
    font-size: var(--text-xl);
    margin: 0 0 var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border);
  }
  .modules {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: var(--space-4);
  }
  .mcard {
    display: block;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-elev);
    color: var(--text);
    transition:
      border-color var(--dur-micro) var(--ease-standard),
      transform var(--dur-comp) var(--ease-out),
      box-shadow var(--dur-comp) var(--ease-out);
  }
  .mcard:hover {
    text-decoration: none;
    border-color: var(--accent-line);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .mcard__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
  }
  .mcard__num {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-faint);
    font-weight: 600;
  }
  .mcard__count {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
  .mcard__count[data-complete='true'] {
    color: var(--accent);
  }
  .mcard__title {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 var(--space-4);
  }
  .mcard__track {
    height: 4px;
    background: var(--surface-2);
    border-radius: var(--radius-full);
    overflow: hidden;
  }
  .mcard__fill {
    height: 100%;
    background: var(--accent);
    border-radius: var(--radius-full);
    transition: width var(--dur-comp) var(--ease-out);
  }
</style>

<script>
  import { getAll, PROGRESS_EVENT } from '../scripts/progress';

  function paintHome() {
    const store = getAll();

    // Modulkort: count + fyllnad
    document.querySelectorAll<HTMLElement>('.mcard__count[data-module-ids]').forEach((el) => {
      const ids = (el.dataset.moduleIds || '').split(',').filter(Boolean);
      const done = ids.filter((id) => store[id]?.done).length;
      el.textContent = `${done}/${ids.length}`;
      el.dataset.complete = String(done === ids.length && ids.length > 0);
      const fill = document.querySelector<HTMLElement>(
        `[data-module-fill="${el.dataset.moduleIds}"]`
      );
      if (fill) fill.style.width = (ids.length ? (done / ids.length) * 100 : 0) + '%';
    });

    // Total
    const all = Array.from(document.querySelectorAll<HTMLElement>('.mcard__count[data-module-ids]'))
      .flatMap((el) => (el.dataset.moduleIds || '').split(',').filter(Boolean));
    const uniq = [...new Set(all)];
    const done = uniq.filter((id) => store[id]?.done).length;
    const pct = uniq.length ? Math.round((done / uniq.length) * 100) : 0;

    const wrap = document.querySelector<HTMLElement>('[data-home-progress]');
    const pctEl = document.querySelector<HTMLElement>('[data-home-pct]');
    if (wrap && pctEl && done > 0) {
      wrap.hidden = false;
      pctEl.textContent = pct + '%';
    }
  }

  document.addEventListener('astro:page-load', paintHome);
  window.addEventListener(PROGRESS_EVENT, paintHome);
</script>
