---
import Broadsheet from '../layouts/Broadsheet.astro';
import Seal from '../components/Seal.astro';

// Landningen: redaktionell forstasida ("Laroplanen"). Hero + vad du lar dig
// (de 5 delarna med representativa kapitelbilder) + verktygen som ingar.
// Mastheaden ar gomd (chrome=none); sigillet bar identiteten i heron.

const delar = [
  { n: 'I',   titel: 'Grunderna',      kap: 'Kapitel 0–2',   img: '/bilder/kapitel-1.jpg',  lar: 'Vad en aktie är, en filosofi att stå på, och hur bolag tjänar pengar.' },
  { n: 'II',  titel: 'Förstå bolaget', kap: 'Kapitel 3–7',   img: '/bilder/kapitel-4.jpg',  lar: 'Läsa årsredovisningen, nyckeltalen, och vad som skyddar vinsten.' },
  { n: 'III', titel: 'Värdering',      kap: 'Kapitel 8–10',  img: '/bilder/kapitel-8.jpg',  lar: 'Sätta ett eget riktpris, med marginal att tåla att ha fel.' },
  { n: 'IV',  titel: 'I praktiken',    kap: 'Kapitel 11–16', img: '/bilder/kapitel-11.jpg', lar: 'Psykologin, ett skarpt case, och din checklista före köp.' },
  { n: 'V',   titel: 'Fördjupning',    kap: 'Kapitel 17–18', img: '/bilder/kapitel-18.jpg', lar: 'Att äga med öppna ögon, och säkra avkastningen när det gått bra.' },
];

const verktyg = [
  { t: 'Din bevakning',   d: 'Innehaven lästa varje natt.',               href: '/labs/dina-bolag-i-marginalen.html' },
  { t: 'Rapporterna',     d: 'Tolkade, varje siffra spårad till källan.',  href: '/labs/rapportkollen-i-marginalen.html' },
  { t: 'Svar med källa',  d: 'Fråga om dina bolag, få svar direkt.',       href: '/labs/fraga-i-marginalen.html' },
  { t: 'Analysverktygen', d: 'Checklistan du går igenom före ett köp.',    href: '/verktyg' },
];
---

<Broadsheet
  title="Delägaren: analysera aktier som en ägare"
  description="Inbjudningsstyrd onlinekurs i fundamental aktieanalys. Sjutton kapitel i fem delar, plus tjänsten som håller koll på ditt innehav och hjälper dig analysera vidare."
  nav="none"
  chrome="none"
>
  <script is:inline>
    try { if (localStorage.getItem('sb-xpxghvxrckpzbbkjmtcw-auth-token')) location.replace('/hem'); } catch (e) {}
  </script>

  <main class="lp">
    <div class="wrap lp-top">
      <a class="lp-login" href="/logga-in">Logga in</a>
    </div>

    <div class="wrap lp-mast">
      <Seal size="lg" href="/" />
      <div class="kicker">Onlinekurs i fundamental analys, plus verktygen · inbjudan krävs</div>
    </div>

    <!-- Två heroes: kursen (oxblod) och Ägarbrevet (skogsgrön), var sin USP -->
    <section class="wrap lp-heroes">
      <a class="lp-hero2 lp-hero2--kurs" href="/fokus">
        <div class="lp-hero2__k">Kursen</div>
        <h1 class="lp-hero2__h">Lär dig analysera aktier som en ägare, inte en spekulant.</h1>
        <p class="lp-hero2__p">En kurs i fundamental analys, sjutton kapitel i lugn takt. Du lär dig läsa ett bolag, värdera det själv och sätta ett riktpris du kan lita på.</p>
        <span class="lp-hero2__cta">Börja kursen →</span>
      </a>
      <a class="lp-hero2 lp-hero2--brev" href="/labs/agarbrevet-i-marginalen.html">
        <div class="lp-hero2__k">Ägarbrevet</div>
        <h1 class="lp-hero2__h">Håll koll på ditt innehav, utan att missa det som betyder något.</h1>
        <p class="lp-hero2__p">Delägaren följer dina bolag, läser rapporterna åt dig och säger till när något ändrats. Du kan fråga om innehaven och få svar med källa, och gå igenom analysen innan du bestämmer dig.</p>
        <span class="lp-hero2__cta">Till Ägarbrevet →</span>
      </a>
    </section>

    <div class="wrap lp-stats">
      <span><b>19</b> kapitel</span><span class="lp-dot" aria-hidden="true">·</span>
      <span><b>5</b> delar</span><span class="lp-dot" aria-hidden="true">·</span>
      <span>verktygen ingår</span>
      <a class="lp-stats__cta link-mono" href="/labs/inbjudan-i-marginalen.html">Har du en inbjudan? →</a>
    </div>

    <!-- Läroplan + verktyg -->
    <section class="wrap lp-body">
      <div class="lp-learn">
        <h2 class="lp-h">Detta lär du dig</h2>
        <ol class="lp-delar">
          {delar.map((d) => (
            <li class="lp-del">
              <a class="lp-del__fig" href="/fokus" aria-hidden="true" tabindex="-1">
                <img src={d.img} alt="" loading="lazy" width="120" height="96" />
              </a>
              <div class="lp-del__body">
                <div class="lp-del__head">
                  <span class="lp-del__n">Del {d.n}</span>
                  <h3 class="lp-del__t">{d.titel}</h3>
                  <span class="lp-del__kap">{d.kap}</span>
                </div>
                <p class="lp-del__sub">{d.lar}</p>
              </div>
            </li>
          ))}
        </ol>
        <a class="lp-learn__all link-mono" href="/fokus">Se hela kursöversikten →</a>
      </div>

      <aside class="lp-tools">
        <h2 class="lp-h">Verktygen ingår</h2>
        <p class="lp-tools__intro">Kursen lär dig omdömet. Verktygen finns där när du ska använda det, på riktiga bolag.</p>
        <ul class="lp-tools__list">
          {verktyg.map((v) => (
            <li>
              <a class="lp-tool" href={v.href}>
                <span class="lp-tool__t">{v.t}</span>
                <span class="lp-tool__d">{v.d}</span>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    </section>

    <!-- CTA-band -->
    <section class="lp-cta">
      <div class="lp-cta__in">
        <div>
          <div class="lp-cta__k">Börja idag</div>
          <div class="lp-cta__h">Första lektionen tar åtta minuter.</div>
        </div>
        <a class="btn-ink" href="/fokus">Kom igång →</a>
      </div>
      <div class="lp-cta__credit">Börshuset, Stockholm · foto: Jorge Láscar (CC BY 2.0)</div>
    </section>

    <div class="wrap lp-foot">
      <p class="lp-fine">Delägaren, fundamental aktieanalys. I utbildningssyfte, inte finansiell rådgivning.</p>
    </div>
  </main>
</Broadsheet>

<style>
  .lp { flex: 1; display: flex; flex-direction: column; }
  .lp-top { display: flex; justify-content: flex-end; align-items: center; padding: 22px 0 0; }
  .lp-login { font-family: var(--mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-soft); text-decoration: none; min-height: 40px; display: inline-flex; align-items: center; }
  .lp-login:hover { color: var(--oxblood); }

  /* Sigill + kicker, centrerat ovanfor de tva heroerna */
  .lp-mast { text-align: center; padding: clamp(20px,4vh,44px) 0 clamp(20px,3vh,32px); }
  .lp-mast .seal { margin: 0 auto; }
  .lp-mast .kicker { margin-top: 16px; }

  /* Tva heroes: kursen (oxblod) + Agarbrevet (skogsgron), farg-dranks */
  .lp-heroes { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .lp-hero2 { position: relative; overflow: hidden; isolation: isolate; text-decoration: none;
    display: flex; flex-direction: column; padding: clamp(26px,3.4vw,44px); min-height: 320px; color: var(--paper);
    transition: transform .25s cubic-bezier(.2,.7,.2,1); }
  .lp-hero2:hover { transform: translateY(-3px); }
  .lp-hero2--kurs { background: linear-gradient(rgba(122,38,30,.90), rgba(96,28,22,.95)), url('/bilder/borshuset-1600.jpg') center 34% / cover; }
  .lp-hero2--brev { background: linear-gradient(rgba(30,58,48,.90), rgba(18,42,34,.95)), url('/bilder/kapitel-16.jpg') center / cover; }
  .lp-hero2__k { font-family: var(--mono); font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: rgba(246,244,239,.82); margin-bottom: 16px; }
  .lp-hero2__h { font-family: var(--slab); font-weight: 600; font-size: clamp(21px,2.3vw,29px); line-height: 1.14; letter-spacing: -.005em; margin: 0; text-wrap: balance; }
  .lp-hero2__p { font-family: var(--serif); font-size: 15.5px; line-height: 1.5; color: rgba(246,244,239,.86); margin: 14px 0 0; max-width: 42ch; }
  .lp-hero2__cta { margin-top: auto; padding-top: 24px; font-family: var(--mono); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--paper); }
  .lp-hero2:hover .lp-hero2__cta { text-decoration: underline; text-underline-offset: 3px; }

  .lp-stats { margin-top: 18px; display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; font-family: var(--mono); font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .lp-stats b { font-family: var(--display); font-weight: 500; font-size: 17px; color: var(--ink); }
  .lp-stats__cta { margin-left: auto; color: var(--oxblood); }
  .lp-dot { color: var(--faint); }

  /* Läroplan + verktyg */
  .lp-body { display: grid; grid-template-columns: 1.5fr .9fr; gap: clamp(28px,4vw,56px); padding: 6px 0 8px; align-items: start; border-top: 2px solid var(--rule-strong); margin-top: 4px; padding-top: 34px; }
  .lp-h { font-family: var(--mono); font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--oxblood); margin: 0 0 18px; }

  .lp-delar { list-style: none; margin: 0; padding: 0; }
  .lp-del { display: grid; grid-template-columns: 120px 1fr; gap: 20px; padding: 20px 0; border-top: 1px solid var(--rule); align-items: start; }
  .lp-del:first-child { border-top: 0; padding-top: 0; }
  .lp-del__fig { display: block; border: 1px solid var(--rule); background: var(--card); padding: 5px; align-self: start; }
  .lp-del__fig img { display: block; width: 100%; height: auto; aspect-ratio: 5/4; object-fit: cover; filter: grayscale(1) contrast(1.02); }
  .lp-del__head { display: flex; align-items: baseline; gap: 10px 14px; flex-wrap: wrap; }
  .lp-del__n { font-family: var(--mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .lp-del__t { font-family: var(--slab); font-weight: 600; font-size: 22px; letter-spacing: -.005em; margin: 0; color: var(--ink); }
  .lp-del__kap { font-family: var(--mono); font-size: 10.5px; letter-spacing: .06em; text-transform: uppercase; color: var(--faint); margin-left: auto; }
  .lp-del__sub { font-family: var(--serif); font-size: 16px; line-height: 1.5; color: var(--ink-soft); margin: 8px 0 0; }
  .lp-learn__all { display: inline-block; margin-top: 22px; color: var(--oxblood); }

  /* Verktygsrail */
  /* Verktygsrailen tillhor Agarbrevet-varlden: skogsgron accent. */
  .lp-tools { border: 1px solid var(--rule-strong); border-top: 2px solid #2C5646; background: var(--card); padding: 22px 24px 12px; position: sticky; top: 20px; }
  .lp-tools .lp-h { color: #2C5646; }
  .lp-tools__intro { font-family: var(--serif); font-size: 15px; line-height: 1.5; color: var(--ink-soft); margin: 0 0 18px; }
  .lp-tools__list { list-style: none; margin: 0; padding: 0; }
  .lp-tools__list li { border-top: 1px solid var(--rule); }
  .lp-tool { display: block; padding: 14px 0; text-decoration: none; }
  .lp-tool__t { display: block; font-family: var(--display); font-weight: 500; font-size: 16px; color: var(--ink); }
  .lp-tool__d { display: block; font-family: var(--serif); font-size: 14px; line-height: 1.4; color: var(--muted); margin-top: 3px; }
  .lp-tool:hover .lp-tool__t { color: #2C5646; }
  .lp-tool:hover .lp-tool__d { color: var(--ink-soft); }

  /* CTA-band, samma fotografi dränkt i oxblod */
  .lp-cta { position: relative; left: 50%; width: 100vw; margin-left: -50vw; margin-top: clamp(40px,6vw,68px);
    padding: clamp(38px,6vw,64px) 0 16px; color: var(--paper);
    background: linear-gradient(rgba(122,38,30,.90), rgba(96,28,22,.93)), url('/bilder/borshuset-1600.jpg') center 40% / cover; }
  .lp-cta__in { max-width: var(--maxw,1080px); margin: 0 auto; padding: 0 clamp(20px,5vw,52px); display: flex; align-items: center; justify-content: space-between; gap: 28px; flex-wrap: wrap; }
  .lp-cta__k { font-family: var(--mono); font-size: 11px; letter-spacing: .13em; text-transform: uppercase; color: rgba(246,244,239,.75); margin-bottom: 8px; }
  .lp-cta__h { font-family: var(--slab); font-weight: 500; font-size: clamp(22px,2.6vw,30px); letter-spacing: -.005em; }
  .lp-cta .btn-ink { background: var(--paper); color: var(--ink); }
  .lp-cta .btn-ink:hover { background: var(--paper-2); color: var(--oxblood); transform: translateX(3px); }
  .lp-cta__credit { max-width: var(--maxw,1080px); margin: 24px auto 0; padding: 10px clamp(20px,5vw,52px) 0; border-top: 1px solid rgba(246,244,239,.22); font-family: var(--mono); font-size: 10px; letter-spacing: .05em; color: rgba(246,244,239,.6); }

  .lp-foot { padding: 20px 0 36px; border-top: 1px solid var(--rule); }
  .lp-fine { font-family: var(--mono); font-size: 10.5px; letter-spacing: .04em; color: var(--faint); }

  @media (max-width: 720px) {
    .lp-heroes { grid-template-columns: 1fr; }
    .lp-hero2 { min-height: 0; }
  }
  @media (max-width: 860px) {
    .lp-body { grid-template-columns: 1fr; gap: 34px; }
    .lp-tools { position: static; }
  }
  @media (max-width: 520px) {
    .lp-del { grid-template-columns: 84px 1fr; gap: 14px; }
    .lp-del__kap { margin-left: 0; }
  }
</style>
