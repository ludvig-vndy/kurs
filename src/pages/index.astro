---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCourseTree } from '../lib/course';

const firstHref = '/fokus/1.1';

const tree = await getCourseTree();
const dels = tree.map((d) => ({
  del: d.del,
  lessons: d.modules.reduce((n, m) => n + m.lessons.length, 0),
  modules: d.modules.length,
}));

// Säljsektionen ramar in kursen som tre kapitel (matchar startside-designen).
// Varje kapitel grupperar några av kursens delar; lektionsantalet räknas ur datan.
const delLessons = Object.fromEntries(dels.map((d) => [d.del, d.lessons]));
const chapterDefs = [
  {
    title: 'Forstå och räkna på bolaget',
    tagline: 'Affärsmodellen, årsredovisningen och hur de tre rapporterna hänger ihop.',
    dels: ['Grunden', 'Räkenskaperna'],
  },
  {
    title: 'Bedöm kvalitet och värde',
    tagline: 'Lönsamhet, vallgravar, ledning och vad ett bolag faktiskt är värt.',
    dels: ['Analys av kvalitet', 'Värdering'],
  },
  {
    title: 'Besluta som ägare',
    tagline: 'Psykologi, risk, fallstudier och din egen process hela vägen fram till köp.',
    dels: ['Psykologi', 'Avancerat', 'Capstone', 'Att hitta framtidens vinnare', 'Fallstudie', 'Sektoranalys', 'Praktik'],
  },
];
const chapters = chapterDefs.map((c) => ({
  title: c.title,
  tagline: c.tagline,
  lessons: c.dels.reduce((n, name) => n + (delLessons[name] || 0), 0),
}));
---

<BaseLayout title="Ägarboken: Lär dig analysera aktier som en ägare" description="Fundamental aktieanalys, från grunden. Korta lektioner, riktiga övningar och ett analysverktyg du faktiskt använder före varje köp.">

  <!-- ===================== TOPBAR ===================== -->
  <header class="topbar" id="topbar">
    <div class="topbar__inner">
      <a href="/" class="topbar__brand" aria-label="Ägarboken startsida">
        <span class="brand-mark" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect width="24" height="24" rx="5" fill="var(--mint)" />
            <path d="M7 17V10l5-3 5 3v7" stroke="var(--on-mint)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M10 17v-4h4v4" stroke="var(--on-mint)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        <span class="brand-name">Ägarboken</span>
      </a>
      <nav class="topbar__nav">
        <a href="/hem" class="topbar__login">Logga in</a>
        <a href="/hem" class="topbar__cta">Till plattformen</a>
      </nav>
    </div>
  </header>

  <main class="landing">

    <!-- ===================== HERO ===================== -->
    <section class="hero">
      <div class="hero__inner">
        <div class="hero__content">
          <p class="kicker" data-reveal>Onlinekurs i fundamental analys</p>
          <h1 class="hero__title" data-reveal data-reveal-delay="80">
            Lär dig analysera aktier som en <em class="mint-italic">ägare</em>, inte en spekulant.
          </h1>
          <p class="hero__sub" data-reveal data-reveal-delay="160">
            Fundamental aktieanalys, från grunden. Korta lektioner, riktiga övningar
            och ett analysverktyg du faktiskt använder före varje köp.
          </p>
          <div class="hero__actions" data-reveal data-reveal-delay="240">
            <a href={firstHref} class="btn-primary">
              Börja kursen
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <a href="/fokus" class="btn-ghost">Se kursinnehållet</a>
          </div>
        </div>

        <!-- Decorative hero card -->
        <div class="hero__deco" data-reveal data-reveal-delay="200" aria-hidden="true">
          <div class="deco-card">
            <p class="deco-card__kicker">PRIS MOT VÄRDE / Lektion 1.2</p>
            <p class="deco-card__label">Pris vs. inneboende värde</p>
            <div class="deco-chart">
              <svg viewBox="0 0 160 80" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Värdelinje (solid mint) -->
                <path d="M 10 65 C 30 55 50 35 80 30 C 110 25 130 28 150 22" stroke="var(--mint)" stroke-width="2" stroke-linecap="round" />
                <!-- Prislinje (dashed, muted) -->
                <path d="M 10 60 C 25 70 45 50 70 55 C 95 60 120 40 150 48" stroke="var(--muted)" stroke-width="1.5" stroke-dasharray="5 3" stroke-linecap="round" />
                <!-- Margin of safety area (subtle fill) -->
                <path d="M 80 30 C 110 25 130 28 150 22 L 150 48 C 130 40 110 50 80 55 C 60 58 45 65 10 60 L 10 65 C 30 55 50 35 80 30 Z" fill="var(--mint)" opacity="0.07" />
              </svg>
            </div>
            <div class="deco-legend">
              <span class="deco-legend__item deco-legend__item--solid">Inneboende värde</span>
              <span class="deco-legend__item deco-legend__item--dashed">Aktiekurs</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== HUR DET FUNGERAR ===================== -->
    <section class="section how-it-works">
      <div class="section__inner">
        <p class="kicker" data-reveal>SÅ ÄR KURSEN UPPLAGD</p>
        <h2 class="section__heading" data-reveal data-reveal-delay="60">
          Byggt för att fastna, inte bara passera
        </h2>
        <div class="step-grid" data-reveal-children>
          <div class="step-card">
            <span class="step-card__num">01</span>
            <h3 class="step-card__title">Korta lektioner</h3>
            <p class="step-card__body">
              Varje lektion tar tio till femton minuter. Du tar ett steg i taget,
              bygger förståelse i ett hanterbart tempo och kan pausa när livet kräver det.
            </p>
          </div>
          <div class="step-card">
            <span class="step-card__num">02</span>
            <h3 class="step-card__title">Övningar &amp; kunskapskoll</h3>
            <p class="step-card__body">
              Varje modul avslutas med quiz och självskattning. Det är inte för att sätta
              betyg, utan för att kunskapen faktiskt ska sätta sig.
            </p>
          </div>
          <div class="step-card">
            <span class="step-card__num">03</span>
            <h3 class="step-card__title">Analysverktyget Ägarboken</h3>
            <p class="step-card__body">
              Det du lär dig i kursen samlas i en strukturerad checklista. Den använder
              du sedan varje gång du utvärderar ett bolag innan du trycker på köp.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== KURSINNEHÅLL ===================== -->
    <section class="section course-content">
      <div class="section__inner">
        <p class="kicker" data-reveal>KURSINNEHÅLL</p>
        <h2 class="section__heading" data-reveal data-reveal-delay="60">
          Tre kapitel som bygger omdömet
        </h2>
        <div class="del-grid" data-reveal-children>
          {chapters.map((c, i) => (
            <div class="del-card">
              <span class="del-card__kicker">KAPITEL {i + 1}</span>
              <h3 class="del-card__title">{c.title}</h3>
              <p class="del-card__meta">{c.tagline}</p>
              <p class="del-card__meta del-card__count">{c.lessons} lektioner</p>
            </div>
          ))}
        </div>
        <div class="section__footer" data-reveal>
          <a href="/oversikt" class="btn-ghost">Se hela kursen →</a>
        </div>
      </div>
    </section>

    <!-- ===================== VERKTYGET ===================== -->
    <section class="section tool-section">
      <div class="section__inner">
        <div class="tool-card" data-reveal>
          <p class="kicker">VERKTYGET</p>
          <h2 class="tool-card__heading">Ägarboken, din checklista före varje köp</h2>
          <p class="tool-card__body">
            Det du lär dig i kursen samlas i ett verktyg: en strukturerad genomgång
            av bolaget: affärsmodell, finanser, värdering och risker, innan du
            trycker på köp.
          </p>
          <a href="/verktyg" class="btn-primary">
            Öppna Ägarboken
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ===================== SLUT-CTA ===================== -->
    <section class="section final-cta">
      <div class="section__inner final-cta__inner">
        <h2 class="final-cta__heading" data-reveal>Din första lektion väntar.</h2>
        <p class="final-cta__sub" data-reveal data-reveal-delay="80">
          Börja med det allra första: vad det faktiskt innebär att äga en aktie.
        </p>
        <div data-reveal data-reveal-delay="160">
          <a href={firstHref} class="btn-primary btn-primary--large">
            Kom igång
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

  </main>

  <!-- ===================== FOOTER ===================== -->
  <footer class="site-footer">
    <div class="site-footer__inner">
      <a href="/" class="site-footer__brand" aria-label="Ägarboken startsida">
        <span class="brand-mark" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect width="24" height="24" rx="5" fill="var(--mint)" />
            <path d="M7 17V10l5-3 5 3v7" stroke="var(--on-mint)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M10 17v-4h4v4" stroke="var(--on-mint)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        <span class="brand-name">Ägarboken</span>
      </a>
    </div>
  </footer>

</BaseLayout>

<style>
  /* ===================== TOPBAR ===================== */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    transition: background var(--dur-comp) var(--ease-standard),
      border-color var(--dur-comp) var(--ease-standard);
  }

  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 var(--space-6);
    height: 60px;
  }

  .topbar__brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text);
    text-decoration: none;
  }
  .topbar__brand:hover {
    text-decoration: none;
  }

  .brand-mark {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .brand-name {
    font-family: var(--serif);
    font-size: var(--text-lg);
    font-weight: 300;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .topbar__nav {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .topbar__login {
    font-family: var(--sans);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur-micro) var(--ease-standard);
  }
  .topbar__login:hover {
    color: var(--text);
    text-decoration: none;
  }

  .topbar__cta {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    background: var(--mint);
    color: var(--on-mint);
    font-family: var(--sans);
    font-size: var(--text-sm);
    font-weight: 600;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: background var(--dur-micro) var(--ease-standard),
      transform var(--dur-comp) var(--ease-out);
  }
  .topbar__cta:hover {
    background: var(--mint-2);
    text-decoration: none;
    transform: translateY(-1px);
  }

  /* ===================== LAYOUT ===================== */
  .landing {
    min-height: 100vh;
  }

  .section__inner {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  /* ===================== KICKER ===================== */
  .kicker {
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mint);
    margin: 0 0 var(--space-4);
  }

  /* ===================== HERO ===================== */
  .hero {
    padding: var(--space-9) 0;
  }

  .hero__inner {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 var(--space-6);
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: var(--space-8);
    align-items: center;
  }

  .hero__title {
    font-family: var(--serif);
    font-size: clamp(44px, 6vw, 72px);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.08;
    color: var(--text);
    margin: 0 0 var(--space-5);
  }

  .mint-italic {
    font-style: italic;
    color: var(--mint);
  }

  .hero__sub {
    font-family: var(--serif);
    font-size: var(--text-md);
    line-height: var(--leading-body);
    color: var(--prose);
    max-width: 60ch;
    margin: 0 0 var(--space-6);
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  /* ===================== BUTTONS ===================== */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    background: var(--mint);
    color: var(--on-mint);
    font-family: var(--sans);
    font-size: var(--text-base);
    font-weight: 600;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: background var(--dur-micro) var(--ease-standard),
      transform var(--dur-comp) var(--ease-out);
  }
  .btn-primary:hover {
    background: var(--mint-2);
    text-decoration: none;
    transform: translateY(-1px);
  }

  .btn-primary--large {
    padding: var(--space-4) var(--space-7);
    font-size: var(--text-lg);
  }

  .btn-ghost {
    font-family: var(--sans);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid var(--border-2);
    padding-bottom: 2px;
    transition: color var(--dur-micro) var(--ease-standard),
      border-color var(--dur-micro) var(--ease-standard);
  }
  .btn-ghost:hover {
    color: var(--text);
    border-color: var(--mint);
    text-decoration: none;
  }

  /* ===================== HERO DECO CARD ===================== */
  .hero__deco {
    display: flex;
    justify-content: center;
  }

  .deco-card {
    background: var(--surface);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    width: 100%;
    max-width: 360px;
    box-shadow: var(--shadow-md);
  }

  .deco-card__kicker {
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 var(--space-2);
  }

  .deco-card__label {
    font-family: var(--serif);
    font-size: var(--text-md);
    font-weight: 400;
    color: var(--text);
    margin: 0 0 var(--space-4);
  }

  .deco-chart {
    background: var(--surface-2);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: var(--space-3);
  }

  .deco-chart svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .deco-legend {
    display: flex;
    gap: var(--space-4);
  }

  .deco-legend__item {
    font-family: var(--sans);
    font-size: var(--text-xs);
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .deco-legend__item::before {
    content: '';
    display: inline-block;
    width: 16px;
    height: 2px;
    border-radius: 1px;
  }
  .deco-legend__item--solid::before {
    background: var(--mint);
  }
  .deco-legend__item--dashed::before {
    background: transparent;
    border-top: 1.5px dashed var(--muted);
  }

  /* ===================== SECTIONS ===================== */
  .section {
    padding: var(--space-9) 0;
    border-top: 1px solid var(--border);
  }

  .section__heading {
    font-family: var(--serif);
    font-size: clamp(28px, 3.5vw, 44px);
    font-weight: 300;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0 0 var(--space-7);
    max-width: 22ch;
  }

  .section__footer {
    margin-top: var(--space-6);
  }

  /* ===================== HOW IT WORKS ===================== */
  .step-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .step-card {
    background: var(--surface);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }

  .step-card__num {
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--mint);
    display: block;
    margin-bottom: var(--space-3);
  }

  .step-card__title {
    font-family: var(--serif);
    font-size: var(--text-lg);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--text);
    margin: 0 0 var(--space-3);
  }

  .step-card__body {
    font-family: var(--sans);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--muted);
    margin: 0;
  }

  /* ===================== KURSINNEHÅLL ===================== */
  .del-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .del-card {
    background: var(--surface);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
  }

  .del-card__kicker {
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mint);
    display: block;
    margin-bottom: var(--space-2);
  }

  .del-card__title {
    font-family: var(--serif);
    font-size: var(--text-base);
    font-weight: 400;
    color: var(--text);
    margin: 0 0 var(--space-2);
    line-height: 1.3;
  }

  .del-card__meta {
    font-family: var(--sans);
    font-size: var(--text-xs);
    color: var(--muted);
    margin: 0;
  }
  .del-card__meta + .del-card__meta {
    margin-top: 10px;
  }
  .del-card__count {
    color: var(--mint);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  /* ===================== VERKTYGET ===================== */
  .tool-card {
    background: var(--surface);
    border: 1px solid var(--border-2);
    border-top: 2px solid var(--mint);
    border-radius: var(--radius-lg);
    padding: var(--space-7) var(--space-8);
    max-width: 760px;
  }

  .tool-card__heading {
    font-family: var(--serif);
    font-size: clamp(26px, 3vw, 40px);
    font-weight: 300;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0 0 var(--space-4);
    line-height: 1.15;
  }

  .tool-card__body {
    font-family: var(--serif);
    font-size: var(--text-md);
    line-height: var(--leading-body);
    color: var(--prose);
    max-width: 58ch;
    margin: 0 0 var(--space-6);
  }

  /* ===================== FINAL CTA ===================== */
  .final-cta {
    text-align: center;
    background: var(--surface-2);
  }

  .final-cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .final-cta__heading {
    font-family: var(--serif);
    font-size: clamp(36px, 5vw, 60px);
    font-weight: 300;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0 0 var(--space-4);
  }

  .final-cta__sub {
    font-family: var(--serif);
    font-size: var(--text-md);
    color: var(--prose);
    max-width: 50ch;
    margin: 0 0 var(--space-6);
    line-height: var(--leading-body);
  }

  /* ===================== FOOTER ===================== */
  .site-footer {
    border-top: 1px solid var(--border);
    padding: var(--space-6) 0;
  }

  .site-footer__inner {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 var(--space-6);
    display: flex;
    align-items: center;
  }

  .site-footer__brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text);
    text-decoration: none;
  }
  .site-footer__brand:hover {
    text-decoration: none;
  }

  /* ===================== RESPONSIVE ===================== */
  @media (max-width: 900px) {
    .step-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .del-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 760px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .hero__deco {
      display: none;
    }
    .step-grid {
      grid-template-columns: 1fr;
    }
    .del-grid {
      grid-template-columns: 1fr;
    }
    .topbar__inner {
      padding: 0 var(--space-4);
    }
    .section__inner {
      padding: 0 var(--space-4);
    }
    .hero__inner {
      padding: 0 var(--space-4);
    }
    .tool-card {
      padding: var(--space-5);
    }
    .site-footer__inner {
      padding: 0 var(--space-4);
    }
  }
</style>

<script>
  // Topbar: subtle on scroll
  const topbar = document.getElementById('topbar');
  if (topbar) {
    const update = () => {
      topbar.style.borderBottomColor = window.scrollY > 24
        ? 'var(--border-2)'
        : 'var(--border)';
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>
