---
import Broadsheet from '../layouts/Broadsheet.astro';

// Landningen: den stangda tjanstens forstasida. Boxad wordmark + logga in/kod,
// ett hero ("For dig som ager bolag. Inte aktier."), Agarbrevet-sektionen, och
// tjanstens tva delar som fargdrankta kort (Kursen i oxblod, Verktygen i
// skogsgron). Inbjudningsstyrd: entren gar via /logga-in eller inbjudningskod.
// Husregeln: inga em/en-dashes, kolon och komma istallet.

const KOD = '/labs/inbjudan-i-marginalen.html';

const vakter = [
  { t: 'Tillväxtläget', d: 'kassa- och runway-vakt, utspädningsvarning i kod.' },
  { t: 'Avtalsliggaren', d: 'vi skiljer ramavtal från bindande order.' },
  { t: 'Beteendespåret', d: 'beslutsdagbok och en disciplinerad tvilling.' },
];
---

<Broadsheet
  title="Delägaren: din del av bolaget"
  description="En stängd plattform för fundamental analys och automatiserad bolagsbevakning. Inträde sker enbart via personlig inbjudan."
  nav="none"
  chrome="none"
  open
>
  <script is:inline>
    try { if (localStorage.getItem('sb-xpxghvxrckpzbbkjmtcw-auth-token')) location.replace('/hem'); } catch (e) {}
  </script>

  <main class="lp">
    <!-- Masthead: boxad wordmark, logga in / ange kod -->
    <div class="wrap">
      <header class="lp-mast">
        <a class="lp-brand" href="/">Delägaren</a>
        <nav class="lp-mast__nav">
          <a href="/logga-in">Logga in</a>
          <span class="sep" aria-hidden="true">·</span>
          <a class="accent" href={KOD}>Ange kod</a>
        </nav>
      </header>
      <div class="lp-mast-rule"></div>
    </div>

    <!-- Hero -->
    <section class="wrap">
      <div class="lp-hero">
        <div class="lp-hero__k">Din del av bolaget</div>
        <h1 class="lp-hero__h">För dig som äger bolag.<br />Inte aktier.</h1>
        <p class="lp-hero__p">En plattform för fundamental analys och automatiserad bolagsbevakning, designad av <em>Sebastian Berg</em>.</p>
        <p class="lp-hero__meta">Inträde sker enbart via personlig inbjudan</p>
      </div>
    </section>

    <!-- Ägarbrevet -->
    <section class="wrap">
      <div class="lp-sec"><span>Ägarbrevet</span></div>
      <div class="lp-brev">
        <h2 class="lp-brev__h">Varje morgon klockan 07:30</h2>
        <div class="lp-brev__meta">07:30 · text &amp; ljud</div>
        <p class="lp-brev__p">Du ska inte behöva gräva i brus. Varje morgon sammanfattas allt viktigt som har hänt i dina bolag.</p>

        <div class="lp-modes">
          <div class="lp-mode">
            <div class="lp-mode__k">Text</div>
            <p class="lp-mode__d">Läs utgåvan vid skrivbordet, sida för sida.</p>
          </div>
          <div class="lp-mode">
            <div class="lp-mode__k">Ljud</div>
            <p class="lp-mode__d">Eller lyssna, en två minuter lång ljudutgåva i din privata poddfeed, under pendlingen.</p>
          </div>
        </div>

        <blockquote class="lp-pull">”I natt läste vi <span class="num">51</span> rapporter och pressmeddelanden. <span class="num">Tre</span> var värda din tid.”</blockquote>
      </div>
    </section>

    <!-- Tjänstens delar -->
    <section class="wrap">
      <div class="lp-sec"><span>Tjänstens delar</span></div>
      <div class="lp-cards">
        <article class="lp-card lp-card--kurs">
          <div class="lp-card__k">Kursen</div>
          <div class="lp-card__sub">Hantverket</div>
          <h3 class="lp-card__h">Masterclass i fundamental analys.</h3>
          <p class="lp-card__p">Hela utbildningen ingår i ditt medlemskap. Nitton kapitel som tar dig från grunderna till avancerad småbolagsanalys.</p>
          <p class="lp-card__p">Inkluderar den unika Multibagger-modulen: disciplinen bakom att analysera, fånga och hålla bolag utan vinst. Lär dig läsa kallelser, avkoda pressmeddelanden och hantera 50-procentiga svängar utan att tappa din ursprungliga tes.</p>
          <a class="lp-card__cta" href={KOD}>Ansök om medlemskap →</a>
        </article>

        <article class="lp-card lp-card--verktyg">
          <div class="lp-card__k">Verktygen</div>
          <div class="lp-card__sub">Maskinen</div>
          <h3 class="lp-card__h">Din digitala analytiker.</h3>
          <p class="lp-card__p">Vår motor läser rapporterna, korskollar siffrorna mot källan och vaktar dina innehav dygnet runt. En tjänst enbart grundad i verkliga tal.</p>
          <div class="lp-card__label">Detta vaktar dina innehav</div>
          <ul class="lp-checks">
            {vakter.map((v) => (
              <li><b>{v.t}:</b> {v.d}</li>
            ))}
          </ul>
          <a class="lp-card__cta" href={KOD}>Ange inbjudningskod →</a>
        </article>
      </div>
    </section>

    <!-- Avslutande band -->
    <section class="wrap">
      <div class="lp-close">
        <p>Delägaren är ett stängt digitalt verktyg. Vi tar för närvarande endast emot nya medlemmar i mån av plats och via inbjudan från befintliga medlemmar.</p>
      </div>
      <div class="lp-foot">
        <p class="lp-fine">Delägaren, fundamental aktieanalys. I utbildningssyfte, inte finansiell rådgivning.</p>
      </div>
    </section>
  </main>
</Broadsheet>

<style>
  .lp { flex: 1; display: flex; flex-direction: column; }

  /* Masthead */
  .lp-mast { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 26px 0 22px; }
  .lp-brand { display: inline-flex; border: 1.5px solid var(--ink); padding: 9px 18px; font-family: var(--slab); font-weight: 700; font-size: 19px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink); text-decoration: none; transition: background .2s; }
  .lp-brand:hover { background: rgba(33,28,23,.05); }
  .lp-mast__nav { display: flex; align-items: center; gap: 16px; font-family: var(--mono); font-size: 11.5px; letter-spacing: .12em; text-transform: uppercase; }
  .lp-mast__nav a { color: var(--ink-soft); text-decoration: none; min-height: 40px; display: inline-flex; align-items: center; }
  .lp-mast__nav a:hover { color: var(--oxblood); }
  .lp-mast__nav a.accent { color: var(--oxblood); }
  .lp-mast__nav .sep { color: var(--faint); }
  .lp-mast-rule { height: 1px; background: var(--rule-strong); }

  /* Hero */
  .lp-hero { text-align: center; max-width: 760px; margin: 0 auto; padding: clamp(40px,7vh,92px) 0 clamp(34px,6vh,68px); }
  .lp-hero__k { font-family: var(--mono); font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--oxblood); }
  .lp-hero__h { font-family: var(--slab); font-weight: 600; font-size: clamp(38px,6.4vw,76px); line-height: 1.03; letter-spacing: -.015em; color: var(--ink); margin: 16px 0 0; text-wrap: balance; }
  .lp-hero__p { font-family: var(--serif); font-size: clamp(17px,1.7vw,19px); line-height: 1.55; color: var(--ink-soft); max-width: 46ch; margin: 22px auto 0; }
  .lp-hero__p em { font-style: italic; color: var(--ink); }
  .lp-hero__meta { font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); margin: 26px 0 0; }

  /* Section divider with centred label */
  .lp-sec { display: flex; align-items: center; gap: clamp(16px,3vw,26px); margin: clamp(44px,7vw,74px) 0 0; }
  .lp-sec::before, .lp-sec::after { content: ""; flex: 1; height: 1px; background: var(--rule-strong); }
  .lp-sec span { font-family: var(--mono); font-size: 11.5px; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }

  /* Ägarbrevet */
  .lp-brev { text-align: center; padding: clamp(28px,4vw,44px) 0 0; }
  .lp-brev__h { font-family: var(--slab); font-weight: 600; font-size: clamp(28px,3.7vw,42px); line-height: 1.08; letter-spacing: -.008em; color: var(--ink); margin: 0; text-wrap: balance; }
  .lp-brev__meta { font-family: var(--mono); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--oxblood); margin: 14px 0 0; }
  .lp-brev__p { font-family: var(--serif); font-size: 17px; line-height: 1.55; color: var(--ink-soft); max-width: 52ch; margin: 20px auto 0; text-wrap: pretty; }

  .lp-modes { display: grid; grid-template-columns: 1fr 1fr; max-width: 680px; margin: 34px auto 0; border: 1px solid var(--rule-strong); background: var(--card); text-align: left; }
  .lp-mode { padding: 22px clamp(20px,3vw,28px); }
  .lp-mode + .lp-mode { border-left: 1px solid var(--rule-strong); }
  .lp-mode__k { font-family: var(--mono); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--oxblood); }
  .lp-mode__d { font-family: var(--serif); font-size: 15px; line-height: 1.5; color: var(--ink-soft); margin: 8px 0 0; }

  .lp-pull { font-family: var(--serif); font-style: italic; font-size: clamp(19px,2.2vw,24px); line-height: 1.42; color: var(--ink); max-width: 34ch; margin: clamp(34px,5vw,48px) auto 0; text-wrap: balance; }
  .lp-pull .num { color: var(--oxblood); font-style: normal; }

  /* Tjänstens delar: två färgdränkta kort */
  .lp-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 34px 0 0; }
  .lp-card { display: flex; flex-direction: column; padding: clamp(28px,3.4vw,46px); min-height: 440px; color: var(--paper); }
  .lp-card--kurs { background:
      repeating-linear-gradient(90deg, rgba(246,244,239,.028) 0 1px, transparent 1px 8px),
      #4A1521; }
  .lp-card--verktyg { background:
      repeating-linear-gradient(90deg, rgba(246,244,239,.03) 0 1px, transparent 1px 8px),
      #1B362A; }
  .lp-card__k { font-family: var(--mono); font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: rgba(246,244,239,.52); }
  .lp-card__sub { font-family: var(--serif); font-style: italic; font-size: 16px; color: rgba(246,244,239,.68); margin: 7px 0 0; }
  .lp-card__h { font-family: var(--slab); font-weight: 600; font-size: clamp(24px,2.6vw,31px); line-height: 1.08; letter-spacing: -.008em; color: var(--paper); margin: 16px 0 0; text-wrap: balance; }
  .lp-card__p { font-family: var(--serif); font-size: 15.5px; line-height: 1.55; color: rgba(246,244,239,.84); margin: 14px 0 0; }
  .lp-card__label { font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: rgba(246,244,239,.55); margin: 24px 0 0; }

  .lp-checks { list-style: none; margin: 16px 0 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .lp-checks li { position: relative; padding-left: 30px; font-family: var(--serif); font-size: 15px; line-height: 1.45; color: rgba(246,244,239,.82); }
  .lp-checks li::before { content: ""; position: absolute; left: 0; top: 3px; width: 14px; height: 14px; border: 1px solid rgba(246,244,239,.5); }
  .lp-checks b { color: var(--paper); font-weight: 600; }

  .lp-card__cta { align-self: flex-start; margin-top: auto; padding-top: 30px; }
  .lp-card__cta { display: inline-flex; align-items: center; gap: 10px; margin-top: auto; font-family: var(--mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--paper); text-decoration: none; }
  /* Ramad knapp separat sa margin-top:auto ovan skjuter den till botten */
  .lp-card__cta { border: 1px solid rgba(246,244,239,.5); padding: 15px 24px; transition: background .2s, border-color .2s, transform .2s; }
  .lp-card__cta:hover { background: rgba(246,244,239,.1); border-color: var(--paper); transform: translateX(3px); }

  /* Avslutande band */
  .lp-close { max-width: 820px; margin: clamp(48px,8vw,90px) auto 0; border-top: 2px solid var(--rule-strong); border-bottom: 2px solid var(--rule-strong); padding: 26px 20px; text-align: center; }
  .lp-close p { font-family: var(--serif); font-size: 15.5px; line-height: 1.55; color: var(--muted); max-width: 60ch; margin: 0 auto; }
  .lp-foot { padding: 22px 0 40px; text-align: center; }
  .lp-fine { font-family: var(--mono); font-size: 10.5px; letter-spacing: .05em; color: var(--faint); }

  @media (max-width: 760px) {
    .lp-cards { grid-template-columns: 1fr; }
    .lp-card { min-height: 0; }
    .lp-modes { grid-template-columns: 1fr; }
    .lp-mode + .lp-mode { border-left: 0; border-top: 1px solid var(--rule-strong); }
  }
  @media (max-width: 420px) {
    .lp-brand { font-size: 16px; padding: 8px 14px; }
    .lp-mast__nav { gap: 12px; font-size: 10.5px; }
  }
</style>
