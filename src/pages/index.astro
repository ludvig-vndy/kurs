---
import Broadsheet from '../layouts/Broadsheet.astro';
import Seal from '../components/Seal.astro';

// Landningen: den stangda tjanstens forstasida. Centrerad nameplate (sigillet
// med undertitel) flankerad av logga in/kod, ett hero ("Ag bolaget bakom
// aktien."), Agarbrevet-sektionen, och tjanstens tva delar som fargdrankta kort
// (Kursen i oxblod, Verktygen i skogsgron). Inbjudningsstyrd: entren gar via
// /logga-in eller inbjudningskod. Husregeln: inga em/en-dashes, kolon istallet.

const KOD = '/labs/inbjudan.html';

// Symmetriska kort: bada har intro + kort, enradig punktlista.
const larande = [
  { t: 'Fundamenta', d: 'räkenskaper, värdering, riktpris.' },
  { t: 'Multibaggern', d: 'fånga och hålla bolag utan vinst.' },
  { t: 'Temperament', d: 'läsa kallelser, tåla svängarna.' },
];
const vakter = [
  { t: 'Tillväxtläget', d: 'kassa- och runway-vakt, utspädning i kod.' },
  { t: 'Avtalsliggaren', d: 'ramavtal skilt från bindande order.' },
  { t: 'Beteendespåret', d: 'beslutsdagbok och en tvilling.' },
];
---

<Broadsheet
  title="Delägaren: din del av bolaget"
  description="En stängd plattform för fundamental analys och automatiserad bolagsbevakning. Inträde sker enbart via personlig inbjudan."
  nav="none"
  chrome="none"
  open
>
  <script is:inline>
    try { if (localStorage.getItem('sb-xpxghvxrckpzbbkjmtcw-auth-token')) location.replace('/hem'); } catch (e) {}
  </script>

  <main class="lp">
    <!-- Masthead: centrerad nameplate (sigill + undertitel), logga in / ange kod flankerar -->
    <div class="wrap">
      <header class="lp-mast">
        <nav class="lp-mast__side lp-mast__side--l">
          <a href="/logga-in">Logga in</a>
        </nav>
        <Seal size="lg" href="/" />
        <nav class="lp-mast__side lp-mast__side--r">
          <a class="accent" href={KOD}>Ange kod</a>
        </nav>
      </header>
      <div class="lp-mast-rule"></div>
    </div>

    <!-- Hero -->
    <section class="wrap">
      <div class="lp-hero">
        <h1 class="lp-hero__h">Äg bolaget<br />bakom aktien.</h1>
        <p class="lp-hero__p">En plattform för fundamental analys och automatiserad bolagsbevakning, designad av <em>Sebastian Berg</em>.</p>
        <p class="lp-hero__meta">Inträde sker enbart via personlig inbjudan</p>
      </div>
    </section>

    <!-- Ägarbrevet -->
    <section class="wrap">
      <div class="lp-sec"><span>Ägarbrevet</span></div>
      <div class="lp-brev">
        <h2 class="lp-brev__h">Varje morgon klockan 07:30</h2>
        <p class="lp-brev__p">Du ska inte behöva gräva i brus. Varje morgon sammanfattas allt viktigt som har hänt i dina bolag, tillgängligt både som skriven utgåva vid skrivbordet och som en två minuter lång ljudutgåva.</p>
        <blockquote class="lp-pull">”I natt läste vi <span class="num">51</span> rapporter och pressmeddelanden. <span class="num">Tre</span> var värda din tid.”</blockquote>
      </div>
    </section>

    <!-- Tjänstens delar -->
    <section class="wrap">
      <div class="lp-sec"><span>Tjänstens delar</span></div>
      <div class="lp-cards">
        <article class="lp-card lp-card--kurs">
          <div class="lp-card__k">Kursen</div>
          <div class="lp-card__sub">Hantverket</div>
          <h3 class="lp-card__h">Masterclass i fundamental analys.</h3>
          <p class="lp-card__p">Hela utbildningen ingår i ditt medlemskap. Nitton kapitel från grunderna till avancerad småbolagsanalys.</p>
          <div class="lp-card__label">Detta lär du dig</div>
          <ul class="lp-checks">
            {larande.map((v) => (
              <li><b>{v.t}:</b> {v.d}</li>
            ))}
          </ul>
          <a class="lp-card__cta" href={KOD}>Ansök om medlemskap →</a>
        </article>

        <article class="lp-card lp-card--verktyg">
          <div class="lp-card__k">Verktygen</div>
          <div class="lp-card__sub">Maskinen</div>
          <h3 class="lp-card__h">Din digitala analytiker.</h3>
          <p class="lp-card__p">Vår motor läser rapporterna, korskollar siffrorna mot källan och vaktar dina innehav dygnet runt. Enbart verkliga tal.</p>
          <div class="lp-card__label">Detta vaktar dina innehav</div>
          <ul class="lp-checks">
            {vakter.map((v) => (
              <li><b>{v.t}:</b> {v.d}</li>
            ))}
          </ul>
          <a class="lp-card__cta" href={KOD}>Ange inbjudningskod →</a>
        </article>
      </div>
    </section>

    <!-- Avslutande band -->
    <section class="wrap">
      <div class="lp-close">
        <p>Delägaren är ett stängt digitalt verktyg. Vi tar för närvarande endast emot nya medlemmar i mån av plats och via inbjudan från befintliga medlemmar.</p>
      </div>
      <div class="lp-foot">
        <p class="lp-fine">Delägaren, fundamental aktieanalys. I utbildningssyfte, inte finansiell rådgivning.</p>
      </div>
    </section>
  </main>
</Broadsheet>

<style>
  .lp { flex: 1; display: flex; flex-direction: column; }

  /* Masthead: centrerad nameplate, links flankerar */
  .lp-mast { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px; padding: 24px 0 18px; }
  /* Sigillet bor i Seal-komponenten (egen scope), :global for att na det harifran */
  .lp-mast :global(.seal) { justify-self: center; }
  .lp-mast__side { display: flex; align-items: center; font-family: var(--mono); font-size: 11.5px; letter-spacing: .12em; text-transform: uppercase; }
  .lp-mast__side--l { justify-content: flex-start; }
  .lp-mast__side--r { justify-content: flex-end; }
  .lp-mast__side a { color: var(--ink-soft); text-decoration: none; min-height: 40px; display: inline-flex; align-items: center; }
  .lp-mast__side a:hover { color: var(--oxblood); }
  .lp-mast__side a.accent { color: var(--oxblood); }
  .lp-mast-rule { height: 1px; background: var(--rule-strong); }

  /* Hero */
  .lp-hero { text-align: center; max-width: 760px; margin: 0 auto; padding: clamp(20px,4vh,42px) 0 clamp(10px,1.8vh,18px); }
  .lp-hero__h { font-family: var(--slab); font-weight: 600; font-size: clamp(38px,5.8vw,68px); line-height: 1.03; letter-spacing: -.015em; color: var(--ink); margin: 0; text-wrap: balance; }
  .lp-hero__p { font-family: var(--serif); font-size: clamp(16.5px,1.6vw,18.5px); line-height: 1.55; color: var(--ink-soft); max-width: 46ch; margin: 18px auto 0; }
  .lp-hero__p em { font-style: italic; color: var(--ink); }
  .lp-hero__meta { font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); margin: 16px 0 0; }

  /* Section divider with centred label */
  .lp-sec { display: flex; align-items: center; gap: clamp(16px,3vw,26px); margin: clamp(16px,2.4vw,28px) 0 0; }
  .lp-sec::before, .lp-sec::after { content: ""; flex: 1; height: 1px; background: var(--rule-strong); }
  .lp-sec span { font-family: var(--mono); font-size: 11.5px; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }

  /* Ägarbrevet: löpande, stram text + citat (inga boxar) */
  .lp-brev { text-align: center; padding: clamp(20px,3vw,32px) 0 0; }
  .lp-brev__h { font-family: var(--slab); font-weight: 600; font-size: clamp(27px,3.5vw,40px); line-height: 1.08; letter-spacing: -.008em; color: var(--ink); margin: 0; text-wrap: balance; }
  .lp-brev__p { font-family: var(--serif); font-size: 17px; line-height: 1.55; color: var(--ink-soft); max-width: 58ch; margin: 16px auto 0; text-wrap: pretty; }

  .lp-pull { font-family: var(--serif); font-style: italic; font-size: clamp(16px,1.7vw,19px); line-height: 1.45; color: var(--ink); max-width: 40ch; margin: clamp(20px,3vw,28px) auto 0; text-wrap: balance; }
  .lp-pull .num { color: var(--oxblood); font-style: normal; }

  /* Tjänstens delar: två färgdränkta kort */
  .lp-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: clamp(22px,3vw,30px) 0 0; }
  .lp-card { display: flex; flex-direction: column; padding: clamp(26px,3vw,40px); min-height: 400px; color: var(--paper); }
  .lp-card--kurs { background:
      repeating-linear-gradient(90deg, rgba(246,244,239,.028) 0 1px, transparent 1px 8px),
      #4A1521; }
  .lp-card--verktyg { background:
      repeating-linear-gradient(90deg, rgba(246,244,239,.03) 0 1px, transparent 1px 8px),
      #1B362A; }
  .lp-card__k { font-family: var(--mono); font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: rgba(246,244,239,.52); }
  .lp-card__sub { font-family: var(--serif); font-style: italic; font-size: 16px; color: rgba(246,244,239,.68); margin: 7px 0 0; }
  .lp-card__h { font-family: var(--slab); font-weight: 600; font-size: clamp(24px,2.6vw,31px); line-height: 1.08; letter-spacing: -.008em; color: var(--paper); margin: 16px 0 0; text-wrap: balance; }
  .lp-card__p { font-family: var(--serif); font-size: 15.5px; line-height: 1.55; color: rgba(246,244,239,.84); margin: 14px 0 0; }
  .lp-card__label { font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: rgba(246,244,239,.55); margin: 20px 0 0; }

  /* margin-bottom = garanterat gap ner till knappen aven nar innehallet fyller
     kortet; margin-top:auto pa knappen lagger ev. extra luft ovanpa det. */
  .lp-checks { list-style: none; margin: 13px 0 34px; padding: 0; display: flex; flex-direction: column; gap: 11px; }
  .lp-checks li { position: relative; padding-left: 24px; font-family: var(--serif); font-size: 13.5px; line-height: 1.35; color: rgba(246,244,239,.82); }
  .lp-checks li::before { content: ""; position: absolute; left: 0; top: 2px; width: 12px; height: 12px; border: 1px solid rgba(246,244,239,.5); }
  .lp-checks b { color: var(--paper); font-weight: 600; }

  /* margin-top:auto skjuter knappen till botten; kortets min-height ger alltid
     luft ovanfor sa den aldrig klibbar mot sista punkten. Egen padding ar
     knappens ram, inte gapet. */
  .lp-card__cta { align-self: flex-start; margin-top: auto; display: inline-flex; align-items: center; gap: 10px; font-family: var(--mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--paper); text-decoration: none; border: 1px solid rgba(246,244,239,.5); padding: 15px 24px; transition: background .2s, border-color .2s, transform .2s; }
  .lp-card__cta:hover { background: rgba(246,244,239,.1); border-color: var(--paper); transform: translateX(3px); }

  /* Avslutande band */
  .lp-close { max-width: 820px; margin: clamp(32px,5vw,56px) auto 0; border-top: 2px solid var(--rule-strong); border-bottom: 2px solid var(--rule-strong); padding: 22px 20px; text-align: center; }
  .lp-close p { font-family: var(--serif); font-size: 15px; line-height: 1.5; color: var(--muted); max-width: 60ch; margin: 0 auto; }
  .lp-foot { padding: 18px 0 34px; text-align: center; }
  .lp-fine { font-family: var(--mono); font-size: 10.5px; letter-spacing: .05em; color: var(--faint); }

  @media (max-width: 760px) {
    .lp-cards { grid-template-columns: 1fr; }
    .lp-card { min-height: 0; }
  }
  @media (max-width: 620px) {
    /* Sigillet överst i full bredd, logga in / ange kod under på var sin sida */
    .lp-mast { grid-template-columns: 1fr 1fr; row-gap: 14px; }
    .lp-mast :global(.seal) { grid-column: 1 / -1; order: -1; margin-bottom: 2px; }
  }
</style>
