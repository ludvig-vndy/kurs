---
import Broadsheet from '../layouts/Broadsheet.astro';
import Seal from '../components/Seal.astro';

// Slank invite-only-omslag. Skiljer sig medvetet fran /hem (det inloggade navet):
// har ar boxade sigillet hjalten, mastheaden gomd (chrome=none), och sidan ar en
// entré, inte en saljlandning. Sigillet syns EN gang; footern kor vanlig wordmark.
---

<Broadsheet
  title="Delägaren: analysera aktier som en ägare"
  description="Inbjudningsstyrd onlinekurs i fundamental aktieanalys. Sjutton kapitel, ett steg i taget: från vad en aktie är till att sätta ett eget riktpris med felmarginal."
  nav="none"
  chrome="none"
>
  <script is:inline>
    // Redan inloggad? Skicka till det inloggade hemmet i stallet for omslaget.
    try {
      if (localStorage.getItem('sb-xpxghvxrckpzbbkjmtcw-auth-token')) {
        location.replace('/hem');
      }
    } catch (e) {}
  </script>

  <main class="cover">
    <div class="wrap cover-top">
      <a class="cover-login" href="/hem">Logga in</a>
    </div>

    <section class="wrap cover-hero hero--bild">
      <div class="cover-lead">
        <Seal size="lg" href="/" />
        <div class="kicker">Onlinekurs i fundamental analys · inbjudan krävs</div>
        <h1 class="h-title">Lär dig analysera aktier som en <em>ägare</em>, inte en spekulant.</h1>
        <p class="standfirst">Sjutton kapitel, ett steg i taget. Från vad en aktie faktiskt är till att läsa en årsredovisning och sätta ditt eget riktpris med felmarginal.</p>
        <div class="cta-row">
          <a class="btn-ink" href="/fokus">Börja kursen →</a>
          <a class="link-mono" href="/labs/inbjudan-i-marginalen.html" style="color:var(--ink-soft)">Har du en inbjudan? →</a>
        </div>
      </div>
    </section>

    <div class="wrap cover-foot">
      <p class="cover-fine">Delägaren, fundamental aktieanalys. I utbildningssyfte, inte finansiell rådgivning.</p>
    </div>
  </main>
</Broadsheet>

<style>
  /* Omslaget fyller hela vyn: hjalten vertikalt centrerad. */
  .cover { flex:1; display:flex; flex-direction:column; }
  .cover-top { display:flex; justify-content:flex-end; align-items:center; padding:22px 0 0; }
  .cover-login { font-family:var(--mono); font-size:11px; letter-spacing:.12em; text-transform:uppercase; color:var(--ink-soft); text-decoration:none; min-height:40px; display:inline-flex; align-items:center; }
  .cover-login:hover { color:var(--oxblood); }

  .cover-hero { flex:1; display:flex; flex-direction:column; justify-content:flex-start; padding:clamp(36px,8vh,88px) 0 56px; position:relative; }
  .cover-lead { max-width:640px; }
  .cover-lead .seal { margin:0 0 36px; }
  .cover-hero h1 { text-wrap:balance; margin-top:16px; }
  .cover-hero .standfirst { text-wrap:pretty; max-width:52ch; margin-top:18px; }
  .cover-hero .cta-row { display:flex; gap:14px; align-items:center; margin-top:30px; flex-wrap:wrap; }

  /* Borshusets fasad som dampat tryck bakom omslaget: grayscale i lag opacitet,
     paperskyddande gradient haller textspalten pa kontrast. Full utfallsbredd. */
  .hero--bild::before {
    content:""; position:absolute; top:0; bottom:0; left:50%; width:100vw; margin-left:-50vw;
    background-image:url('/bilder/borshuset-1600.jpg');
    background-size:cover; background-position:center 32%;
    filter:grayscale(1) contrast(.92);
    opacity:.11; pointer-events:none; z-index:-1;
  }
  .hero--bild::after {
    content:""; position:absolute; top:0; bottom:0; left:50%; width:100vw; margin-left:-50vw;
    background:linear-gradient(90deg, var(--paper) 0%, rgba(246,244,239,.55) 42%, rgba(246,244,239,.2) 70%, var(--paper) 100%),
               linear-gradient(180deg, var(--paper) 0%, rgba(246,244,239,0) 22%, rgba(246,244,239,0) 72%, var(--paper) 100%);
    pointer-events:none; z-index:-1;
  }

  .cover-foot { border-top:1px solid var(--rule); padding:20px 0 36px; }
  .cover-fine { font-family:var(--mono); font-size:10.5px; letter-spacing:.04em; color:var(--faint); }

  @media (max-width:760px) {
    .cover-hero { padding-top:24px; }
  }
</style>
