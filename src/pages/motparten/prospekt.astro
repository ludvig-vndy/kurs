---
/* Prospektlistan: kursens tilläggstjänst.
   Sidan är ett skal. Företagsdatan och deltagarens eget arbete hämtas från
   /api/prospekt/lista, som kräver pilotcookien och ett registrerat köp.
   Ingenting om listan ligger i den byggda filen, så en oköpt sida är tom. */
import Broadsheet from '../../layouts/Broadsheet.astro';
import { konfig } from '../../lib/kurs.mjs';
import '../../styles/motparten.css';
import '../../styles/prospekt.css';
import '../../styles/prospekt-lista.css';

const k = konfig('motparten');
---

<Broadsheet
  title="Prospektlista · Motparten"
  description="Din prospektlista: bolag, arbetsställen och ditt eget arbete."
  active="kurs"
  bodyClass={k.bodyClass}
  kurs={k}
>
  <div class="prospekt" data-prospekt>
    <p class="lader" data-lader>Hämtar listan…</p>

    <div class="fel" data-fel hidden>
      <h1>Listan är inte tillgänglig</h1>
      <p data-felText></p>
    </div>

    <div data-innehall hidden>
      <header class="mast">
        <p class="eyebrow" data-eyebrow></p>
        <h1 data-namn></h1>
        <p class="standfirst" data-ingress></p>
        <div class="mast-meta" data-meta></div>
        <hr class="rule" />
        <div class="prog">
          <span class="prog-label" data-progLabel></span>
          <span class="prog-track"><span class="prog-fill" data-progFill></span></span>
        </div>
        <p class="prog-def">Kontaktad betyder minst ett registrerat kontaktförsök,
          inte att kortet är öppnat.</p>
      </header>

      <div class="controls">
        <input type="search" data-q placeholder="Sök bolag, person eller ort" aria-label="Sök i listan" />
        <div class="chips" role="group" aria-label="Filtrera på grupp">
          <button class="chip-btn" data-prio="A" aria-pressed="false">Grupp A</button>
          <button class="chip-btn" data-prio="B" aria-pressed="false">Grupp B</button>
          <button class="chip-btn" data-prio="C" aria-pressed="false">Grupp C</button>
        </div>
        <button class="chip-btn" data-cKoncern aria-pressed="false">Max ett per koncern</button>
        <button class="chip-btn" data-cAtt aria-pressed="false">Att göra</button>
        <select data-fStatus aria-label="Filtrera på status">
          <option value="">Alla statusar</option>
          <option value="ny">Ny</option>
          <option value="forsokt">Försökt</option>
          <option value="pratat">Pratat</option>
          <option value="intresse">Intresse</option>
          <option value="nej">Nej</option>
        </select>
        <select data-fOrt aria-label="Filtrera på ort"><option value="">Alla orter</option></select>
        <button class="chip-btn" data-export>Exportera urvalet</button>
        <button class="chip-btn reset" data-reset>Rensa</button>
        <span class="count" data-count></span>
        <span class="sparstatus" data-sparstatus aria-live="polite"></span>
      </div>

      <div class="split">
        <div class="listspalt">
          <div class="colhead" aria-hidden="true">
            <span></span><span></span><span>Bolag</span>
            <span class="r">Nästa steg</span><span class="r">Omsättning</span><span class="r">Ställen</span>
          </div>
          <div data-lista></div>
          <p class="empty" data-tomt hidden>Inga bolag matchar det urvalet.</p>
        </div>
        <div class="kortspalt">
          <div class="kort" data-panel></div>
        </div>
      </div>

      <footer class="kallor">
        <p data-kalla></p>
        <p data-urval></p>
      </footer>
    </div>
  </div>
</Broadsheet>


<script>
  import { startaProspekt } from '../../scripts/prospekt.js';
  startaProspekt();
</script>
