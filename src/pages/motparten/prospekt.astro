---
/* Prospektlistan: kursens tilläggstjänst.
   Sidan är ett skal. Företagsdatan och deltagarens eget arbete hämtas från
   /api/prospekt/lista, som kräver pilotcookien och ett registrerat köp.
   Ingenting om listan ligger i den byggda filen, så en oköpt sida är tom. */
import Broadsheet from '../../layouts/Broadsheet.astro';
import { konfig } from '../../lib/kurs.mjs';
import '../../styles/motparten.css';

const k = konfig('motparten');
---

<Broadsheet
  title="Prospektlista · Motparten"
  description="Din prospektlista med status, värde och anteckningar."
  active="kurs"
  bodyClass={k.bodyClass}
  kurs={k}
>
  <div class="prospekt" data-prospekt>
    <p class="lader" data-lader>Hämtar listan…</p>

    <div class="fel" data-fel hidden>
      <h1>Listan är inte tillgänglig</h1>
      <p data-felText></p>
    </div>

    <div data-innehall hidden>
      <header class="mast">
        <p class="eyebrow" data-eyebrow></p>
        <h1 data-namn></h1>
        <p class="standfirst" data-ingress></p>
        <div class="mast-meta" data-meta></div>
        <hr class="rule" />
        <div class="prog">
          <span class="prog-label" data-progLabel></span>
          <span class="prog-track"><span class="prog-fill" data-progFill></span></span>
        </div>
        <p class="prog-break" data-progBreak></p>
      </header>

      <div class="controls">
        <input type="search" data-q placeholder="Sök bolag, kommun eller ort" aria-label="Sök i listan" />
        <div class="chips" role="group" aria-label="Filtrera på grupp">
          <button class="chip-btn" data-prio="A" aria-pressed="false">Grupp A</button>
          <button class="chip-btn" data-prio="B" aria-pressed="false">Grupp B</button>
          <button class="chip-btn" data-prio="C" aria-pressed="false">Grupp C</button>
        </div>
        <select data-dim="st" aria-label="Filtrera på status"><option value="">Alla statusar</option></select>
        <select data-dim="omsattning_band" aria-label="Filtrera på omsättning"><option value="">All omsättning</option></select>
        <select data-dim="anstallda_band" aria-label="Filtrera på storlek"><option value="">Alla storlekar</option></select>
        <select data-dim="koncernlage" aria-label="Filtrera på koncernläge"><option value="">Fristående och dotterbolag</option></select>
        <select data-dim="kommun" aria-label="Filtrera på kommun"><option value="">Alla kommuner</option></select>
        <select data-dim="verksamhet" aria-label="Filtrera på verksamhet"><option value="">All verksamhet</option></select>
        <button class="chip-btn" data-export>Exportera urvalet</button>
        <button class="chip-btn reset" data-reset>Rensa</button>
        <span class="count" data-count></span>
        <span class="sparstatus" data-sparstatus aria-live="polite"></span>
      </div>

      <main data-list></main>
      <p class="empty" data-empty hidden>Inga bolag matchar det urvalet.</p>

      <footer class="kallor">
        <p data-kalla></p>
        <p data-urval></p>
      </footer>
    </div>
  </div>
</Broadsheet>

<style>
  .prospekt { max-width: 1120px; margin: 0 auto; padding: 0 28px 96px; }
  .lader, .fel { padding: 80px 0; color: var(--mp-muted, #847b6c); }
  .fel h1 { font-size: 30px; margin: 0 0 8px; }

  .mast { padding: 40px 0 0; }
  .eyebrow, .mast-meta, .prog-label, .prog-break, .count, .sparstatus, .kallor p {
    font-family: var(--mp-sans, Jost, system-ui, sans-serif);
    font-size: 11px; letter-spacing: .13em; text-transform: uppercase;
    color: var(--mp-muted, #847b6c);
  }
  .mast h1 { font-size: clamp(38px, 6vw, 66px); line-height: 1; margin: 14px 0 0; text-wrap: balance; }
  .standfirst { font-size: 19px; line-height: 1.5; max-width: 31em; margin: 18px 0 0; font-weight: 300; }
  .mast-meta { display: flex; flex-wrap: wrap; gap: 6px 26px; margin: 26px 0 0; }
  .rule { height: 1px; background: var(--mp-line, #ded6c5); border: 0; margin: 30px 0 0; }

  .prog { display: flex; align-items: center; gap: 18px; margin: 20px 0 0; }
  .prog-track { flex: 1; height: 1px; background: var(--mp-line, #ded6c5); position: relative; }
  .prog-fill {
    position: absolute; inset: 0; background: var(--mp-ok, #5c6b4a);
    transform: scaleX(0); transform-origin: left center; transition: transform .3s ease;
  }
  .prog-break { display: flex; flex-wrap: wrap; gap: 4px 20px; margin: 12px 0 0; font-variant-numeric: tabular-nums; }
  .prog-break b { font-weight: 400; color: var(--mp-ink-soft, #4a443a); }

  .controls {
    position: sticky; top: 0; z-index: 20; background: var(--mp-ground, #f2eee3);
    border-bottom: 1px solid var(--mp-line, #ded6c5);
    margin: 44px 0 0; padding: 14px 0 12px;
    display: flex; flex-wrap: wrap; align-items: center; gap: 9px 12px;
  }
  .controls input, .controls select {
    font-family: var(--mp-sans, Jost, system-ui, sans-serif); font-size: 13px;
    background: var(--mp-paper, #f8f5ec); border: 1px solid var(--mp-line, #ded6c5);
    border-radius: 0; padding: 8px 11px; min-width: 0; max-width: 100%; color: inherit;
  }
  .controls input { flex: 1 1 200px; }
  .chips { display: flex; gap: 6px; }
  .chip-btn {
    font-family: var(--mp-sans, Jost, system-ui, sans-serif); font-size: 11px;
    letter-spacing: .12em; text-transform: uppercase; background: transparent;
    color: var(--mp-muted, #847b6c); border: 1px solid var(--mp-line, #ded6c5);
    padding: 7px 12px; cursor: pointer; font-variant-numeric: tabular-nums;
  }
  .chip-btn[aria-pressed='true'] { background: var(--mp-ink, #1e1b16); color: var(--mp-ground, #f2eee3); }
  .reset { border-color: transparent; text-decoration: underline; text-underline-offset: 3px; }
  .count { margin-left: auto; font-variant-numeric: tabular-nums; }
  .sparstatus { flex: 0 0 auto; min-width: 6em; text-align: right; }

  .group { margin: 48px 0 0; }
  .group-head { display: flex; align-items: baseline; gap: 18px; padding-bottom: 10px; border-bottom: 1px solid var(--mp-line, #ded6c5); }
  .group-key { font-family: var(--mp-sans, Jost, system-ui, sans-serif); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--mp-faint, #a9a091); }
  .group-name { font-family: var(--mp-sans, Jost, system-ui, sans-serif); font-weight: 500; font-size: 19px; margin: 0; }
  .group-line { flex: 1 1 auto; height: 1px; background: var(--mp-line-soft, #e9e2d4); }

  .row { display: grid; grid-template-columns: 26px 52px minmax(0, 1fr) 250px; gap: 0 16px; align-items: start; padding: 18px 0; border-bottom: 1px solid var(--mp-line-soft, #e9e2d4); }
  .row.avfard { opacity: .45; }
  .dot { display: block; margin-top: 7px; width: 12px; height: 12px; border-radius: 50%; border: 1px solid var(--mp-line, #ded6c5); }
  .dot[data-s='forsokt'] { background: var(--mp-faint, #a9a091); border-color: var(--mp-faint, #a9a091); }
  .dot[data-s='pratat'] { background: var(--mp-muted, #847b6c); border-color: var(--mp-muted, #847b6c); }
  .dot[data-s='intresse'] { background: var(--mp-ok, #5c6b4a); border-color: var(--mp-ok, #5c6b4a); }
  .dot[data-s='nej'] { background: var(--mp-flag, #8a4a30); border-color: var(--mp-flag, #8a4a30); }
  .num { font-family: var(--mp-sans, Jost, system-ui, sans-serif); font-weight: 300; font-size: 26px; color: var(--mp-faint, #a9a091); font-variant-numeric: tabular-nums; line-height: 1.1; }
  .namn { font-family: var(--mp-sans, Jost, system-ui, sans-serif); font-weight: 500; font-size: 17px; margin: 0 0 5px; line-height: 1.3; }
  .row.avfard .namn { text-decoration: line-through; }
  .facts { font-family: var(--mp-sans, Jost, system-ui, sans-serif); font-size: 11px; letter-spacing: .11em; text-transform: uppercase; color: var(--mp-muted, #847b6c); margin: 0 0 8px; display: flex; flex-wrap: wrap; gap: 2px 14px; font-variant-numeric: tabular-nums; }
  .facts b { font-weight: 400; color: var(--mp-ink-soft, #4a443a); }
  .note { margin: 0; font-size: 15.5px; line-height: 1.55; font-weight: 300; max-width: 44em; color: var(--mp-ink-soft, #4a443a); }
  .jot { display: block; width: 100%; max-width: 44em; margin: 9px 0 0; font-family: var(--mp-sans, Jost, system-ui, sans-serif); font-size: 13.5px; line-height: 1.55; background: transparent; border: 0; border-bottom: 1px dashed var(--mp-line-soft, #e9e2d4); padding: 3px 0 5px; resize: none; overflow: hidden; color: inherit; }
  .jot::placeholder { color: transparent; }
  .row:hover .jot { border-bottom-color: var(--mp-line, #ded6c5); }
  .row:hover .jot::placeholder, .jot:focus::placeholder { color: var(--mp-faint, #a9a091); }
  .jot:focus { outline: none; border-bottom: 1px solid var(--mp-ink, #1e1b16); }

  .contact { display: flex; flex-direction: column; gap: 3px; padding-top: 2px; }
  .rowtools { display: flex; gap: 6px; margin: 0 0 9px; flex-wrap: wrap; opacity: 0; transition: opacity .15s; }
  .row:hover .rowtools, .rowtools:focus-within, .rowtools.aktiv { opacity: 1; }
  .status-sel, .amount { font-family: var(--mp-sans, Jost, system-ui, sans-serif); font-size: 11px; letter-spacing: .11em; text-transform: uppercase; background: transparent; border: 1px solid var(--mp-line, #ded6c5); padding: 5px 7px; color: var(--mp-muted, #847b6c); }
  .amount { width: 104px; text-align: right; font-variant-numeric: tabular-nums; }
  .status-sel[data-set='1'], .amount[data-set='1'] { color: var(--mp-ink, #1e1b16); border-color: var(--mp-muted, #847b6c); }
  .vd { font-family: var(--mp-sans, Jost, system-ui, sans-serif); font-size: 14px; font-weight: 500; margin: 0 0 4px; }
  .vd span { display: block; font-weight: 400; font-size: 10px; letter-spacing: .13em; text-transform: uppercase; color: var(--mp-faint, #a9a091); margin-top: 2px; }
  .contact a { font-family: var(--mp-sans, Jost, system-ui, sans-serif); font-size: 14px; color: inherit; text-decoration: none; border-bottom: 1px solid var(--mp-line, #ded6c5); align-self: flex-start; word-break: break-all; font-variant-numeric: tabular-nums; }
  .addr { font-family: var(--mp-sans, Jost, system-ui, sans-serif); font-size: 11px; letter-spacing: .06em; color: var(--mp-faint, #a9a091); margin-top: 5px; line-height: 1.45; }
  .kanal { font-family: var(--mp-sans, Jost, system-ui, sans-serif); font-size: 10px; letter-spacing: .13em; text-transform: uppercase; color: var(--mp-flag, #8a4a30); border: 1px solid var(--mp-flag, #8a4a30); padding: 4px 8px; align-self: flex-start; margin-top: 8px; }
  .empty { padding: 70px 0; text-align: center; }
  .kallor { margin: 64px 0 0; padding-top: 22px; border-top: 1px solid var(--mp-line, #ded6c5); }
  .kallor p { margin: 0 0 6px; line-height: 1.7; color: var(--mp-faint, #a9a091); }

  @media (max-width: 900px) {
    .row { grid-template-columns: 22px 40px minmax(0, 1fr); }
    .contact { grid-column: 2 / -1; margin-top: 10px; }
  }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>

<script>
  import { startaProspekt } from '../../scripts/prospekt.js';
  startaProspekt();
</script>
