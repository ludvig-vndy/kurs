---
import { getCollection, render } from 'astro:content';
import LessonLayout from '../../layouts/LessonLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LessonHeader from '../../components/LessonHeader.astro';
import Quiz from '../../components/Quiz.astro';
import MarkComplete from '../../components/MarkComplete.astro';
import PrevNext from '../../components/PrevNext.astro';
import { getAdjacent, readingTime } from '../../lib/course';

export async function getStaticPaths() {
  const lessons = await getCollection('kurs');
  return lessons.map((lesson) => ({
    params: { slug: lesson.id },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const { Content } = await render(lesson);
const { prev, next } = await getAdjacent(lesson.id);
const minutes = readingTime(lesson.body);
const d = lesson.data;
---

<LessonLayout title={d.titel} currentId={lesson.id} deck>
  <article class="deck" data-deck>
    <div class="deck__progress" aria-hidden="true">
      <div class="deck__fill" data-deck-fill></div>
    </div>

    <div class="deck__stage" data-deck-stage>
      <div data-src="intro">
        <Breadcrumb del={d.del} modulTitel={d.modulTitel} lektion={d.lektion} />
        <LessonHeader
          titel={d.titel}
          niva={d.niva}
          lektion={d.lektion}
          fardighet={d.fardighet}
          minutes={minutes}
        />
        <p class="deck-hint">
          Lektionen är uppdelad i korta steg. Klicka <strong>Fortsätt</strong>
          eller använd piltangenterna.
        </p>
      </div>

      <div class="prose" data-src="body">
        <Content />
      </div>

      {
        d.quiz && d.quiz.length > 0 && (
          <div data-src="quiz">
            <Quiz quiz={d.quiz} lessonId={lesson.id} />
          </div>
        )
      }

      <div data-src="outro">
        <div class="lesson-end">
          <span class="lesson-end__kicker">Du har gått igenom lektionen</span>
          <h2 class="lesson-end__title">Bra jobbat.</h2>
          <p class="lesson-end__skill">{d.fardighet}</p>
          <MarkComplete lessonId={lesson.id} />
          <PrevNext prev={prev} next={next} />
        </div>
      </div>
    </div>
  </article>
</LessonLayout>

<style>
  .deck-hint {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--text-faint);
    margin-top: var(--space-5);
  }
  .deck-hint strong {
    color: var(--text-muted);
  }
  .lesson-end {
    text-align: center;
    max-width: 540px;
    margin: 0 auto;
  }
  .lesson-end__kicker {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--accent);
  }
  .lesson-end__title {
    font-size: var(--text-2xl);
    margin: var(--space-2) 0 var(--space-4);
  }
  .lesson-end__skill {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    line-height: 1.5;
    color: var(--text-muted);
    margin: 0 0 var(--space-5);
  }
  .lesson-end :global(.complete) {
    margin-top: var(--space-3);
  }
  .lesson-end :global(.prevnext) {
    margin-top: var(--space-7);
    text-align: left;
  }
</style>

<script>
  import { setupDeck } from '../../scripts/deck';
  document.addEventListener('astro:page-load', setupDeck);
</script>
