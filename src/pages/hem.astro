---
import manifest from '../../course.manifest.json';
import fs from 'node:fs';
import path from 'node:path';
import Broadsheet from '../layouts/Broadsheet.astro';

// ---- Build Fokus lesson list from course.json ----
const contentDir = path.resolve('content/fundamental-aktieanalys');
const courseRaw = fs.readFileSync(path.join(contentDir, 'course.json'), 'utf8');
const course = JSON.parse(courseRaw) as {
  kapitel: Array<{
    nummer: number;
    titel: string;
    niva: string;
    tid_min: number;
    lektioner: Array<{ lektion: string; titel: string; niva: string; tid_min: number; status: string; fil: string }>;
  }>;
};

interface DashLesson { lektion: string; titel: string; niva: string; tid_min: number; kapitelTitel: string; href: string }
const dashLessons: DashLesson[] = [];
for (const kap of course.kapitel) {
  for (const l of kap.lektioner) {
    dashLessons.push({
      lektion: l.lektion,
      titel: l.titel,
      niva: l.niva,
      tid_min: l.tid_min,
      kapitelTitel: kap.titel,
      href: `/fokus/${l.lektion}`,
    });
  }
}

const fokusOrder = dashLessons.map((l) => l.lektion);
const firstHref = dashLessons.length ? dashLessons[0].href : '/fokus';
const total = dashLessons.length;

interface DashChapter { nummer: number; titel: string; href: string; ids: string[] }
const dashChapters: DashChapter[] = course.kapitel.map((kap) => ({
  nummer: kap.nummer,
  titel: kap.titel,
  href: `/fokus/kapitel/${kap.nummer}`,
  ids: kap.lektioner.map((l) => l.lektion),
}));
---

<Broadsheet title="Hem: Fundamental aktieanalys" active="hem" nav="app">
  <main class="wrap" style="flex:1">
    <!-- data blobs -->
    <script type="application/json" data-dash-lessons set:html={JSON.stringify(dashLessons)} />
    <script type="application/json" data-fokus-order set:html={JSON.stringify(fokusOrder)} />
    <script type="application/json" data-dash-chapters set:html={JSON.stringify(dashChapters)} />

    <!-- ===== Hero ===== -->
    <section class="hero">
      <div>
        <div class="kicker" data-greeting>God dag</div>
        <div class="datumrad" data-datumrad></div>
        <h1 class="greeting">Marknaden rör sig.<br />Lär dig läsa den <em>som en ägare.</em></h1>
        <p class="lede">Från din första aktie till ett färdigt investeringscase, ett steg i taget, på riktig data.</p>
        <div class="stats">
          <div class="stat"><div class="v" data-stat-streak>0</div><div class="l">dagar i rad</div></div>
          <div class="stat"><div class="v" data-stat-pct>0%</div><div class="l">av kursen klar</div></div>
          <div class="stat"><div class="v"><span data-stat-done>0</span><span class="u">/{total}</span></div><div class="l">lektioner</div></div>
        </div>
      </div>
      <figure class="fig">
        <div class="cap"><span>Figur 1 · Pris mot värde</span><span>illustrativ</span></div>
        <svg viewBox="0 0 360 150" aria-hidden="true">
          <line class="dot-h" x1="150" y1="30" x2="150" y2="126"></line>
          <path class="vline" d="M8,118 C70,110 120,96 180,74 C240,52 300,38 352,26"></path>
          <path class="vglow" d="M8,118 C70,110 120,96 180,74 C240,52 300,38 352,26"></path>
          <path class="pline" d="M8,124 L44,94 L82,130 L120,82 L150,126 L188,74 L226,110 L264,60 L302,98 L352,48"></path>
          <circle class="dot" cx="150" cy="126" r="4.5"></circle>
        </svg>
        <div class="legend"><span><i style="background:var(--ink)"></i>Värde</span><span><i style="height:0;border-top:2px dashed var(--oxblood)"></i>Pris</span></div>
        <div class="figtext">Priset svänger med humör. Värdet följer verksamheten. I gapet bor köpläget.</div>
      </figure>
    </section>

    <!-- ===== Onboarding (first visit only) ===== -->
    <section class="onboard" data-onboard hidden>
      <button class="onboard__x" type="button" data-onboard-dismiss aria-label="Stäng introduktionen">✕</button>
      <div class="onboard__kick">Välkommen</div>
      <h2 class="onboard__h">Så funkar kursen</h2>
      <div class="onboard__steps">
        <div class="ob"><span class="ob__n">1</span><div><b>Lär steg för steg</b><p>Korta steg per lektion: du läser och ser det viktiga visualiserat.</p></div></div>
        <div class="ob"><span class="ob__n">2</span><div><b>Testa dig själv</b><p>Ett kort quiz på slutet. Sikta på minst 80 procent rätt.</p></div></div>
        <div class="ob"><span class="ob__n">3</span><div><b>Följ din väg</b><p>Dina framsteg sparas automatiskt i den här webbläsaren.</p></div></div>
      </div>
    </section>

    <!-- Röd hero-piece: Ägarkollen som ingår, Börshuset dränkt i oxblod. Ligger
         högt, direkt efter heron, som medlemskapets löfte innan detaljerna. -->
    <a class="cta-band" href="/labs/dina-bolag.html">
      <div class="cta-band__k">Ägarkollen · ingår i medlemskapet</div>
      <h3 class="cta-band__h">Dina bolag lästa varje natt, varje siffra med källa.</h3>
      <span class="cta-band__go">Se förhandsvisningen →</span>
    </a>

    <!-- ===== Hub band: portföljen (förhandsvisning) + fortsätt kursen ===== -->
    <section class="hubband">
      <div class="hpanel">
        <div class="hph"><h2>Dina bolag</h2><span class="prevtag">Förhandsvisning</span></div>
        <a class="brow" href="/labs/dina-bolag.html">
          <span class="bdot neg"></span>
          <span class="bmid"><span class="bnm">Telvio</span><span class="bln">Marginalen gick under din gräns på 40 procent</span></span>
          <span class="brt">84,20<span class="bchg dn">-0,6%</span></span>
        </a>
        <a class="brow" href="/labs/dina-bolag.html">
          <span class="bdot pos"></span>
          <span class="bmid"><span class="bnm">Norlux Industri</span><span class="bln">Stark rapport, höjd prognos</span></span>
          <span class="brt">284,50<span class="bchg up">+1,8%</span></span>
        </a>
        <a class="brow" href="/labs/dina-bolag.html">
          <span class="bdot gold"></span>
          <span class="bmid"><span class="bnm">Kavex Medical</span><span class="bln">Insiderköp 2,1 Mkr, Q3 i dag</span></span>
          <span class="brt">156,00<span class="bchg up">+0,4%</span></span>
        </a>
        <div class="calmrow"><b>Lugnt i tre:</b> Voltcell, Brunna Hydro, Almi Foods.</div>
        <div class="hacts">
          <a class="hbtn" href="/labs/dina-bolag.html">Se Dina bolag →</a>
          <a class="hbtn" href="/labs/agarbrevet.html">Öppna Ägarbrevet →</a>
        </div>
        <p class="prevnote">Exempel med fiktiva bolag. Snart: dina egna innehav, lästa varje natt med källa till varje siffra.</p>
      </div>

      <div class="hpanel">
        <div class="hph"><h2>Fortsätt kursen</h2><a class="hph-link" href="/fokus">Kursöversikt →</a></div>
        <a class="hcont" data-continue-card href={firstHref}>
          <div>
            <div class="hcont-e" data-continue-eyebrow>Börja här, första lektionen</div>
            <div class="hcont-t" data-continue-title>Vad det innebär att äga en aktie</div>
            <div class="hcont-m" data-continue-meta>Lektion 1.1 · Investeringsfilosofi</div>
          </div>
          <span class="hcont-arr" aria-hidden="true">→</span>
        </a>
        <p class="hnote">Dina framsteg sparas i den här webbläsaren. Hela din väg genom kursen ligger nedanför.</p>
      </div>
    </section>

    <!-- ===== Repetition (shown when there are missed questions) ===== -->
    <a class="repcard" data-rep-card href="/repetera" hidden>
      <div>
        <div class="repcard__eyebrow">Repetition</div>
        <div class="repcard__h"><b data-rep-count>0</b> frågor att repetera</div>
        <div class="repcard__sub">Frågor du svarat fel på, samlade för en snabb omgång.</div>
      </div>
      <span class="repcard__cta" aria-hidden="true">→</span>
    </a>

    <!-- ===== Chapter map ===== -->
    <div class="sec-head">
      <h3>Din väg genom kursen</h3>
      <a href="/fokus">Hela innehållsförteckningen →</a>
    </div>
    <div class="index" data-chapter-map>
      {dashChapters.map((ch) => (
        <a class="ch" data-chapter-id={ch.nummer} href={ch.href}>
          <div class="ch-n">{String(ch.nummer).padStart(2, '0')}</div>
          <div>
            <div class="ch-t">{ch.titel}</div>
            <div class="ch-meta"><span data-card-count>0/{ch.ids.length}</span><span>klara</span></div>
          </div>
          <span class="pill" data-pill>Ej börjad</span>
        </a>
      ))}
    </div>

    <!-- ===== Tool ===== -->
    <div class="tool">
      <div class="l">
        <div class="e">Verktyget</div>
        <h4>Delägaren Analysverktyg</h4>
        <p>Den strukturerade checklistan du fyller i före ett aktieköp. Kvalitet, moat, värdering och felmarginal, på ett ställe.</p>
      </div>
      <a class="go" href="/verktyg">Öppna verktyget →</a>
    </div>

    <a class="txtkurs" href="/oversikt">Arkiv: den skrivna textkursen ({manifest.count} lektioner) →</a>
  </main>
</Broadsheet>

<style>
  /* Onboarding strip: numbered "how it works", shown only on first visit. */
  .onboard { position: relative; border: 1px solid var(--rule); background: var(--card); padding: 24px 28px; margin: 28px 0 0; }
  .onboard[hidden] { display: none; }
  .onboard__x { position: absolute; top: 10px; right: 12px; background: none; border: none; cursor: pointer; color: var(--muted); font-size: 14px; line-height: 1; padding: 8px; min-width: 36px; min-height: 36px; }
  .onboard__x:hover { color: var(--oxblood); }
  .onboard__kick { font-family: var(--mono); font-size: 10.5px; letter-spacing: .2em; text-transform: uppercase; color: var(--oxblood); }
  .onboard__h { font-family: var(--display); font-weight: 400; font-size: clamp(22px,2.6vw,28px); letter-spacing: -.01em; margin: 6px 0 18px; }
  .onboard__steps { display: grid; grid-template-columns: repeat(3,1fr); }
  .ob { display: flex; gap: 12px; padding: 2px 22px 2px 0; align-items: flex-start; }
  .ob + .ob { border-left: 1px solid var(--rule); padding-left: 22px; }
  .ob__n { font-family: var(--display); font-weight: 300; font-size: 26px; color: var(--oxblood); line-height: 1; flex: none; font-variant-numeric: lining-nums; }
  .ob b { font-family: var(--display); font-weight: 500; font-size: 16px; display: block; margin-bottom: 3px; }
  .ob p { font-size: 13.5px; line-height: 1.45; color: var(--ink-soft); margin: 0; }
  @media (max-width: 680px) {
    .onboard__steps { grid-template-columns: 1fr; }
    .ob + .ob { border-left: 0; border-top: 1px solid var(--rule); padding-left: 0; padding-top: 14px; margin-top: 14px; }
  }

  .feature { display: block; margin: 30px 0; padding: 30px 32px; background: var(--card); border: 1px solid var(--rule); position: relative; overflow: hidden; text-decoration: none; color: inherit; transition: transform .4s cubic-bezier(.2,.7,.2,1); }
  .feature::before { content: ""; position: absolute; inset: 6px; border: 1px solid var(--rule); pointer-events: none; }
  .feature:hover { transform: translateY(-3px); text-decoration: none; }
  .feature .row { display: flex; justify-content: space-between; align-items: center; gap: 30px; position: relative; }
  .feature .eyebrow { font-family: var(--mono); font-size: 10.5px; letter-spacing: .2em; text-transform: uppercase; color: var(--oxblood); margin-bottom: 10px; }
  .feature h2 { font-family: var(--display); font-weight: 400; font-size: clamp(24px,3vw,34px); line-height: 1.08; letter-spacing: -.01em; color: var(--ink); }
  .feature .meta { font-family: var(--mono); font-size: 11px; letter-spacing: .06em; color: var(--muted); margin-top: 14px; text-transform: uppercase; }
  .cta { flex: none; width: 62px; height: 62px; border-radius: 50%; border: 1.5px solid var(--ink); display: grid; place-items: center; font-size: 22px; color: var(--ink); transition: .35s cubic-bezier(.2,.7,.2,1); }
  .feature:hover .cta { background: var(--oxblood); border-color: var(--oxblood); color: var(--paper); transform: translateX(4px); }

  /* Repetition card: surfaces the SRS miss-queue, only when non-empty. */
  .datumrad { font-family: var(--mono); font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); margin: -8px 0 14px; }

  /* Börshusets fasad som dämpat tryck bakom heron, samma motiv som startsidan
     och /fokus. Ligger bakom hälsningen; figurplåten till höger är opak och
     står kvar ovanpå. */
  .hero { position: relative; isolation: isolate; }
  /* Börjar vid heroms överkant, precis under länkraden, aldrig uppe i navet. */
  .hero::before {
    content: ""; position: absolute; z-index: -1; inset: 0 -14px 0;
    background-image: url('/bilder/borshuset-1600.jpg'); background-size: cover; background-position: center 30%;
    filter: grayscale(1) contrast(1.03); opacity: .12;
    -webkit-mask: linear-gradient(178deg, #000 0%, #000 44%, transparent 92%);
    mask: linear-gradient(178deg, #000 0%, #000 44%, transparent 92%);
  }

  /* Hub-bandet: portföljen (förhandsvisning) bredvid fortsätt-kursen. Samma
     mönster som labs-mocken, in i den riktiga sidan. Portföljdelen är märkt
     exempel tills motorn matar riktig data; kurs-delen är skarp. */
  .hubband { display: grid; grid-template-columns: 1fr 1fr; gap: 0 48px; margin: 30px 0 0; }
  @media (max-width: 760px) { .hubband { grid-template-columns: 1fr; } }
  .hpanel { padding: 24px 0 10px; }
  @media (min-width: 761px) { .hubband .hpanel:last-child { border-left: 1px solid var(--rule); padding-left: 48px; } }
  @media (max-width: 760px) { .hubband .hpanel:last-child { border-top: 1px solid var(--rule); padding-top: 20px; } }
  .hph { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 8px; }
  .hph h2 { font-family: var(--mono); font-weight: 500; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .prevtag { font-family: var(--mono); font-size: 9px; letter-spacing: .1em; text-transform: uppercase; color: var(--gold); border: 1px solid var(--rule-strong); padding: 3px 8px; }
  .hph-link { font-family: var(--mono); font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--oxblood); text-decoration: none; }
  .hph-link:hover { color: var(--ink); text-decoration: none; }

  .brow { display: grid; grid-template-columns: 12px 1fr auto; gap: 12px; align-items: baseline; padding: 12px 2px; border-top: 1px solid var(--rule); text-decoration: none; color: inherit; transition: background .14s; }
  .brow:hover { background: var(--card); text-decoration: none; }
  .bdot { width: 8px; height: 8px; border-radius: 50%; position: relative; top: 4px; }
  .bdot.neg { background: var(--bad); } .bdot.pos { background: var(--good); } .bdot.gold { background: var(--gold); }
  .bmid { min-width: 0; }
  .bnm { display: block; font-family: var(--display); font-weight: 500; font-size: 16px; }
  .bln { display: block; color: var(--muted); font-size: 13.5px; margin-top: 2px; }
  .brt { text-align: right; font-family: var(--mono); font-size: 13px; font-variant-numeric: tabular-nums; white-space: nowrap; color: var(--ink); }
  .bchg { font-size: 11px; margin-left: 6px; } .bchg.up { color: var(--good); } .bchg.dn { color: var(--bad); }
  .calmrow { padding: 12px 2px; border-top: 1px solid var(--rule); font-size: 13.5px; color: var(--muted); }
  .calmrow b { color: var(--ink-soft); font-weight: 500; }
  .hacts { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 16px; }
  .hbtn { font-family: var(--mono); font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-soft); border: 1px solid var(--rule-strong); padding: 11px 16px; border-radius: 99px; text-decoration: none; transition: border-color .2s, color .2s; }
  .hbtn:hover { border-color: var(--oxblood); color: var(--oxblood); text-decoration: none; }
  .prevnote { font-family: var(--mono); font-size: 10.5px; line-height: 1.6; color: var(--faint); margin-top: 14px; max-width: 46ch; }

  .hcont { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 18px 20px; background: var(--card); border: 1px solid var(--rule); text-decoration: none; color: inherit; transition: transform .25s cubic-bezier(.2,.7,.2,1); }
  .hcont:hover { transform: translateX(3px); text-decoration: none; }
  .hcont-e { font-family: var(--mono); font-size: 9.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--oxblood); margin-bottom: 5px; }
  .hcont-t { font-family: var(--display); font-weight: 500; font-size: 18px; line-height: 1.2; }
  .hcont-m { font-family: var(--mono); font-size: 11px; letter-spacing: .04em; color: var(--muted); margin-top: 6px; }
  .hcont-arr { font-family: var(--display); font-size: 22px; color: var(--ink); flex: none; }
  .hcont:hover .hcont-arr { color: var(--oxblood); }
  .hnote { font-size: 13px; color: var(--muted); margin-top: 14px; max-width: 42ch; }

  .repcard { display: flex; justify-content: space-between; align-items: center; gap: 24px; margin: 16px 0 0; padding: 18px 22px; background: var(--card); border: 1px solid var(--rule); border-top: 2px solid var(--oxblood); text-decoration: none; color: inherit; transition: transform .25s cubic-bezier(.2,.7,.2,1); }
  .repcard[hidden] { display: none; }
  .repcard:hover { transform: translateX(3px); text-decoration: none; }
  .repcard__eyebrow { font-family: var(--mono); font-size: 10.5px; letter-spacing: .2em; text-transform: uppercase; color: var(--oxblood); margin-bottom: 6px; }
  .repcard__h { font-family: var(--display); font-weight: 400; font-size: 22px; letter-spacing: -.01em; }
  .repcard__h b { font-weight: 500; font-variant-numeric: tabular-nums; }
  .repcard__sub { font-family: var(--mono); font-size: 11px; letter-spacing: .04em; color: var(--muted); margin-top: 6px; }
  .repcard__cta { font-family: var(--display); font-size: 22px; color: var(--oxblood); flex: none; }

  .sec-head { display: flex; justify-content: space-between; align-items: baseline; margin: 46px 0 10px; border-bottom: 2px solid var(--ink); padding-bottom: 10px; }
  .sec-head h3 { font-family: var(--display); font-weight: 400; font-size: 24px; letter-spacing: -.01em; }
  .sec-head a { font-family: var(--mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--oxblood); text-decoration: none; }
  .sec-head a:hover { text-decoration: none; color: var(--ink); }

  /* dashboard chapter map: number coloring keys off computed state classes */
  .ch.act .ch-n, .ch.done .ch-n { color: var(--oxblood); }

  .tool { margin: 40px 0 24px; border-top: 2px solid var(--ink); padding-top: 22px; display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
  .tool .l .e { font-family: var(--mono); font-size: 10.5px; letter-spacing: .2em; text-transform: uppercase; color: var(--oxblood); }
  .tool .l h4 { font-family: var(--display); font-weight: 400; font-size: 24px; margin-top: 6px; }
  .tool .l p { color: var(--ink-soft); max-width: 52ch; margin-top: 6px; font-size: 15.5px; }
  .tool .go { font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--paper); background: var(--ink); padding: 14px 22px; text-decoration: none; white-space: nowrap; transition: background .25s; }
  .tool .go:hover { background: var(--oxblood); text-decoration: none; }

  /* Röd hero-piece: Börshuset dränkt i oxblod, samma foto som startsidan men
     andra behandlingen. Färg och bild i ett, inte bara den gråa fasaden. */
  .cta-band { display: block; margin: 46px 0 30px; padding: 44px clamp(24px,5vw,52px); text-decoration: none; position: relative; overflow: hidden;
    background: linear-gradient(rgba(122,38,30,.90), rgba(96,28,22,.93)), url('/bilder/borshuset-1600.jpg') center 40% / cover; }
  .cta-band__k { font-family: var(--mono); font-size: 10.5px; letter-spacing: .2em; text-transform: uppercase; color: rgba(251,247,238,.82); margin-bottom: 12px; }
  .cta-band__h { font-family: var(--slab); font-weight: 500; font-size: clamp(23px,3.2vw,33px); line-height: 1.16; letter-spacing: -.005em; color: #FBF7EE; max-width: 24ch; }
  .cta-band__go { display: inline-block; margin-top: 22px; font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: #FBF7EE; border: 1px solid rgba(251,247,238,.5); padding: 13px 22px; border-radius: 99px; transition: background .25s, color .25s; }
  .cta-band:hover .cta-band__go { background: #FBF7EE; color: var(--oxblood); }
  .cta-band:focus-visible { outline: 2px solid #FBF7EE; outline-offset: 3px; }

  .txtkurs { display: block; text-align: center; font-family: var(--mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); padding: 0 0 50px; text-decoration: none; }
  .txtkurs:hover { color: var(--oxblood); text-decoration: none; }
</style>

<script>
  import { getFokusDone, firstIncomplete, FOKUS_EVENT } from '../scripts/fokus-progress';
  import { getStreak, META_EVENT } from '../scripts/state';
  import { getMissed, SRS_EVENT } from '../scripts/srs';

  function el<T extends HTMLElement = HTMLElement>(sel: string): T | null {
    return document.querySelector<T>(sel);
  }

  function paint() {
    const lessonsEl = el('[data-dash-lessons]');
    const orderEl = el('[data-fokus-order]');
    if (!lessonsEl || !orderEl) return;

    const lessons = JSON.parse(lessonsEl.textContent || '[]') as Array<{
      lektion: string; titel: string; niva: string; tid_min: number; kapitelTitel: string; href: string;
    }>;
    const fokusOrder = JSON.parse(orderEl.textContent || '[]') as string[];
    const total = lessons.length;

    // Greeting
    const h = new Date().getHours();
    const greet = h < 10 ? 'God morgon' : h < 18 ? 'God dag' : 'God kväll';
    const g = el('[data-greeting]');
    if (g) g.textContent = greet;

    // Stats
    const done = getFokusDone();
    const doneCount = done.filter((id) => fokusOrder.includes(id)).length;
    const pct = total ? Math.round((doneCount / total) * 100) : 0;
    const streak = getStreak();

    const sd = el('[data-stat-done]'); if (sd) sd.textContent = String(doneCount);
    const sp = el('[data-stat-pct]'); if (sp) sp.textContent = pct + '%';
    const ss = el('[data-stat-streak]'); if (ss) ss.textContent = String(streak);

    // First-visit onboarding strip: only when nothing is done and not dismissed.
    const onboard = el('[data-onboard]');
    if (onboard) {
      let dismissed = false;
      try { dismissed = localStorage.getItem('kurs:onboard:done') === '1'; } catch {}
      onboard.hidden = !(doneCount === 0 && !dismissed);
    }

    // Repetition card: show only when the miss-queue is non-empty.
    const repCard = el('[data-rep-card]');
    if (repCard) {
      const n = getMissed().length;
      const cnt = el('[data-rep-count]'); if (cnt) cnt.textContent = String(n);
      repCard.hidden = n === 0;
    }

    // Continue
    const incompleteId = firstIncomplete(fokusOrder);
    const targetId = incompleteId ?? fokusOrder[0] ?? null;
    const lesson = targetId ? lessons.find((l) => l.lektion === targetId) : null;
    const current = lesson || lessons[0] || null;
    if (current) {
      const card = el<HTMLAnchorElement>('[data-continue-card]');
      if (card) card.href = current.href;
      // First visit (no lessons done) reads as "start here", not "resume".
      const eb = el('[data-continue-eyebrow]');
      if (eb) eb.textContent = doneCount > 0 ? 'Fortsätt där du slutade' : 'Börja här, första lektionen';
      const ct = el('[data-continue-title]'); if (ct) ct.textContent = current.titel;
      const cm = el('[data-continue-meta]');
      if (cm) cm.textContent = `Lektion ${current.lektion} · ${current.kapitelTitel}`;
    }

    // Chapter map
    const chaptersEl = el('[data-dash-chapters]');
    if (chaptersEl) {
      const chapters = JSON.parse(chaptersEl.textContent || '[]') as Array<{ nummer: number; titel: string; href: string; ids: string[] }>;
      const doneSet = new Set(done);
      chapters.forEach((ch) => {
        const cardEl = el<HTMLElement>(`[data-chapter-id="${ch.nummer}"]`);
        if (!cardEl) return;
        const tot = ch.ids.length;
        const dn = ch.ids.filter((id) => doneSet.has(id)).length;
        const state = dn >= tot && tot > 0 ? 'done' : dn > 0 ? 'act' : 'open';
        cardEl.classList.remove('done', 'act');
        if (state === 'done') cardEl.classList.add('done');
        else if (state === 'act') cardEl.classList.add('act');
        const countEl = cardEl.querySelector<HTMLElement>('[data-card-count]');
        if (countEl) countEl.textContent = `${dn}/${tot}`;
        const pillEl = cardEl.querySelector<HTMLElement>('[data-pill]');
        if (pillEl) {
          pillEl.classList.remove('done', 'act', 'lock');
          if (state === 'done') { pillEl.classList.add('done'); pillEl.textContent = 'Klar'; }
          else if (state === 'act') { pillEl.classList.add('act'); pillEl.textContent = 'Pågår'; }
          else pillEl.textContent = 'Ej börjad';
        }
      });
    }
  }

  function wireOnboard() {
    const btn = document.querySelector<HTMLButtonElement>('[data-onboard-dismiss]');
    if (!btn || btn.dataset.wired) return;
    btn.dataset.wired = '1';
    btn.addEventListener('click', () => {
      try { localStorage.setItem('kurs:onboard:done', '1'); } catch {}
      const ob = document.querySelector<HTMLElement>('[data-onboard]');
      if (ob) ob.hidden = true;
    });
  }

  document.addEventListener('astro:page-load', () => { paint(); wireOnboard(); });
  window.addEventListener(META_EVENT, paint);
  window.addEventListener(FOKUS_EVENT, paint);
  window.addEventListener(SRS_EVENT, paint);
</script>

<script data-datumrad-script>
  document.addEventListener('astro:page-load', () => {
    const el = document.querySelector('[data-datumrad]');
    if (!el) return;
    const t = new Date().toLocaleDateString('sv-SE', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
    el.textContent = t.charAt(0).toUpperCase() + t.slice(1);
  });
</script>
