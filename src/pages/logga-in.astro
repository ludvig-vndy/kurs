---
import Broadsheet from '../layouts/Broadsheet.astro';
import Seal from '../components/Seal.astro';

// Inloggningsyta for aterkommande medlemmar: mejl -> magisk lank (login-lage,
// skapar inte konto). Sajtlosenordet ar en separat grind; det har ar kontot.
---

<Broadsheet title="Logga in · Delägaren" description="Logga in på ditt Delägaren-konto med en inloggningslänk." nav="none" chrome="none" open>
  <main class="li">
    <div class="li-card">
      <Seal size="lg" href="/" />
      <h1 class="li-h">Logga in</h1>
      <p class="li-sub">Skriv din mejl, så skickar vi en inloggningslänk. Inget lösenord att komma ihåg.</p>

      <form id="li-form" class="li-form" novalidate>
        <input id="li-email" type="email" required placeholder="din@mejl.se" autocomplete="email" aria-label="Mejladress" />
        <button class="btn-ink" type="submit">Skicka länk →</button>
      </form>
      <p id="li-msg" class="li-msg" role="status" hidden></p>

      <!-- Andra vagen in: koden ur samma mejl, ifall lanken inte tar dig hela vagen. -->
      <form id="li-code" class="li-code" novalidate hidden>
        <p class="li-code-lead">Krånglar länken? Skriv 6-siffriga koden ur mejlet.</p>
        <div class="li-code-row">
          <input id="li-otp" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]*" maxlength="6" placeholder="123456" aria-label="Inloggningskod" />
          <button class="btn-ink" type="submit">Logga in →</button>
        </div>
        <p id="li-code-msg" class="li-msg" role="status" hidden></p>
      </form>

      <!-- Robust väg: e-post + lösenord, hänger inte på mejl eller länkar. -->
      <button id="li-pw-toggle" class="li-link" type="button">Logga in med lösenord istället →</button>
      <form id="li-pw" class="li-code" novalidate hidden>
        <p class="li-code-lead">Logga in med e-post och lösenord.</p>
        <input id="li-pw-email" type="email" required placeholder="din@mejl.se" autocomplete="email" aria-label="Mejladress" />
        <div class="li-code-row">
          <input id="li-pw-pass" type="password" required placeholder="Lösenord" autocomplete="current-password" aria-label="Lösenord" />
          <button class="btn-ink" type="submit">Logga in →</button>
        </div>
        <p id="li-pw-msg" class="li-msg" role="status" hidden></p>
      </form>

      <p class="li-fine">Har du fått en inbjudan men inget konto än? <a href="/labs/inbjudan-i-marginalen.html">Aktivera inbjudan →</a></p>
    </div>
  </main>

  <script defer src="/vendor/supabase-js-2.110.2.min.js"></script>
  <script defer src="/labs/agarbrevet-supabase.js"></script>
  <script>
    // Magic-länken kan slutföras HELT utan supabase-js: implicit-flödet lägger
    // access-token i URL-hashen (#access_token=...). Läs den direkt, sätt
    // da_session-cookien och gå in. Robust även om den tunga klienten inte
    // laddar på enheten (gammal Safari, blockerare). Kör omedelbart vid load.
    (function () {
      try {
        var m = /[#&]access_token=([^&]+)/.exec(location.hash || '');
        if (m && m[1]) {
          document.cookie = 'da_session=' + decodeURIComponent(m[1]) + '; path=/; max-age=3600; SameSite=Lax; Secure';
          location.replace('/hem');
        }
      } catch (e) {}
    })();

    // Kod-som-andra-vag-in kraver att Supabase-mejlmallen visar {{ .Token }},
    // vilket i sin tur kraver custom SMTP. Tills det ar pa plats halls kodfaltet
    // dolt sa vi inte ber om en kod som inte finns i mejlet. Flippa till true
    // nar SMTP + mallen ar klara.
    const CODE_LOGIN_ENABLED = false;

    // Vantar in att Supabase-klienten (window.AB) blir redo, i stallet for att
    // skramma direkt om den deferrade bundeln inte hunnit ladda. ~5s tak.
    function waitForAB() {
      return new Promise((resolve) => {
        if (window.AB && window.AB.ready) return resolve(true);
        let n = 0;
        const iv = setInterval(() => {
          if (window.AB && window.AB.ready) { clearInterval(iv); resolve(true); }
          else if (++n > 50) { clearInterval(iv); resolve(false); }
        }, 100);
      });
    }

    // Satt cookie fran token och skicka in till /hem. Delas av kod- och
    // lank-vagen (watchSession).
    function enterWithToken(t) {
      document.cookie = 'da_session=' + t + '; path=/; max-age=3600; SameSite=Lax; Secure';
      location.replace('/hem');
    }

    function bindLogin() {
      const form = document.getElementById('li-form');
      if (!form || form.dataset.bound) return;
      form.dataset.bound = '1';
      const email = document.getElementById('li-email');
      const msg = document.getElementById('li-msg');
      const codeForm = document.getElementById('li-code');
      const show = (t) => { msg.hidden = false; msg.textContent = t; };
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const v = (email.value || '').trim();
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) { show('Skriv en giltig mejladress.'); return; }
        show('Skickar…');
        try {
          const ready = await waitForAB();
          if (!ready) { show('Tjänsten kunde inte laddas. Ladda om sidan och försök igen.'); return; }
          // Magic-länken returnerar hit (/logga-in ar publik); vi satter cookien
          // och skickar in till /hem nar sessionen dykt upp.
          const r = await window.AB.sendMagicLink(v, { createUser: false, redirectPath: '/logga-in' });
          if (r && r.error) { show('Kunde inte skicka just nu. Har du ett konto med den mejlen?'); }
          else {
            show('Klart. Kolla din mejl, vi skickade en inloggningslänk' + (CODE_LOGIN_ENABLED ? ' och en kod' : '') + ' till ' + v + '.');
            // Andra vagen in: kod ur samma mejl. Kom ihag mejlen sa verifyOtp
            // kan bindas till den. Dold tills SMTP + mall ar pa plats.
            if (CODE_LOGIN_ENABLED && codeForm) { codeForm.hidden = false; codeForm.dataset.email = v; }
          }
        } catch (err) { show('Något gick fel. Försök igen om en stund.'); }
      });
    }

    function bindCode() {
      const codeForm = document.getElementById('li-code');
      if (!codeForm || codeForm.dataset.bound) return;
      codeForm.dataset.bound = '1';
      const otp = document.getElementById('li-otp');
      const cmsg = document.getElementById('li-code-msg');
      const show = (t) => { cmsg.hidden = false; cmsg.textContent = t; };
      codeForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = (codeForm.dataset.email || '').trim();
        const code = (otp.value || '').replace(/\D/g, '');
        if (code.length !== 6) { show('Koden är 6 siffror.'); return; }
        if (!email) { show('Fyll i din mejl ovan och skicka först.'); return; }
        show('Loggar in…');
        try {
          if (!(window.AB && window.AB.verifyCode)) { show('Tjänsten laddar fortfarande, försök igen om en sekund.'); return; }
          const r = await window.AB.verifyCode(email, code);
          const t = r && r.data && r.data.session && r.data.session.access_token;
          if (r && r.error) { show('Fel eller utgången kod. Dubbelkolla siffrorna i mejlet.'); }
          else if (t) { enterWithToken(t); }
          else { show('Kunde inte logga in. Prova länken i mejlet istället.'); }
        } catch (err) { show('Något gick fel. Försök igen om en stund.'); }
      });
    }
    function bindPassword() {
      const toggle = document.getElementById('li-pw-toggle');
      const form = document.getElementById('li-pw');
      if (!toggle || !form || toggle.dataset.bound) return;
      toggle.dataset.bound = '1';
      toggle.addEventListener('click', () => {
        const open = form.hidden;
        form.hidden = !open;
        toggle.hidden = open; // dölj länken när formuläret öppnats
        if (open) {
          const pre = (document.getElementById('li-email').value || '').trim();
          if (pre) document.getElementById('li-pw-email').value = pre;
          document.getElementById('li-pw-email').focus();
        }
      });
      const email = document.getElementById('li-pw-email');
      const pass = document.getElementById('li-pw-pass');
      const msg = document.getElementById('li-pw-msg');
      const show = (t) => { msg.hidden = false; msg.textContent = t; };
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const em = (email.value || '').trim();
        const pw = pass.value || '';
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(em)) { show('Skriv en giltig mejladress.'); return; }
        if (!pw) { show('Skriv ditt lösenord.'); return; }
        show('Loggar in…');
        try {
          const ready = await waitForAB();
          if (!ready || !window.AB.signInPassword) { show('Tjänsten kunde inte laddas. Ladda om sidan och försök igen.'); return; }
          const r = await window.AB.signInPassword(em, pw);
          const t = r && r.data && r.data.session && r.data.session.access_token;
          if (r && r.error) { show('Fel mejl eller lösenord.'); }
          else if (t) { enterWithToken(t); }
          else { show('Kunde inte logga in. Försök igen.'); }
        } catch (err) { show('Något gick fel. Försök igen om en stund.'); }
      });
    }

    // Redan inloggad, eller precis inloggad via magic-länk -> sätt cookie + in.
    function watchSession() {
      let n = 0;
      const iv = setInterval(() => {
        try {
          const raw = localStorage.getItem('sb-xpxghvxrckpzbbkjmtcw-auth-token');
          if (raw) {
            const o = JSON.parse(raw);
            const t = o.access_token || (o.currentSession && o.currentSession.access_token);
            if (t) { clearInterval(iv); enterWithToken(t); }
          }
        } catch (e) {}
        if (++n > 40) clearInterval(iv);  // ~12s
      }, 300);
    }
    document.addEventListener('astro:page-load', () => { bindLogin(); bindCode(); bindPassword(); watchSession(); });
  </script>
</Broadsheet>

<style>
  .li { flex: 1; display: flex; align-items: center; justify-content: center; padding: clamp(30px, 8vh, 90px) 0; }
  .li-card { width: 100%; max-width: 440px; text-align: center; }
  .li-card .seal { margin: 0 auto 30px; }
  .li-h { font-family: var(--slab); font-weight: 600; font-size: clamp(30px, 5vw, 40px); letter-spacing: -.01em; margin: 0; }
  .li-sub { font-family: var(--serif); font-size: 16.5px; line-height: 1.5; color: var(--ink-soft); margin: 12px auto 26px; max-width: 34ch; }
  .li-form { display: flex; gap: 10px; flex-wrap: wrap; }
  .li-form input { flex: 1; min-width: 0; border: 1px solid var(--rule-strong); background: var(--card); font-family: var(--serif); font-size: 16px; color: var(--ink); padding: 13px 16px; }
  .li-form input:focus { outline: none; border-color: var(--oxblood); }
  .li-form .btn-ink { flex: 0 0 auto; }
  .li-msg { font-family: var(--mono); font-size: 12.5px; letter-spacing: .02em; color: var(--oxblood); margin: 16px 0 0; }
  .li-code { margin: 22px 0 0; padding: 20px 0 0; border-top: 1px solid var(--rule); text-align: left; }
  .li-code-lead { font-family: var(--serif); font-size: 14.5px; line-height: 1.5; color: var(--ink-soft); margin: 0 0 12px; }
  .li-code-row { display: flex; gap: 10px; flex-wrap: wrap; }
  .li-code-row input { flex: 1; min-width: 0; border: 1px solid var(--rule-strong); background: var(--card); font-family: var(--mono); font-size: 17px; letter-spacing: .3em; color: var(--ink); padding: 13px 16px; }
  .li-code-row input:focus { outline: none; border-color: var(--oxblood); }
  .li-code-row .btn-ink { flex: 0 0 auto; }
  .li-code .li-msg { margin: 12px 0 0; }
  @media (max-width: 460px) { .li-code-row { flex-direction: column; } .li-code-row .btn-ink { width: 100%; justify-content: center; } }
  .li-link { display: inline-block; margin: 18px 0 0; background: none; border: 0; padding: 0; cursor: pointer; font-family: var(--mono); font-size: 11.5px; letter-spacing: .04em; color: var(--ink-soft); }
  .li-link:hover { color: var(--oxblood); }
  #li-pw input[type="email"] { width: 100%; border: 1px solid var(--rule-strong); background: var(--card); font-family: var(--serif); font-size: 16px; color: var(--ink); padding: 13px 16px; margin: 0 0 10px; }
  #li-pw input[type="email"]:focus { outline: none; border-color: var(--oxblood); }
  .li-fine { font-family: var(--mono); font-size: 11px; letter-spacing: .04em; color: var(--muted); margin: 28px 0 0; }
  .li-fine a { color: var(--ink-soft); }
  .li-fine a:hover { color: var(--oxblood); }
  @media (max-width: 460px) { .li-form { flex-direction: column; } .li-form .btn-ink { width: 100%; justify-content: center; } }
</style>
