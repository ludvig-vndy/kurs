---
interface QuizFraga {
  fraga: string;
  svar: string[];
  ratt: number | number[];
  forklaring?: string;
}
interface Props {
  quiz: QuizFraga[];
  lessonId: string;
}
const { quiz, lessonId } = Astro.props;

const norm = quiz.map((q) => {
  const correct = Array.isArray(q.ratt) ? q.ratt : [q.ratt];
  return { ...q, correct, multi: correct.length > 1 || Array.isArray(q.ratt) };
});
const passMark = 80;
---

<section class="quiz" data-quiz data-quiz-id={lessonId} data-pass={passMark} data-reveal>
  <div class="quiz__head">
    <span class="quiz__eyebrow">Kunskapskoll</span>
    <h2 class="quiz__title">Testa dig själv</h2>
    <p class="quiz__lede">
      {norm.length} {norm.length === 1 ? 'fråga' : 'frågor'}. Godkänt vid {passMark}% rätt.
    </p>
  </div>

  <ol class="quiz__list">
    {
      norm.map((q, qi) => (
        <li
          class="q"
          data-q
          data-correct={JSON.stringify(q.correct)}
          data-multi={String(q.multi)}
        >
          <fieldset class="q__fieldset">
            <legend class="q__legend">
              <span class="q__num">{qi + 1}</span>
              <span>{q.fraga}</span>
            </legend>
            <div
              class="opts"
              role={q.multi ? 'group' : 'radiogroup'}
              aria-label={q.fraga}
            >
              {q.svar.map((s, oi) => (
                <label class="opt" data-opt data-i={oi}>
                  <input
                    class="opt__input"
                    type={q.multi ? 'checkbox' : 'radio'}
                    name={`q-${lessonId}-${qi}`}
                    value={oi}
                  />
                  <span class="opt__marker" aria-hidden="true" />
                  <span class="opt__text">{s}</span>
                  <span class="opt__icon" aria-hidden="true">
                    <svg class="i-ok" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" /></svg>
                    <svg class="i-no" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" /></svg>
                  </span>
                </label>
              ))}
            </div>
            <div class="q__feedback" data-feedback hidden aria-live="polite">
              <span class="q__verdict" data-verdict />
              {q.forklaring && <span class="q__why">{q.forklaring}</span>}
            </div>
          </fieldset>
        </li>
      ))
    }
  </ol>

  <div class="quiz__actions">
    <button type="button" class="btn btn--primary" data-check disabled>Rätta svar</button>
    <button type="button" class="btn btn--ghost" data-retry hidden>Gör om</button>
  </div>

  <div class="quiz__result" data-result hidden role="status" aria-live="polite">
    <div class="result__ring" data-ring>
      <span class="result__pct" data-result-pct>0%</span>
    </div>
    <div class="result__text">
      <strong data-result-head>—</strong>
      <span data-result-sub class="result__sub" />
    </div>
  </div>
</section>

<style>
  .quiz {
    margin: var(--space-8) 0 0;
    padding: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    font-family: var(--font-sans);
  }
  .quiz__eyebrow {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  .quiz__title {
    font-size: var(--text-xl);
    margin: var(--space-2) 0 var(--space-1);
  }
  .quiz__lede {
    margin: 0 0 var(--space-5);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .quiz__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .q__fieldset {
    border: none;
    margin: 0;
    padding: 0;
  }
  .q__legend {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    font-size: var(--text-md);
    font-weight: 550;
    line-height: 1.4;
    margin-bottom: var(--space-3);
    padding: 0;
    color: var(--text);
  }
  .q__num {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border-radius: var(--radius-full);
    background: var(--accent-soft);
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .opts {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .opt {
    display: grid;
    grid-template-columns: 20px 1fr auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-elev);
    cursor: pointer;
    transition:
      border-color var(--dur-micro) var(--ease-standard),
      background var(--dur-micro) var(--ease-standard);
  }
  .opt:hover {
    border-color: var(--border-strong);
  }
  .opt__input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }
  .opt__marker {
    width: 18px;
    height: 18px;
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-full);
    transition:
      border-color var(--dur-micro) var(--ease-standard),
      box-shadow var(--dur-micro) var(--ease-standard);
  }
  [data-multi='true'] .opt__marker {
    border-radius: var(--radius-sm);
  }
  .opt:has(.opt__input:checked) {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .opt:has(.opt__input:checked) .opt__marker {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 4px var(--accent);
  }
  [data-multi='true'] .opt:has(.opt__input:checked) .opt__marker {
    box-shadow: inset 0 0 0 9px var(--accent);
  }
  .opt__text {
    font-size: var(--text-base);
    line-height: 1.4;
    color: var(--text);
  }

  .opt__icon {
    width: 20px;
    height: 20px;
    display: none;
  }
  .opt__icon svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .opt__icon .i-ok { stroke: var(--ok); display: none; }
  .opt__icon .i-no { stroke: var(--err); display: none; }

  /* Efter rättning */
  .quiz.is-graded .opt {
    cursor: default;
    pointer-events: none;
  }
  .opt.is-correct {
    border-color: var(--ok-border);
    background: var(--ok-bg);
  }
  .opt.is-correct .opt__icon { display: block; }
  .opt.is-correct .opt__icon .i-ok { display: block; }
  .opt.is-wrong {
    border-color: var(--err-border);
    background: var(--err-bg);
  }
  .opt.is-wrong .opt__icon { display: block; }
  .opt.is-wrong .opt__icon .i-no { display: block; }
  .opt.is-wrong {
    animation: shake 250ms var(--ease-standard);
  }
  .opt.is-correct.is-picked {
    animation: pop 220ms var(--ease-out);
  }
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-3px); }
    75% { transform: translateX(3px); }
  }
  @keyframes pop {
    0% { transform: scale(1); }
    45% { transform: scale(1.025); }
    100% { transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .opt.is-wrong, .opt.is-correct.is-picked { animation: none; }
  }

  .q__feedback {
    margin-top: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--bg-elev);
    border: 1px solid var(--border);
    font-size: var(--text-sm);
    line-height: 1.5;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .q__verdict { font-weight: 600; }
  .q__verdict[data-ok='true'] { color: var(--ok); }
  .q__verdict[data-ok='false'] { color: var(--err); }
  .q__why { color: var(--text-muted); }

  .quiz__actions {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .btn {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--text-base);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-full);
    cursor: pointer;
    border: 1px solid transparent;
    transition:
      background var(--dur-micro) var(--ease-standard),
      transform var(--dur-micro) var(--ease-out),
      border-color var(--dur-micro) var(--ease-standard);
  }
  .btn:active { transform: scale(0.98); }
  .btn--primary {
    background: var(--text);
    color: var(--bg);
  }
  .btn--primary:hover { opacity: 0.88; }
  .btn--primary:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .btn--primary:disabled:hover { opacity: 0.35; }
  .btn--ghost {
    background: transparent;
    border-color: var(--border-2);
    color: var(--muted);
  }
  .btn--ghost:hover { border-color: var(--mint); color: var(--mint); }

  .quiz__result {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-6);
    padding: var(--space-5);
    border-radius: var(--radius-md);
    background: var(--bg-elev);
    border: 1px solid var(--border);
  }
  .result__ring {
    --pct: 0;
    position: relative;
    width: 76px;
    height: 76px;
    border-radius: var(--radius-full);
    flex-shrink: 0;
    display: grid;
    place-items: center;
    background: conic-gradient(
      var(--ring-color, var(--accent)) calc(var(--pct) * 1%),
      var(--surface-2) 0
    );
    transition: --pct var(--dur-comp) var(--ease-out);
  }
  .result__ring::after {
    content: '';
    position: absolute;
    inset: 8px;
    border-radius: var(--radius-full);
    background: var(--bg-elev);
  }
  .result__pct {
    position: relative;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    font-size: var(--text-md);
    color: var(--text);
  }
  .result__text { display: flex; flex-direction: column; gap: 2px; }
  .result__text strong { font-size: var(--text-lg); }
  .result__sub { color: var(--text-muted); font-size: var(--text-sm); }

  @property --pct {
    syntax: '<number>';
    inherits: false;
    initial-value: 0;
  }
</style>

<script>
  import { setQuizPct } from '../scripts/progress';

  function grade(quiz: HTMLElement) {
    const questions = Array.from(quiz.querySelectorAll<HTMLElement>('[data-q]'));
    let correctCount = 0;

    questions.forEach((q) => {
      const correct: number[] = JSON.parse(q.dataset.correct || '[]');
      const inputs = Array.from(q.querySelectorAll<HTMLInputElement>('.opt__input'));
      const picked = inputs.filter((i) => i.checked).map((i) => Number(i.value));

      const pickedSet = new Set(picked);
      const correctSet = new Set(correct);
      const isRight =
        picked.length === correct.length &&
        [...correctSet].every((c) => pickedSet.has(c));
      if (isRight) correctCount++;

      inputs.forEach((input) => {
        const opt = input.closest<HTMLElement>('.opt')!;
        const i = Number(input.value);
        const shouldBe = correctSet.has(i);
        const was = pickedSet.has(i);
        opt.classList.toggle('is-correct', shouldBe);
        opt.classList.toggle('is-wrong', was && !shouldBe);
        if (was) opt.classList.add('is-picked');
      });

      const fb = q.querySelector<HTMLElement>('[data-feedback]')!;
      const verdict = q.querySelector<HTMLElement>('[data-verdict]')!;
      verdict.textContent = isRight ? 'Rätt' : picked.length ? 'Inte riktigt' : 'Obesvarad';
      verdict.dataset.ok = String(isRight);
      fb.hidden = false;
    });

    const pct = Math.round((correctCount / questions.length) * 100);
    const pass = Number(quiz.dataset.pass || '80');
    const passed = pct >= pass;

    quiz.classList.add('is-graded');
    const result = quiz.querySelector<HTMLElement>('[data-result]')!;
    const ring = quiz.querySelector<HTMLElement>('[data-ring]')!;
    ring.style.setProperty('--pct', String(pct));
    ring.style.setProperty('--ring-color', passed ? 'var(--ok)' : 'var(--err)');
    quiz.querySelector<HTMLElement>('[data-result-pct]')!.textContent = pct + '%';
    quiz.querySelector<HTMLElement>('[data-result-head]')!.textContent = passed
      ? 'Godkänt!'
      : 'Nästan där';
    quiz.querySelector<HTMLElement>('[data-result-sub]')!.textContent = `${correctCount} av ${questions.length} rätt${passed ? '' : ` — ${pass}% krävs`}`;
    result.hidden = false;

    quiz.querySelector<HTMLButtonElement>('[data-check]')!.hidden = true;
    quiz.querySelector<HTMLButtonElement>('[data-retry]')!.hidden = false;

    const id = quiz.dataset.quizId!;
    if (id) setQuizPct(id, pct);

    result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function reset(quiz: HTMLElement) {
    quiz.classList.remove('is-graded');
    quiz.querySelectorAll<HTMLInputElement>('.opt__input').forEach((i) => (i.checked = false));
    quiz.querySelectorAll<HTMLElement>('.opt').forEach((o) =>
      o.classList.remove('is-correct', 'is-wrong', 'is-picked')
    );
    quiz.querySelectorAll<HTMLElement>('[data-feedback]').forEach((f) => (f.hidden = true));
    quiz.querySelector<HTMLElement>('[data-result]')!.hidden = true;
    quiz.querySelector<HTMLButtonElement>('[data-check]')!.hidden = false;
    quiz.querySelector<HTMLButtonElement>('[data-retry]')!.hidden = true;
    quiz.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function allAnswered(quiz: HTMLElement): boolean {
    const questions = Array.from(quiz.querySelectorAll<HTMLElement>('[data-q]'));
    return questions.every((q) => {
      const inputs = Array.from(q.querySelectorAll<HTMLInputElement>('.opt__input'));
      return inputs.some((i) => i.checked);
    });
  }

  function wire() {
    document.querySelectorAll<HTMLElement>('[data-quiz]').forEach((quiz) => {
      if (quiz.dataset.wired) return;
      quiz.dataset.wired = '1';
      const checkBtn = quiz.querySelector<HTMLButtonElement>('[data-check]')!;
      checkBtn.addEventListener('click', () => grade(quiz));
      quiz.querySelector('[data-retry]')!.addEventListener('click', () => reset(quiz));

      // Enable "Rätta svar" only when all questions have at least one answer
      quiz.addEventListener('change', () => {
        checkBtn.disabled = !allAnswered(quiz);
      });
    });
  }

  document.addEventListener('astro:page-load', wire);
</script>
