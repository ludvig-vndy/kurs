---
interface Props {
  del: string;
  modulTitel: string;
  lektion: string;
}
const { del, modulTitel, lektion } = Astro.props;
---

<nav class="crumbs" aria-label="Brödsmulor">
  <span>{del}</span>
  <span class="sep" aria-hidden="true">›</span>
  <span>{modulTitel}</span>
  <span class="sep" aria-hidden="true">›</span>
  <span class="crumbs__current">Lektion {lektion}</span>
</nav>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--text-faint);
    letter-spacing: 0.01em;
    margin-bottom: var(--space-4);
  }
  .crumbs__current {
    color: var(--text-muted);
  }
  .sep {
    color: var(--border-strong);
  }
</style>
