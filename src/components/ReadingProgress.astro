---
// Tunn läsprogress-bar, fylls medan man scrollar genom lektionstexten.
// Når 100% vid textens slut, inte vid sidans botten.
---

<div class="reading-progress" role="presentation">
  <div class="reading-progress__bar" data-reading-bar></div>
</div>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: transparent;
    z-index: 60;
    pointer-events: none;
  }
  .reading-progress__bar {
    height: 100%;
    width: 0%;
    background: var(--accent);
    transform-origin: left;
    transition: width 90ms linear;
  }
  @media (prefers-reduced-motion: reduce) {
    .reading-progress__bar {
      transition: none;
    }
  }
</style>

<script>
  function setupReadingProgress() {
    const bar = document.querySelector<HTMLElement>('[data-reading-bar]');
    const target = document.querySelector<HTMLElement>('[data-reading-target]');
    if (!bar || !target) return;

    let ticking = false;

    function update() {
      ticking = false;
      const start = target!.offsetTop;
      const span = target!.offsetHeight - window.innerHeight;
      let pct: number;
      if (span <= 0) {
        pct = window.scrollY >= start ? 100 : 0;
      } else {
        pct = ((window.scrollY - start) / span) * 100;
      }
      bar!.style.width = Math.min(100, Math.max(0, pct)) + '%';
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }

  document.addEventListener('astro:page-load', setupReadingProgress);
</script>
