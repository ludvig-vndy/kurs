---
// Flode, broadsheet income-statement chain. Nodes with operator connectors.
// minus -> U+2212 MINUS SIGN (intentionally kept), plus -> +, likamed -> =.
interface FlodeNode { etikett: string; operator?: 'minus' | 'plus' | 'likamed'; accent?: boolean }
interface FlodeVisual { typ: 'flode'; noder: FlodeNode[]; figurtext: string }
interface Props { visual: FlodeVisual }
const { visual } = Astro.props;
const { noder, figurtext } = visual;
const opSymbol = (op?: string) => (op === 'minus' ? '−' : op === 'plus' ? '+' : op === 'likamed' ? '=' : '→');
---
<figure class="flode-wrap">
  <div class="flow">
    {noder.map((nod, i) => (
      <Fragment>
        {i > 0 && <div class="op">{opSymbol(nod.operator)}</div>}
        <div class:list={['node', { acc: nod.accent }]} style={`--d:${i * 90}ms`}>{nod.etikett}</div>
      </Fragment>
    ))}
  </div>
  {figurtext && <figcaption class="figtext">{figurtext}</figcaption>}
</figure>
<style>
  .flode-wrap { margin: 0; }
  .flow .node { opacity: 0; transform: translateY(8px); }
  :global(.step.is-active) .flow .node { animation: node-in .42s cubic-bezier(.2,.7,.2,1) var(--d) both; }
  @keyframes node-in { to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .flow .node { opacity: 1; transform: none; }
    :global(.step.is-active) .flow .node { animation: none; }
  }
</style>
