---
// Rutnat, broadsheet ownership grid. One cell (index `markerad`) marked in oxblood,
// label below. Cells pop in on .step.is-active.
interface RutnatVisual { typ: 'rutnat'; kolumner: number; celler: number; markerad: number; etikett: string; figurtext: string }
interface Props { visual: RutnatVisual }
const { visual } = Astro.props;
const { kolumner, celler, markerad, etikett, figurtext } = visual;
const cells = Array.from({ length: celler }, (_, i) => i);
---
<figure class="rutnat" aria-label={`Rutnät: cell ${markerad + 1} av ${celler} markerad som ${etikett}`}>
  <div class="grid" style={`grid-template-columns:repeat(${kolumner},16px)`}>
    {cells.map((i) => (
      <span class:list={['cell', { on: i === markerad }]} style={`--d:${i * 14}ms`} aria-hidden="true"></span>
    ))}
  </div>
  <div class="etikett">{etikett}</div>
  {figurtext && <figcaption class="figtext">{figurtext}</figcaption>}
</figure>
<style>
  .rutnat { margin: 0; }
  .rutnat .cell { opacity: 0; transform: scale(.5); }
  :global(.step.is-active) .rutnat .cell { animation: cell-pop .3s cubic-bezier(.2,.7,.18,1) var(--d) both; }
  @keyframes cell-pop { to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .rutnat .cell { opacity: 1; transform: none; }
    :global(.step.is-active) .rutnat .cell { animation: none; }
  }
</style>
