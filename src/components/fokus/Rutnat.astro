---
// Rutnat, broadsheet grid. Cells marked in oxblood, label below.
// `lage` says what `markerad` means: 'antal' (a count, e.g. 11 of 100 funds)
// or 'position' (one cell, e.g. the share that is you). See rutnat.mjs.
// Cells pop in on .step.is-active.
import { markerade, rutnatEtikett } from './rutnat.mjs';

interface RutnatVisual {
  typ: 'rutnat'; kolumner: number; celler: number; markerad: number;
  lage: 'antal' | 'position'; etikett: string; figurtext: string;
}
interface Props { visual: RutnatVisual }
const { visual } = Astro.props;
const { kolumner, celler, etikett, figurtext } = visual;
const pa = markerade(visual);
const cells = Array.from({ length: celler }, (_, i) => i);
---
<figure class="rutnat" aria-label={rutnatEtikett(visual)}>
  <div class="grid" style={`grid-template-columns:repeat(${kolumner},16px)`}>
    {cells.map((i) => (
      <span class:list={['cell', { on: pa.has(i) }]} style={`--d:${i * 14}ms`} aria-hidden="true"></span>
    ))}
  </div>
  <div class="etikett">{etikett}</div>
  {figurtext && <figcaption class="figtext">{figurtext}</figcaption>}
</figure>
<style>
  .rutnat { margin: 0; }
  .rutnat .cell { opacity: 0; transform: scale(.5); }
  :global(.step.is-active) .rutnat .cell { animation: cell-pop .3s cubic-bezier(.2,.7,.18,1) var(--d) both; }
  @keyframes cell-pop { to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .rutnat .cell { opacity: 1; transform: none; }
    :global(.step.is-active) .rutnat .cell { animation: none; }
  }
</style>
