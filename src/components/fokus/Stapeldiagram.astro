---
// Stapeldiagram, broadsheet horizontal bars. Fills grow on .step.is-active.
interface StapelData { kategori: string; varde: number; accent?: boolean }
interface StapeldiagramVisual { typ: 'stapeldiagram'; data: StapelData[]; figurtext: string }
interface Props { visual: StapeldiagramVisual }
const { visual } = Astro.props;
const max = Math.max(...visual.data.map((d) => Math.abs(d.varde))) || 1;
const rows = visual.data.map((d) => ({ ...d, pct: Math.round((Math.abs(d.varde) / max) * 100) }));
---
<figure class="bars">
  {rows.map((d, i) => (
    <div class:list={['bar', { acc: d.accent }]}>
      <span class="lab">{d.kategori}</span>
      <span class="tk"><i style={`--w:${d.pct}%; --d:${i * 90}ms`}></i></span>
      <span class="val">{d.varde}</span>
    </div>
  ))}
  {visual.figurtext && <figcaption class="figtext">{visual.figurtext}</figcaption>}
</figure>
<style>
  .bars { margin-top: 0; }
  .bars .tk i { width: 0; }
  :global(.step.is-active) .bars .tk i { animation: bar-grow .8s cubic-bezier(.2,.7,.2,1) var(--d) forwards; }
  @keyframes bar-grow { to { width: var(--w); } }
  @media (prefers-reduced-motion: reduce) {
    .bars .tk i { width: var(--w); }
    :global(.step.is-active) .bars .tk i { animation: none; }
  }
</style>
