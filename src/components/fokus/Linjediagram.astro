---
// Linjediagram, broadsheet living line chart. Solid value line draws in with a
// travelling gold gleam; dashed price line flows; optional markor dot pops.
// Animations gate on the parent step gaining .is-active.
interface Serie { namn: string; stil?: string; accent?: boolean; punkter: number[] }
interface Markor { serieIndex: number; punktIndex: number; etikett: string }
interface LinjediagramVisual { typ: 'linjediagram'; serier: Serie[]; markor?: Markor; figurtext: string }
interface Props { visual: LinjediagramVisual }
const { visual } = Astro.props;
const serier = visual.serier;

const W = 560, H = 220, P = 22;
const all = serier.flatMap((s) => s.punkter);
const min = Math.min(...all);
const max = Math.max(...all);
const span = max - min || 1;
const n = Math.max(...serier.map((s) => s.punkter.length));
const X = (i: number) => P + (i * (W - 2 * P)) / (n - 1 || 1);
const Y = (v: number) => H - P - ((v - min) / span) * (H - 2 * P);
const pathOf = (pts: number[]) =>
  pts.map((v, i) => `${i ? 'L' : 'M'}${X(i).toFixed(1)},${Y(v).toFixed(1)}`).join(' ');

const series = serier.map((s) => ({
  namn: s.namn,
  solid: s.accent === true || s.stil === 'heldragen',
  d: pathOf(s.punkter),
}));

const m = visual.markor;
const mk = m
  ? { x: X(m.punktIndex), y: Y(serier[m.serieIndex].punkter[m.punktIndex]), etikett: m.etikett }
  : null;
---
<figure class="fig lj">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Linjediagram" preserveAspectRatio="none">
    {mk && <line class="lj-h" x1={mk.x} y1={P} x2={mk.x} y2={H - P} />}
    {series.map((s) =>
      s.solid ? (
        <g>
          <path class="lj-v" d={s.d} />
          <path class="lj-glow" d={s.d} />
        </g>
      ) : (
        <path class="lj-p" d={s.d} />
      )
    )}
    {mk && <circle class="lj-dot" cx={mk.x} cy={mk.y} r="4.5" />}
    {mk && <text class="lj-dottext" x={mk.x} y={mk.y - 12} text-anchor="middle">{mk.etikett}</text>}
  </svg>
  <div class="legend">
    {series.map((s) => (
      <span>
        <i style={s.solid ? 'background:var(--ink)' : 'height:0;border-top:2px dashed var(--oxblood)'}></i>
        {s.namn}
      </span>
    ))}
  </div>
  {visual.figurtext && <figcaption class="figtext">{visual.figurtext}</figcaption>}
</figure>
<style>
  .lj { margin: 0; }
  .lj svg { aspect-ratio: 560 / 220; }
  .lj-v { fill: none; stroke: var(--ink); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; pathLength: 1; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .lj-glow { fill: none; stroke: var(--gold); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; pathLength: 1; stroke-dasharray: .08 .92; stroke-dashoffset: 1; opacity: 0; filter: drop-shadow(0 0 4px rgba(154,110,28,.7)); }
  .lj-p { fill: none; stroke: var(--oxblood); stroke-width: 1.8; stroke-linejoin: round; stroke-dasharray: 5 6; opacity: 0; }
  .lj-h { stroke: var(--oxblood); stroke-width: 1; stroke-dasharray: 2 3; opacity: 0; }
  .lj-dot { fill: var(--oxblood); opacity: 0; }
  .lj-dottext { fill: var(--oxblood); font-family: var(--mono); font-size: 11px; opacity: 0; }

  /* Calm pass: line draws once and rests; gold gleam traces a single time;
     dashed price line is static (no perpetual flow). */
  :global(.step.is-active) .lj-v { animation: lj-draw 1.3s cubic-bezier(.4,0,.2,1) .15s forwards; }
  :global(.step.is-active) .lj-glow { animation: lj-trail 3.4s linear 1.7s 1 both; }
  :global(.step.is-active) .lj-p { opacity: 1; }
  :global(.step.is-active) .lj-h { animation: lj-fade .6s 1s forwards; }
  :global(.step.is-active) .lj-dot { animation: lj-pop .5s cubic-bezier(.2,.85,.3,1.3) 1.2s both; }
  :global(.step.is-active) .lj-dottext { animation: lj-fade .5s 1.4s both; }

  @keyframes lj-draw { to { stroke-dashoffset: 0; } }
  @keyframes lj-trail { 0% { opacity: 0; stroke-dashoffset: 1; } 12% { opacity: .85; } 88% { opacity: .85; } 100% { opacity: 0; stroke-dashoffset: 0; } }
  @keyframes lj-pop { 0% { opacity: 0; transform: scale(.2); } to { opacity: 1; transform: scale(1); } }
  @keyframes lj-fade { to { opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    .lj-v { stroke-dashoffset: 0 !important; }
    .lj-p, .lj-dot, .lj-dottext, .lj-h { opacity: 1 !important; }
    .lj-glow { opacity: 0 !important; }
    :global(.step.is-active) .lj-v,
    :global(.step.is-active) .lj-glow,
    :global(.step.is-active) .lj-p,
    :global(.step.is-active) .lj-dot,
    :global(.step.is-active) .lj-dottext,
    :global(.step.is-active) .lj-h { animation: none !important; }
  }
</style>
