---
// Andel, broadsheet 100% stacked proportion bar. Segments expand on .step.is-active.
interface AndelDel { etikett: string; varde: number; accent?: boolean }
interface AndelVisual { typ: 'andel'; delar: AndelDel[]; figurtext: string }
interface Props { visual: AndelVisual }
const { visual } = Astro.props;
const { delar, figurtext } = visual;
const total = delar.reduce((s, d) => s + d.varde, 0) || 1;
const palette = ['var(--ink)', 'var(--oxblood)', 'var(--gold)', 'var(--faint)'];
const segs = delar.map((d, i) => ({
  ...d,
  pct: (d.varde / total) * 100,
  color: d.accent ? 'var(--oxblood)' : palette[i % palette.length],
}));
const r = (p: number) => Math.round(p) + '%';
---
<figure class="andel">
  <div class="barwrap">
    {segs.map((s, i) => (
      <div class="seg2" style={`--w:${s.pct.toFixed(2)}%; --d:${i * 120}ms; background:${s.color}`}>{r(s.pct)}</div>
    ))}
  </div>
  <div class="keys">
    {segs.map((s) => (
      <span><i style={`background:${s.color}`}></i>{s.etikett}</span>
    ))}
  </div>
  {figurtext && <figcaption class="figtext">{figurtext}</figcaption>}
</figure>
<style>
  .andel { margin: 0; }
  .andel .barwrap .seg2 { width: 0; }
  :global(.step.is-active) .andel .barwrap .seg2 { animation: seg-grow .7s cubic-bezier(.2,.7,.2,1) var(--d) forwards; }
  @keyframes seg-grow { to { width: var(--w); } }
  @media (prefers-reduced-motion: reduce) {
    .andel .barwrap .seg2 { width: var(--w); }
    :global(.step.is-active) .andel .barwrap .seg2 { animation: none; }
  }
</style>
