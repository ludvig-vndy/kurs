---
interface Fraga {
  typ: 'single' | 'multi';
  fraga: string;
  underrubrik?: string;
  alternativ: string[];
  ratt: number[];
  forklaring: string;
}

interface Props {
  fragor: Fraga[];
  lektionId?: string;
  /** Stable id for this quiz instance, used to build per-question SRS ids. */
  quizId?: string;
}

const { fragor, lektionId = '', quizId } = Astro.props;
const qbase = quizId || lektionId || 'q';
const PASS_MARK = 80;
---

<div class="fq" data-fokus-quiz data-lektion={lektionId} data-pass={PASS_MARK}>
  <header class="fq__head">
    <div class="fq__kicker">KUNSKAPSKOLL</div>
    <h2 class="fq__title">Testa dig själv</h2>
    <p class="fq__lede">
      {fragor.length} {fragor.length === 1 ? 'fråga' : 'frågor'}. Sikta på minst {PASS_MARK}% rätt.
    </p>
  </header>

  <ol class="fq__list">
    {fragor.map((q, qi) => (
      <li
        class="fq-q"
        data-fq-q
        data-qid={`${qbase}#${qi}`}
        data-ratt={JSON.stringify(q.ratt)}
        data-multi={String(q.typ === 'multi')}
      >
        <fieldset class="fq-q__fieldset">
          <legend class="fq-q__legend">
            <span class="fq-q__num" aria-hidden="true">{qi + 1}</span>
            <span class="fq-q__text">{q.fraga}</span>
          </legend>
          {q.underrubrik && (
            <p class="fq-q__sub">{q.underrubrik}</p>
          )}
          <div
            class="fq-opts"
            role={q.typ === 'multi' ? 'group' : 'radiogroup'}
            aria-label={q.fraga}
          >
            {q.alternativ.map((alt, oi) => (
              <label class="fq-opt" data-fq-opt data-i={oi}>
                <input
                  class="fq-opt__input"
                  type={q.typ === 'multi' ? 'checkbox' : 'radio'}
                  name={`fq-${lektionId || 'q'}-${qi}`}
                  value={oi}
                />
                <span class="fq-opt__marker" aria-hidden="true" />
                <span class="fq-opt__text">{alt}</span>
                <span class="fq-opt__icon" aria-hidden="true">
                  <svg class="fq-icon-ok" viewBox="0 0 24 24" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7" /></svg>
                  <svg class="fq-icon-no" viewBox="0 0 24 24" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
                </span>
              </label>
            ))}
          </div>
          <div class="fq-q__feedback" data-fq-feedback hidden aria-live="polite">
            <span class="fq-q__verdict" data-fq-verdict></span>
            <span class="fq-q__why">{q.forklaring}</span>
          </div>
        </fieldset>
      </li>
    ))}
  </ol>

  <div class="fq__actions">
    <button type="button" class="fq-btn fq-btn--primary" data-fq-check disabled>Rätta svar</button>
    <button type="button" class="fq-btn fq-btn--ghost" data-fq-redo hidden>Öva om de du missade</button>
    <button type="button" class="fq-btn fq-btn--ghost" data-fq-retry hidden>Gör om</button>
  </div>

  <div class="fq__result" data-fq-result hidden role="status" aria-live="polite">
    <div class="fq-result__ring" data-fq-ring>
      <span class="fq-result__pct" data-fq-pct>0%</span>
    </div>
    <div class="fq-result__body">
      <strong class="fq-result__head" data-fq-head></strong>
      <span class="fq-result__sub" data-fq-sub></span>
    </div>
  </div>
</div>

<style>
  /* ── Container ──────────────────────────────────────────────────────── */
  .fq { width: 100%; font-family: var(--mono); }

  /* ── Header ─────────────────────────────────────────────────────────── */
  .fq__head { margin-bottom: 30px; text-align: center; }
  .fq__kicker { font-family: var(--mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--oxblood); margin-bottom: 18px; }
  .fq__title { font-family: var(--display); font-weight: 400; font-size: clamp(28px, 3.4vw, 38px); line-height: 1.1; color: var(--ink); margin: 0 0 10px; }
  .fq__lede { font-family: var(--mono); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin: 0; }

  /* ── Question list ──────────────────────────────────────────────────── */
  .fq__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 32px; text-align: left; }
  .fq-q__fieldset { border: none; margin: 0; padding: 0; }
  .fq-q__legend { display: flex; gap: 10px; align-items: baseline; margin-bottom: 12px; padding: 0; width: 100%; }
  .fq-q__num { font-family: var(--mono); font-size: 12px; font-weight: 500; color: var(--oxblood); flex-shrink: 0; font-variant-numeric: tabular-nums; }
  .fq-q__text { font-family: var(--display); font-weight: 400; font-size: 21px; line-height: 1.32; color: var(--ink); }
  .fq-q__sub { font-family: var(--mono); font-size: 10.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: -4px 0 14px 24px; padding: 0; }

  /* ── Options ────────────────────────────────────────────────────────── */
  .fq-opts { display: flex; flex-direction: column; gap: 8px; }
  .fq-opt { display: grid; grid-template-columns: 20px 1fr auto; align-items: center; gap: 13px; padding: 13px 16px; border: 1px solid var(--rule); background: var(--card); cursor: pointer; transition: border-color .18s, background .18s; }
  .fq-opt:hover { border-color: var(--rule-strong); }
  .fq-opt__input { position: absolute; opacity: 0; width: 0; height: 0; pointer-events: none; }
  .fq-opt__marker { width: 20px; height: 20px; flex-shrink: 0; border: 1.4px solid var(--faint); border-radius: 50%; transition: border-color .18s, box-shadow .18s; }
  [data-multi='true'] .fq-opt__marker { border-radius: 4px; }
  .fq-opt:has(.fq-opt__input:checked) { border-color: var(--oxblood); background: #F0E4DE; }
  .fq-opt:has(.fq-opt__input:checked) .fq-opt__marker { border-color: var(--oxblood); box-shadow: inset 0 0 0 5px var(--oxblood); }
  [data-multi='true'] .fq-opt:has(.fq-opt__input:checked) .fq-opt__marker { box-shadow: inset 0 0 0 9px var(--oxblood); }
  .fq-opt:has(.fq-opt__input:focus-visible) { outline: 2px solid var(--oxblood); outline-offset: 2px; }
  .fq-opt__text { font-family: var(--serif); font-size: 16px; line-height: 1.4; color: var(--ink); }

  .fq-opt__icon { width: 20px; height: 20px; flex-shrink: 0; display: none; }
  .fq-opt__icon svg { width: 20px; height: 20px; display: none; }
  .fq-icon-ok { stroke: var(--good); }
  .fq-icon-no { stroke: var(--oxblood); }

  /* ── Post-grading states ────────────────────────────────────────────── */
  .fq.is-graded .fq-opt { cursor: default; pointer-events: none; }
  /* Scoped to .is-graded so the verdict colours out-specify the "selected"
     (:has(:checked)) background, otherwise a picked-correct option stays pink. */
  .fq.is-graded .fq-opt.is-correct { border-color: var(--good); background: var(--good-soft); }
  .fq-opt.is-correct .fq-opt__icon { display: block; }
  .fq-opt.is-correct .fq-icon-ok { display: block; }
  .fq.is-graded .fq-opt.is-wrong { border-color: var(--oxblood); background: var(--bad-soft); }
  .fq-opt.is-wrong .fq-opt__icon { display: block; }
  .fq-opt.is-wrong .fq-icon-no { display: block; }
  /* A picked-correct marker should read green, not the neutral oxblood fill. */
  .fq.is-graded .fq-opt.is-correct:has(.fq-opt__input:checked) .fq-opt__marker { border-color: var(--good); box-shadow: inset 0 0 0 5px var(--good); }
  .fq.is-graded [data-multi='true'] .fq-opt.is-correct:has(.fq-opt__input:checked) .fq-opt__marker { box-shadow: inset 0 0 0 9px var(--good); }
  .fq-opt.is-wrong { animation: fq-shake 250ms ease; }
  @keyframes fq-shake { 0%,100% { transform: translateX(0); } 25% { transform: translateX(-3px); } 75% { transform: translateX(3px); } }
  @media (prefers-reduced-motion: reduce) { .fq-opt.is-wrong { animation: none; } }

  /* ── Per-question feedback ──────────────────────────────────────────── */
  .fq-q__feedback { margin-top: 12px; padding: 4px 0 4px 16px; border-left: 2px solid var(--oxblood); font-size: 15px; line-height: 1.5; display: flex; flex-direction: column; gap: 4px; }
  .fq-q__verdict { font-family: var(--mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; font-weight: 500; }
  .fq-q__verdict[data-ok='true'] { color: var(--good); }
  .fq-q__verdict[data-ok='false'] { color: var(--oxblood); }
  .fq-q__why { color: var(--ink-soft); font-family: var(--serif); }

  /* ── Action row ─────────────────────────────────────────────────────── */
  .fq__actions { display: flex; align-items: center; gap: 12px; margin-top: 30px; flex-wrap: wrap; }
  .fq-btn { font-family: var(--mono); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; cursor: pointer; border: 1px solid transparent; transition: background .2s, opacity .2s, border-color .2s; }
  .fq-btn--primary { background: var(--ink); color: var(--paper); padding: 14px 30px; border-radius: 99px; }
  .fq-btn--primary:hover:not(:disabled) { background: var(--oxblood); }
  .fq-btn--primary:disabled { opacity: .35; cursor: not-allowed; }
  .fq-btn--ghost { background: none; border-color: var(--rule-strong); color: var(--ink-soft); padding: 12px 22px; border-radius: 99px; }
  .fq-btn--ghost:hover { border-color: var(--oxblood); color: var(--oxblood); }

  /* ── Result panel ───────────────────────────────────────────────────── */
  .fq__result { display: flex; align-items: center; gap: 22px; margin-top: 26px; padding: 22px; border: 1px solid var(--rule-strong); background: var(--card); }
  .fq-result__ring { --pct: 0; position: relative; width: 76px; height: 76px; border-radius: 50%; flex-shrink: 0; display: grid; place-items: center; background: conic-gradient(var(--ring-color, var(--oxblood)) calc(var(--pct) * 1%), var(--paper-2) 0); transition: --pct .9s cubic-bezier(.2,.7,.2,1); }
  .fq-result__ring::after { content: ''; position: absolute; inset: 8px; border-radius: 50%; background: var(--card); }
  .fq-result__pct { position: relative; z-index: 1; font-family: var(--mono); font-weight: 500; font-variant-numeric: tabular-nums; font-size: 18px; color: var(--ink); }
  .fq-result__body { display: flex; flex-direction: column; gap: 4px; }
  .fq-result__head { font-family: var(--display); font-size: 22px; font-weight: 400; color: var(--ink); }
  .fq-result__sub { font-family: var(--mono); font-size: 11px; letter-spacing: .04em; color: var(--muted); }

  @property --pct { syntax: '<number>'; inherits: false; initial-value: 0; }

  .fq-q__feedback[hidden], .fq__result[hidden] { display: none; }
</style>

<script>
  import { recordResult } from '../../scripts/srs';

  function gradeQuiz(fq: HTMLElement): void {
    const questions = Array.from(fq.querySelectorAll<HTMLElement>('[data-fq-q]'));
    let correctCount = 0;

    questions.forEach((q) => {
      const ratt: number[] = JSON.parse(q.dataset.ratt || '[]');
      const inputs = Array.from(q.querySelectorAll<HTMLInputElement>('.fq-opt__input'));
      const picked = inputs.filter((i) => i.checked).map((i) => Number(i.value));

      const rattSet = new Set(ratt);
      const pickedSet = new Set(picked);
      const isRight =
        picked.length === ratt.length &&
        [...rattSet].every((r) => pickedSet.has(r));

      if (isRight) correctCount++;

      const qid = q.dataset.qid;
      if (qid) recordResult(qid, isRight);
      q.dataset.wasWrong = isRight ? '' : '1';

      inputs.forEach((input) => {
        const opt = input.closest<HTMLElement>('.fq-opt');
        if (!opt) return;
        const idx = Number(input.value);
        const shouldBeCorrect = rattSet.has(idx);
        const wasPicked = pickedSet.has(idx);
        opt.classList.toggle('is-correct', shouldBeCorrect);
        opt.classList.toggle('is-wrong', wasPicked && !shouldBeCorrect);
        if (wasPicked) opt.classList.add('is-picked');
      });

      const fb = q.querySelector<HTMLElement>('[data-fq-feedback]');
      const verdict = q.querySelector<HTMLElement>('[data-fq-verdict]');
      if (fb && verdict) {
        verdict.textContent = isRight ? 'Rätt' : picked.length ? 'Inte riktigt' : 'Obesvarad';
        verdict.dataset.ok = String(isRight);
        fb.hidden = false;
      }
    });

    const total = questions.length;
    const pct = total > 0 ? Math.round((correctCount / total) * 100) : 0;
    const passMark = Number(fq.dataset.pass || '80');
    const passed = pct >= passMark;

    fq.classList.add('is-graded');
    fq.dataset.graded = '1';
    fq.dataset.passed = String(passed);
    fq.dataset.pct = String(pct);

    const resultEl = fq.querySelector<HTMLElement>('[data-fq-result]');
    const ringEl = fq.querySelector<HTMLElement>('[data-fq-ring]');
    const pctEl = fq.querySelector<HTMLElement>('[data-fq-pct]');
    const headEl = fq.querySelector<HTMLElement>('[data-fq-head]');
    const subEl = fq.querySelector<HTMLElement>('[data-fq-sub]');

    if (ringEl) {
      ringEl.style.setProperty('--pct', String(pct));
      ringEl.style.setProperty('--ring-color', passed ? 'var(--good)' : 'var(--oxblood)');
    }
    if (pctEl) pctEl.textContent = pct + '%';
    if (headEl) headEl.textContent = passed ? 'Godkänt!' : 'Nästan där';
    if (subEl) {
      subEl.textContent = `${correctCount} av ${total} rätt${passed ? '' : `, ${passMark}% är målet`}`;
    }
    if (resultEl) resultEl.hidden = false;

    const checkBtn = fq.querySelector<HTMLButtonElement>('[data-fq-check]');
    const retryBtn = fq.querySelector<HTMLButtonElement>('[data-fq-retry]');
    const redoBtn = fq.querySelector<HTMLButtonElement>('[data-fq-redo]');
    if (checkBtn) checkBtn.hidden = true;
    if (retryBtn) retryBtn.hidden = false;
    const anyWrong = questions.some((q) => q.dataset.wasWrong === '1');
    if (redoBtn) redoBtn.hidden = !anyWrong;

    const lektionId = fq.dataset.lektion;
    if (lektionId) {
      try {
        const key = `kurs:fokus:${lektionId}`;
        const prev = Number(localStorage.getItem(key) || '0');
        if (pct > prev) localStorage.setItem(key, String(pct));
      } catch (_) {
        /* localStorage may be unavailable */
      }
    }

    resultEl?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function resetQuiz(fq: HTMLElement): void {
    fq.classList.remove('is-graded');
    fq.dataset.graded = ''; fq.dataset.passed = '';
    fq.querySelectorAll<HTMLElement>('[data-fq-q]').forEach((q) => { q.hidden = false; q.dataset.wasWrong = ''; });
    fq.querySelectorAll<HTMLInputElement>('.fq-opt__input').forEach((i) => { i.checked = false; });
    fq.querySelectorAll<HTMLElement>('.fq-opt').forEach((o) => {
      o.classList.remove('is-correct', 'is-wrong', 'is-picked');
    });
    fq.querySelectorAll<HTMLElement>('[data-fq-feedback]').forEach((f) => { f.hidden = true; });

    const resultEl = fq.querySelector<HTMLElement>('[data-fq-result]');
    const checkBtn = fq.querySelector<HTMLButtonElement>('[data-fq-check]');
    const retryBtn = fq.querySelector<HTMLButtonElement>('[data-fq-retry]');
    const redoBtn = fq.querySelector<HTMLButtonElement>('[data-fq-redo]');

    if (resultEl) resultEl.hidden = true;
    if (checkBtn) { checkBtn.hidden = false; checkBtn.disabled = true; }
    if (retryBtn) retryBtn.hidden = true;
    if (redoBtn) redoBtn.hidden = true;

    fq.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // Re-practise only the missed questions: keep correct ones (and their answers)
  // hidden but still counted, clear and re-show the wrong ones for another try.
  function redoWrong(fq: HTMLElement): void {
    const questions = Array.from(fq.querySelectorAll<HTMLElement>('[data-fq-q]'));
    questions.forEach((q) => {
      const wrong = q.dataset.wasWrong === '1';
      q.hidden = !wrong;
      if (wrong) {
        q.querySelectorAll<HTMLInputElement>('.fq-opt__input').forEach((i) => { i.checked = false; });
        q.querySelectorAll<HTMLElement>('.fq-opt').forEach((o) => o.classList.remove('is-correct', 'is-wrong', 'is-picked'));
        const fb = q.querySelector<HTMLElement>('[data-fq-feedback]'); if (fb) fb.hidden = true;
      }
    });
    fq.classList.remove('is-graded');
    fq.dataset.graded = ''; fq.dataset.passed = '';
    const resultEl = fq.querySelector<HTMLElement>('[data-fq-result]');
    const checkBtn = fq.querySelector<HTMLButtonElement>('[data-fq-check]');
    const retryBtn = fq.querySelector<HTMLButtonElement>('[data-fq-retry]');
    const redoBtn = fq.querySelector<HTMLButtonElement>('[data-fq-redo]');
    if (resultEl) resultEl.hidden = true;
    if (checkBtn) { checkBtn.hidden = false; checkBtn.disabled = !allAnswered(fq); }
    if (retryBtn) retryBtn.hidden = true;
    if (redoBtn) redoBtn.hidden = true;
    fq.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function allAnswered(fq: HTMLElement): boolean {
    const questions = Array.from(fq.querySelectorAll<HTMLElement>('[data-fq-q]'));
    return questions.every((q) => {
      const inputs = Array.from(q.querySelectorAll<HTMLInputElement>('.fq-opt__input'));
      return inputs.some((i) => i.checked);
    });
  }

  function wireQuiz(fq: HTMLElement): void {
    if (fq.dataset.wired) return;
    fq.dataset.wired = '1';

    const checkBtn = fq.querySelector<HTMLButtonElement>('[data-fq-check]');
    const retryBtn = fq.querySelector<HTMLButtonElement>('[data-fq-retry]');
    const redoBtn = fq.querySelector<HTMLButtonElement>('[data-fq-redo]');

    checkBtn?.addEventListener('click', () => gradeQuiz(fq));
    retryBtn?.addEventListener('click', () => resetQuiz(fq));
    redoBtn?.addEventListener('click', () => redoWrong(fq));

    fq.addEventListener('change', () => {
      if (checkBtn) checkBtn.disabled = !allAnswered(fq);
    });
  }

  function initAll(): void {
    document.querySelectorAll<HTMLElement>('[data-fokus-quiz]').forEach(wireQuiz);
  }

  document.addEventListener('astro:page-load', initAll);
</script>
