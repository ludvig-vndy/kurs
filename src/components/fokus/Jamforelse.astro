---
// Jamforelse, broadsheet comparison: hairline-ruled columns.
interface JamforelseElement { rubrik: string; text: string }
interface JamforelseVisual { typ: 'jamforelse'; element: JamforelseElement[]; figurtext: string }
interface Props { visual: JamforelseVisual }
const { visual } = Astro.props;
const { element, figurtext } = visual;
---
<figure class="jmf-wrap">
  <div class="jmf">
    {element.map((el) => (
      <div class="col">
        <div class="r">{el.rubrik}</div>
        <div class="x">{el.text}</div>
      </div>
    ))}
  </div>
  {figurtext && <figcaption class="figtext">{figurtext}</figcaption>}
</figure>
<style>
  .jmf-wrap { margin: 0; }
</style>
