---
// Wordmarken. Tidigare en boxad sigill; nu ren utskriven "Marginalen" (ingen
// box, ingen undertitel). Behåller klassen .seal/.seal__name så befintliga
// selektorer (landningens grid-centrering, footer, dev-växeln) fortsätter gälla.
interface Props {
  size?: 'sm' | 'lg';
  href?: string;
  /** ordmärket. Default Marginalen, sätts om av en kurs med egen identitet. */
  namn?: string;
}
const { size = 'lg', href = '/hem', namn = 'Marginalen' } = Astro.props;
---
<a class:list={['seal', { 'seal--sm': size === 'sm' }]} href={href} aria-label={namn}>
  <span class="seal__name">{namn}</span>
</a>
