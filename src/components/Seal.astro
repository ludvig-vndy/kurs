---
// Wordmarken. Tidigare en boxad sigill; nu ren utskriven "Marginalen" (ingen
// box, ingen undertitel). Behåller klassen .seal/.seal__name så befintliga
// selektorer (landningens grid-centrering, footer, dev-växeln) fortsätter gälla.
interface Props {
  size?: 'sm' | 'lg';
  href?: string;
}
const { size = 'lg', href = '/hem' } = Astro.props;
---
<a class:list={['seal', { 'seal--sm': size === 'sm' }]} href={href} aria-label="Marginalen">
  <span class="seal__name">Marginalen</span>
</a>
