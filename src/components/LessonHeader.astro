---
interface Props {
  titel: string;
  niva: 'Nybörjare' | 'Mellan' | 'Avancerad';
  lektion: string;
  fardighet: string;
  minutes: number;
}
const { titel, niva, lektion, fardighet, minutes } = Astro.props;
---

<header class="lesson-header">
  <div class="lesson-header__meta" data-reveal>
    <span class:list={['badge', `badge--${niva.toLowerCase()}`]}>{niva}</span>
    <span class="dot" aria-hidden="true">·</span>
    <span class="readtime">{minutes} min läsning</span>
  </div>

  <h1 class="lesson-header__title" data-reveal data-reveal-delay="60">{titel}</h1>

  <div class="skill" data-reveal data-reveal-delay="120">
    <span class="skill__label">Det här kan du efter lektionen</span>
    <p class="skill__text">{fardighet}</p>
  </div>
</header>

<style>
  .lesson-header {
    margin-bottom: var(--space-7);
  }
  .lesson-header__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-4);
  }
  .dot {
    color: var(--border-strong);
  }

  .badge {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 0.2em 0.7em;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-strong);
    color: var(--text-muted);
  }
  .badge--nybörjare {
    color: var(--accent);
    border-color: var(--accent-line);
    background: var(--accent-soft);
  }
  .badge--mellan {
    color: #c98a2b;
    border-color: rgba(201, 138, 43, 0.4);
    background: rgba(201, 138, 43, 0.08);
  }
  .badge--avancerad {
    color: #b3603f;
    border-color: rgba(179, 96, 63, 0.4);
    background: rgba(179, 96, 63, 0.08);
  }

  .lesson-header__title {
    font-size: var(--text-3xl);
    line-height: 1.1;
    margin: 0 0 var(--space-5);
    max-width: 18ch;
  }

  .skill {
    position: relative;
    padding: var(--space-4) var(--space-5);
    padding-left: var(--space-6);
    background: var(--accent-soft);
    border: 1px solid var(--accent-line);
    border-radius: var(--radius-md);
  }
  .skill::before {
    content: '';
    position: absolute;
    left: 0;
    top: var(--space-3);
    bottom: var(--space-3);
    width: 3px;
    border-radius: var(--radius-full);
    background: var(--accent);
  }
  .skill__label {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    margin-bottom: var(--space-2);
  }
  .skill__text {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-md);
    line-height: 1.5;
    color: var(--text);
  }
</style>
