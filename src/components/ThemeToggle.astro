---
// Diskret ljus/mörk-toggle. Mörkt är default.
---

<button
  type="button"
  class="theme-toggle"
  aria-label="Växla mörkt/ljust läge"
  title="Växla tema"
>
  <svg class="icon icon-sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
  <svg class="icon icon-moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background: var(--bg-elev);
    color: var(--text-muted);
    cursor: pointer;
    transition:
      color var(--dur-micro) var(--ease-standard),
      border-color var(--dur-micro) var(--ease-standard),
      background var(--dur-micro) var(--ease-standard);
  }
  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent-line);
  }
  .icon {
    grid-area: 1 / 1;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      opacity var(--dur-micro) var(--ease-standard),
      transform var(--dur-comp) var(--ease-out);
  }
  /* Mörkt läge: visa sol (klicka för ljus). Ljust: visa måne. */
  :global([data-theme='dark']) .icon-moon,
  :global([data-theme='light']) .icon-sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }
  :global([data-theme='dark']) .icon-sun,
  :global([data-theme='light']) .icon-moon {
    opacity: 1;
    transform: rotate(0) scale(1);
  }
</style>

<script>
  import { toggleTheme } from '../scripts/theme';

  function wire() {
    document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((btn) => {
      if (btn.dataset.wired) return;
      btn.dataset.wired = '1';
      btn.addEventListener('click', () => toggleTheme());
    });
  }
  document.addEventListener('astro:page-load', wire);
</script>
